{
  "$schema": "https://turbo.build/schema.json",
  // Turbo gira solo in CI: modalità "loose" così tutte le env (SITE,
  // PUBLIC_WEB3FORMS_ACCESS_KEY, …) passano alle task senza doverle dichiarare
  // una per una. In strict mode verrebbero filtrate e il build produrrebbe URL
  // localhost + access_key vuota.
  "envMode": "loose",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "check": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "preview": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    }
  }
}
