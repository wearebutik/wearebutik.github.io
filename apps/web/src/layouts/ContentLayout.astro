---
import BaseLayout from './BaseLayout.astro';
import HeroBanner from '../components/HeroBanner.astro';
import MetaLabel from '@butik/ui/MetaLabel';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  subtitle?: string;
  heroImage: ImageMetadata | string;
  heroAlt?: string;
  /** Segnaposto sfocato della foto hero (LQIP), se c'è. */
  heroLqip?: string;
  metaTitle?: string;
  metaDescription?: string;
  ogImage?: string;
  transitionName?: string;
  // Extra info (used by projects)
  client?: string;
  year?: number;
  category?: string;
}

const {
  title,
  subtitle,
  heroImage,
  heroAlt,
  heroLqip,
  metaTitle,
  metaDescription,
  ogImage,
  transitionName,
  client,
  year,
  category,
} = Astro.props;
---

<BaseLayout
  title={metaTitle ?? `${title} — Butik`}
  description={metaDescription ?? subtitle}
  ogImage={ogImage}
>
  <HeroBanner title={title} subtitle={subtitle} image={heroImage} imageAlt={heroAlt} transitionName={transitionName} placeholder={heroLqip} />

  <!-- Metadata bar (only for projects) -->
  {(client || year || category) && (
    <div class="meta-bar">
      <div class="meta-bar-inner">
        {client && (
          <div>
            <MetaLabel as="p">Cliente</MetaLabel>
            <span class="meta-value">{client}</span>
          </div>
        )}
        {year && (
          <div>
            <MetaLabel as="p">Anno</MetaLabel>
            <span class="meta-value">{year}</span>
          </div>
        )}
        {category && (
          <div>
            <MetaLabel as="p">Categoria</MetaLabel>
            <span class="meta-value">{category}</span>
          </div>
        )}
      </div>
    </div>
  )}

  <!-- Content -->
  <article class="content-article">
    <div class="prose prose-full">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .meta-bar {
    /* Il filetto del sistema (come header, footer, bandi). */
    border-bottom: 1px solid color-mix(in srgb, var(--color-fg) 10%, transparent);
  }

  .meta-bar-inner {
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--space-6);
    padding-block: var(--space-5);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
  }

  /* Blocco sotto l'etichetta (MetaLabel): lo scarto lo dà il valore, perché
     l'isola non riceve gli stili scoped del layout (ADR-0008). */
  .meta-value {
    display: block;
    margin-top: var(--space-2);
    font-family: var(--font-sans);
    font-size: var(--font-size-sm);
    color: var(--color-fg);
  }

  .content-article {
    max-width: var(--measure-5xl);
    margin-inline: auto;
    padding-inline: var(--space-6);
    padding-block: var(--space-16);
  }
</style>
