---
import BaseLayout from './BaseLayout.astro';
import HeroBanner from '../components/HeroBanner.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  subtitle?: string;
  heroImage: ImageMetadata | string;
  heroAlt?: string;
  metaTitle?: string;
  metaDescription?: string;
  ogImage?: string;
  transitionName?: string;
  // Extra info (used by projects)
  client?: string;
  year?: number;
  category?: string;
}

const {
  title,
  subtitle,
  heroImage,
  heroAlt,
  metaTitle,
  metaDescription,
  ogImage,
  transitionName,
  client,
  year,
  category,
} = Astro.props;
---

<BaseLayout
  title={metaTitle ?? `${title} — Butik`}
  description={metaDescription ?? subtitle}
  ogImage={ogImage}
>
  <HeroBanner title={title} subtitle={subtitle} image={heroImage} imageAlt={heroAlt} transitionName={transitionName} />

  <!-- Metadata bar (only for projects) -->
  {(client || year || category) && (
    <div class="meta-bar">
      <div class="meta-bar-inner">
        {client && (
          <div>
            <span class="meta-label">Cliente</span>
            <span class="meta-value">{client}</span>
          </div>
        )}
        {year && (
          <div>
            <span class="meta-label">Anno</span>
            <span class="meta-value">{year}</span>
          </div>
        )}
        {category && (
          <div>
            <span class="meta-label">Categoria</span>
            <span class="meta-value">{category}</span>
          </div>
        )}
      </div>
    </div>
  )}

  <!-- Content -->
  <article class="content-article">
    <div class="prose prose-full">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .meta-bar {
    border-bottom: 1px solid oklch(96.7% 0.003 264.542); /* Tailwind gray-100 — nessun token corrispondente */
  }

  .meta-bar-inner {
    max-width: 80rem;
    margin-inline: auto;
    padding-inline: 1.5rem;
    padding-block: 1.25rem; /* py-5 — nessun token per 1.25rem */
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
  }

  .meta-label {
    display: block;
    margin-bottom: var(--space-1);
    font-family: var(--font-display);
    font-size: var(--font-size-xs);
    font-weight: 700;
    letter-spacing: 0.1em; /* tracking-widest — nessun token per letter-spacing */
    text-transform: uppercase;
    color: var(--color-accent-text);
  }

  .meta-value {
    font-family: var(--font-sans);
    font-size: var(--font-size-sm);
    color: var(--color-fg);
  }

  .content-article {
    max-width: 64rem;
    margin-inline: auto;
    padding-inline: 1.5rem;
    padding-block: var(--space-16);
  }
</style>
