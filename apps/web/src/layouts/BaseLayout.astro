---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '@butik/ui-tokens/tokens.css';
import '../styles/reset.css';
import '../styles/global.css';
import '../styles/prose.css';
import '../styles/motion.css';
// Stili del cookie banner (ADR-0006). L'inizializzazione avviene lato client
// nello <script> in fondo al layout.
import 'vanilla-cookieconsent/dist/cookieconsent.css';
import { getImage } from 'astro:assets';
import logo from '../assets/logos/bollo-rosso.svg';
import { getAllOgCards, ogPngPathForRoute, normalizeRoute } from '../data/ogCards';
import { BASE, VERSIONE_B, senzaBase } from '#lib/versione';

const optimizedOg = await getImage({ src: logo, width: 1200, format: 'png' });

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /** Pagine interne (lab): fuori dai motori di ricerca. */
  noindex?: boolean;
  /** Animazioni d'ingresso (styles/motion.css + @butik/ui/reveal); false per spegnerle. */
  reveal?: boolean;
}

const {
  title = 'Butik',
  description = 'La prima impresa sociale italiana specializzata in progettazione culturale e sviluppo territoriale attraverso la musica.',
  ogImage,
  noindex = false,
  reveal = true,
} = Astro.props;

const siteBase = Astro.site ?? Astro.url.origin;
// Nella versione B (/b/, ADR-0004) il canonical punta alla pagina corrispondente
// della A e la pagina resta fuori dai motori di ricerca; og:url resta quello
// della B, così un link condiviso per la revisione porta alla B.
const percorsoA = senzaBase(Astro.url.pathname);
const pageURL = new URL(Astro.url.pathname, siteBase);
const canonicalURL = new URL(percorsoA, siteBase);
const robotsNoindex = noindex || VERSIONE_B;

// og:image — precedenza: override esplicito della pagina > card generata per
// questa rotta > logo di fallback. Sempre come URL assoluto.
const route = normalizeRoute(percorsoA);
const ogCards = await getAllOgCards();
const ogCard = ogImage ? null : ogCards.get(route);
const hasCard = ogCard != null;
const ogImagePath = ogImage ?? (hasCard ? BASE + ogPngPathForRoute(route) : optimizedOg.src);
const ogImageURL = new URL(ogImagePath, siteBase).href;
// width/height/type valgono solo per le card generate (1200×630 PNG):
// per il logo di fallback la proporzione è diversa, meglio non dichiararli.
const ogImageAlt = ogCard ? `${ogCard.title} — Butik` : title;

// Google Tag Manager (ADR-0006, Update 2026-07-13): caricato via Google
// Consent Mode v2. Il container si legge da `PUBLIC_GTM_ID`; se manca, GTM non
// viene iniettato (no-op) e il sito builda comunque.
const gtmId = import.meta.env.PUBLIC_GTM_ID as string | undefined;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <meta name="generator" content={Astro.generator} />
    {robotsNoindex && <meta name="robots" content="noindex, nofollow" />}

    {/* Google Tag Manager + Consent Mode v2 (ADR-0006). Il default `denied`
        DEVE precedere il caricamento di gtm.js: entrambi in questo unico script
        inline, così l'ordine è garantito. Nessun tag scatta finché il consenso
        `analytics` non aggiorna `analytics_storage` a `granted` (vedi
        src/lib/consent/config.client.ts → applyAnalyticsConsent). */}
    {gtmId && (
      <script is:inline define:vars={{ gtmId }}>
        // `define:vars` incapsula lo script in una IIFE: `gtag` va assegnato a
        // `window` esplicitamente, altrimenti non è globale e `safeGtag`
        // (gtag.ts) non lo troverebbe → il consent 'update' non arriverebbe mai
        // a GTM. Lo snippet canonico di Google definisce `gtag` come globale.
        window.dataLayer = window.dataLayer || [];
        window.gtag = function gtag() { window.dataLayer.push(arguments); };
        gtag('consent', 'default', {
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
          analytics_storage: 'denied',
          wait_for_update: 500,
        });
        (function (w, d, s, l, i) {
          w[l] = w[l] || [];
          w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
          var f = d.getElementsByTagName(s)[0],
            j = d.createElement(s),
            dl = l != 'dataLayer' ? '&l=' + l : '';
          j.async = true;
          j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
          f.parentNode.insertBefore(j, f);
        })(window, document, 'script', 'dataLayer', gtmId);
      </script>
    )}

    <!-- Preload font per spezzare la catena CSS → font -->
    <link rel="preload" href="/fonts/league-spartan-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/clear-sans-latin-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/clear-sans-latin-700.woff2" as="font" type="font/woff2" crossorigin />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Butik" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:url" content={pageURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:alt" content={ogImageAlt} />
    {hasCard && (
      <>
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </>
    )}

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:image:alt" content={ogImageAlt} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageURL} />
    <ClientRouter />
  </head>
  <body class="page-body">
    {/* GTM fallback per client senza JS (ADR-0006). */}
    {gtmId && (
      <noscript
        set:html={`<iframe src="https://www.googletagmanager.com/ns.html?id=${gtmId}" height="0" width="0" style="display:none;visibility:hidden"></iframe>`}
      />
    )}
    {VERSIONE_B && (
      <p class="versione-b">
        <strong>Versione B</strong> — testi in revisione, non ancora pubblicati.
        {/* Unico link della B che porta alla A: marcato perché basePath non lo
            riscriva, e con ricarica completa fuori dal ClientRouter. */}
        <a href={percorsoA} data-versione-a data-astro-reload>Vedi la versione pubblicata</a>
      </p>
    )}
    <Header />
    <main class="page-main" data-reveal-off={reveal ? undefined : ''}>
      <slot />
    </main>
    <Footer />

    {/* Cookie consent (ADR-0006): nessun *cookie* prima del consenso — il
        livello cookieless di PostHog (pageview, web vitals) parte comunque,
        indipendentemente dalla risposta al banner. Rieseguito a ogni
        astro:page-load perché le view transition rimpiazzano il DOM;
        CookieConsent.run e initPostHogCookieless sono idempotenti. */}
    {/* Animazioni d'ingresso: arma gli elementi di <main> a ogni pagina
        (il ClientRouter rimpiazza <main>, quindi il nodo è sempre nuovo) e
        stacca l'osservatore prima dello swap. */}
    <script>
      import { initReveal } from '@butik/ui/reveal';

      // Header delle pagine (HeroBanner): se la sua foto arriva con il morph
      // della view transition (stesso nome sulla pagina che si lascia, es. la
      // card del portfolio), si marca data-morph e l'entrata al caricamento si
      // salta: il rimbalzo lo fa già la transizione.
      document.addEventListener('astro:before-swap', (e) => {
        const banner = e.newDocument.querySelector<HTMLElement>('[data-hero-banner]');
        const nome = banner?.querySelector<HTMLElement>('img')?.style.viewTransitionName;
        if (!banner || !nome) return;
        const presente = [...document.querySelectorAll<HTMLElement>('[data-astro-transition-scope], [style*="view-transition-name"]')]
          .some((el) => getComputedStyle(el).viewTransitionName === nome);
        if (presente) banner.dataset.morph = '';
      });

      document.addEventListener('astro:page-load', () => {
        const main = document.querySelector<HTMLElement>('.page-main');
        if (!main || 'revealOff' in main.dataset) return;
        const stop = initReveal(main);
        document.addEventListener('astro:before-swap', stop, { once: true });
      });
    </script>

    <script>
      import { initCookieConsent } from '#lib/consent/init.client';
      import { initPostHogCookieless } from '#lib/analytics/posthog.client';
      document.addEventListener('astro:page-load', () => {
        initPostHogCookieless();
        initCookieConsent();
      });
    </script>
  </body>
</html>

<style>
  .page-body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .page-main {
    flex: 1 1 0%;
  }

  .versione-b {
    margin: 0;
    padding: var(--space-2) var(--space-4);
    background: var(--color-dark);
    color: var(--color-fg-invert);
    font-size: var(--font-size-xs);
    text-align: center;
  }

  .versione-b a {
    margin-inline-start: var(--space-2);
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .versione-b a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }
</style>
