---
import { getEntry } from 'astro:content';
import BaseLayout from '#layouts/BaseLayout.astro';
import { socials } from '#data/socials';
import SocialLinks from '@butik/ui/SocialLinks';
import SectionHeading from '@butik/ui/SectionHeading';
import Eyebrow from '@butik/ui/Eyebrow';

// Copy editoriale content-driven via collezione `pagine` (ADR-0004): il testo
// attorno al form è editabile da Sitepins. La logica del form Web3Forms qui
// sotto resta invariata.
const entry = await getEntry('pagine', 'contatti');
if (!entry || entry.data.type !== 'contatti') {
  throw new Error('Contenuto pagina "contatti" mancante o non valido (collezione pagine).');
}
const c = entry.data;

// ─────────────────────────────────────────────────────────────────────────────
// Web3Forms access key — letta da variabile d'ambiente, NON committata.
// La key è pubblica (viene inviata dal browser e finisce nel bundle statico):
// non è un segreto, ma la teniamo fuori dal sorgente per non averla nella
// history di git. Il prefisso PUBLIC_ è richiesto da Astro per esporla al client.
//   • Locale → file .env (gitignored):  PUBLIC_WEB3FORMS_ACCESS_KEY=la-tua-key
//   • Deploy → GitHub Secret WEB3FORMS_ACCESS_KEY, iniettato nel build in CI.
// Senza la variabile il form non invia e mostra un messaggio inline.
const WEB3FORMS_ACCESS_KEY = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? '';
// ─────────────────────────────────────────────────────────────────────────────

const inputClass = 'field-input';
---

<BaseLayout
  title={c.metaTitle}
  description={c.metaDescription}
>
  <!-- Header -->
  <div class="contact-header">
    <div class="contact-header-heading">
      <SectionHeading as="h1" eyebrow={c.headerEyebrow} title={c.headerTitle} />
    </div>
    <p class="contact-header-lead">
      {c.headerIntro}
    </p>
  </div>

  <section class="contact-section">
    <div class="contact-grid">
      <!-- Form -->
      <div>
        <form id="contact-form" action="https://api.web3forms.com/submit" method="POST" class="contact-form">
          <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />
          <input type="hidden" name="subject" value="Nuovo messaggio dal sito wearebutik.com" />
          <input type="hidden" name="from_name" value="Sito Butik" />
          <!-- Honeypot anti-spam Web3Forms: i bot lo compilano, gli umani no. -->
          <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />

          <div>
            <label for="name" class="form-label">
              {c.formNameLabel}
            </label>
            <input id="name" name="name" type="text" required autocomplete="name" class={inputClass} placeholder={c.formNamePlaceholder} />
          </div>

          <div>
            <label for="email" class="form-label">
              {c.formEmailLabel}
            </label>
            <input id="email" name="email" type="email" required autocomplete="email" class={inputClass} placeholder={c.formEmailPlaceholder} />
          </div>

          <div>
            <label for="organizzazione" class="form-label">
              {c.formOrgLabel}
            </label>
            <input id="organizzazione" name="organizzazione" type="text" autocomplete="organization" class={inputClass} placeholder={c.formOrgPlaceholder} />
          </div>

          <div>
            <label for="message" class="form-label">
              {c.formMessageLabel}
            </label>
            <textarea id="message" name="message" rows="6" required class={inputClass} placeholder={c.formMessagePlaceholder}></textarea>
          </div>

          <button
            type="submit"
            id="contact-submit"
            class="submit-button"
          >
            {c.formSubmitLabel}
          </button>

          <p
            id="form-result"
            class="form-result hidden"
            role="status"
            aria-live="polite"
            data-missing-key={c.formMissingKeyMessage}
            data-loading={c.formSubmitLoadingLabel}
            data-success={c.formSuccessMessage}
            data-error={c.formErrorMessage}
            data-network-error={c.formNetworkErrorMessage}
          ></p>
        </form>
      </div>

      <!-- Recapiti -->
      <aside class="contact-aside">
        <Eyebrow align="left">{c.recapitiEyebrow}</Eyebrow>

        <div class="contact-info">
          <div>
            <p class="info-label">{c.emailLabel}</p>
            <a href={`mailto:${c.emailValue}`} class="info-link">{c.emailValue}</a>
          </div>

          <div>
            <p class="info-label">{c.pecLabel}</p>
            <a href={`mailto:${c.pecValue}`} class="info-link">{c.pecValue}</a>
          </div>

          <div>
            <p class="info-label">{c.sedeLabel}</p>
            <address class="address-block" set:html={c.sedeAddress}>
            </address>
          </div>

          <div>
            <p class="info-label info-label--social">{c.seguiciLabel}</p>
            <SocialLinks socials={socials} />
          </div>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-header {
    /* max-w-3xl: nessun token per i max-width in ui-tokens. */
    max-width: 48rem;
    margin-inline: auto;
    padding-inline: var(--space-6);
    /* pt-20 = 5rem: nessun token combacia (space-16=4rem, space-24=6rem). */
    padding-top: 5rem;
    /* pb-10 = 2.5rem: nessun token combacia (space-8=2rem, space-12=3rem). */
    padding-bottom: 2.5rem;
    text-align: center;
  }
  @media (min-width: 768px) {
    .contact-header {
      padding-top: var(--space-24);
    }
  }

  .contact-header-heading {
    /* mb-5 = 1.25rem: nessun token combacia (space-4=1rem, space-6=1.5rem). */
    margin-bottom: 1.25rem;
  }

  .contact-header-lead {
    font-family: var(--font-sans);
    font-size: var(--font-size-base);
    /* leading-relaxed era già sull'elemento insieme a text-base/md:text-lg:
       vince lui, quindi il line-height resta 1.625 a ogni breakpoint. */
    line-height: 1.625;
    color: var(--color-fg);
  }
  @media (min-width: 768px) {
    .contact-header-lead {
      font-size: var(--font-size-lg);
    }
  }

  .contact-section {
    /* max-w-6xl: nessun token per i max-width in ui-tokens. */
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: var(--space-6);
    /* pb-20 = 5rem: nessun token combacia. */
    padding-bottom: 5rem;
  }
  @media (min-width: 768px) {
    .contact-section {
      padding-bottom: var(--space-24);
    }
  }

  .contact-grid {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    /* gap-10 = 2.5rem: nessun token combacia. */
    gap: 2.5rem;
  }
  @media (min-width: 1024px) {
    .contact-grid {
      grid-template-columns: 1.4fr 1fr;
      gap: var(--space-16);
    }
  }

  /* Tailwind space-y-5: margin-block-end su tutti tranne l'ultimo. */
  .contact-form > *:not(:last-child) {
    /* 1.25rem: nessun token combacia. */
    margin-block-end: 1.25rem;
  }

  /* Nomi mantenuti uguali allo script inline in fondo al file: initContactForm
     fa classList.add/remove/toggle su 'hidden', 'text-butik-red-ink' e
     'text-butik-dark' (honeypot compreso, che parte già nascosto). */
  .hidden {
    display: none;
  }
  .text-butik-red-ink {
    color: var(--color-accent-text);
  }
  .text-butik-dark {
    color: var(--color-fg);
  }

  .form-label {
    display: block;
    font-family: var(--font-display);
    font-size: var(--font-size-xs);
    line-height: calc(1 / 0.75);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-fg);
    margin-bottom: var(--space-2);
  }

  .field-input {
    width: 100%;
    border: 1px solid color-mix(in oklab, var(--color-fg) 20%, transparent);
    background-color: var(--color-white);
    padding-inline: var(--space-4);
    padding-block: var(--space-3);
    font-family: var(--font-sans);
    font-size: var(--font-size-base);
    line-height: 1.5;
    color: var(--color-fg);
    transition: border-color var(--duration-fast) cubic-bezier(0.4, 0, 0.2, 1);
  }
  .field-input::placeholder {
    color: color-mix(in oklab, var(--color-fg) 40%, transparent);
  }
  .field-input:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .submit-button {
    width: 100%;
    background-color: var(--color-fg);
    color: var(--color-fg-invert);
    padding-inline: var(--space-8);
    padding-block: var(--space-3);
    font-family: var(--font-display);
    font-size: var(--font-size-xs);
    line-height: calc(1 / 0.75);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: background-color var(--duration-fast) cubic-bezier(0.4, 0, 0.2, 1);
  }
  @media (min-width: 768px) {
    .submit-button {
      width: auto;
    }
  }
  .submit-button:hover {
    background-color: var(--color-accent);
  }
  .submit-button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .form-result {
    font-family: var(--font-sans);
    font-size: var(--font-size-sm);
    line-height: calc(1.25 / 0.875);
  }

  @media (min-width: 1024px) {
    .contact-aside {
      border-left: 1px solid color-mix(in oklab, var(--color-fg) 15%, transparent);
      /* pl-12 = 3rem = --space-12 */
      padding-left: var(--space-12);
    }
  }

  .contact-info {
    font-family: var(--font-sans);
    font-size: var(--font-size-base);
    line-height: 1.5;
    color: var(--color-fg);
  }
  /* Tailwind space-y-6: margin-block-end su tutti tranne l'ultimo. */
  .contact-info > *:not(:last-child) {
    margin-block-end: var(--space-6);
  }

  .info-label {
    display: block;
    font-family: var(--font-display);
    font-size: var(--font-size-xs);
    line-height: calc(1 / 0.75);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-fg);
    margin-bottom: var(--space-1);
  }
  .info-label--social {
    margin-bottom: var(--space-2);
  }

  .info-link {
    color: var(--color-fg);
    text-decoration: underline;
    transition: color var(--duration-fast) cubic-bezier(0.4, 0, 0.2, 1);
  }
  .info-link:hover {
    color: var(--color-accent-text);
  }

  .address-block {
    font-style: normal;
    line-height: 1.625;
    color: color-mix(in oklab, var(--color-fg) 80%, transparent);
  }
</style>

<script>
  import { trackEvent } from '#lib/analytics/posthog.client';

  // Aggancia il form. Idempotente: con ClientRouter astro:page-load rifà girare
  // questa init ad ogni navigazione, ma il binding avviene una volta per elemento.
  // Messaggi di stato content-driven (issue #26): letti dai data-* di #form-result.
  function initContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    if (!form || form.dataset.bound === 'true') return;
    const result = document.getElementById('form-result');
    const submit = document.getElementById('contact-submit') as HTMLButtonElement | null;
    if (!result || !submit) return;
    form.dataset.bound = 'true';

    const formMissingKeyMessage = result.dataset.missingKey ?? '';
    const formSubmitLoadingLabel = result.dataset.loading ?? '';
    const formSuccessMessage = result.dataset.success ?? '';
    const formErrorMessage = result.dataset.error ?? '';
    const formNetworkErrorMessage = result.dataset.networkError ?? '';

    const showMessage = (text: string, ok: boolean) => {
      result.textContent = text;
      result.classList.remove('hidden');
      result.classList.toggle('text-butik-red-ink', !ok);
      result.classList.toggle('text-butik-dark', ok);
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const accessKey = (form.elements.namedItem('access_key') as HTMLInputElement)?.value;
      if (!accessKey) {
        showMessage(formMissingKeyMessage, false);
        return;
      }

      submit.disabled = true;
      const originalLabel = submit.textContent;
      submit.textContent = formSubmitLoadingLabel;

      try {
        const formData = new FormData(form);
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: formData,
        });
        const data = await response.json();

        if (response.ok && data.success) {
          form.reset();
          showMessage(formSuccessMessage, true);
          trackEvent('contact_form_submitted');
        } else {
          showMessage(data.message || formErrorMessage, false);
          trackEvent('contact_form_error', { error_message: data.message });
        }
      } catch {
        showMessage(formNetworkErrorMessage, false);
        trackEvent('contact_form_error', { error_message: 'network_error' });
      } finally {
        submit.disabled = false;
        submit.textContent = originalLabel;
      }
    });
  }

  // astro:page-load gira al primo caricamento e dopo ogni navigazione ClientRouter.
  document.addEventListener('astro:page-load', initContactForm);
</script>
