---
// Termini di utilizzo — content-driven via Sitepins (ADR-0004). Stessa forma
// di privacy.astro (PR #30): prosa lunga senza struttura ricorrente, corpo
// nel body Markdown dell'entry (come `progetti`), frontmatter minimo.
import { getEntry, render } from 'astro:content';
import BaseLayout from '#layouts/BaseLayout.astro';

const entry = await getEntry('pagine', 'termini');
if (!entry || entry.data.type !== 'termini') {
  throw new Error('Contenuto pagina "termini" mancante o non valido (collezione pagine).');
}
const c = entry.data;
const { Content } = await render(entry);
---

<BaseLayout
  title={c.metaTitle}
  description={c.metaDescription}
>
  <article class="terms-article">
    <div class="prose prose-full">
      <h1>{c.pageTitle}</h1>
      <p><em>Ultimo aggiornamento: {c.updatedDate}.</em></p>
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .terms-article {
    max-width: 48rem; /* max-w-3xl, nessun token (stesso letterale di privacy.astro) */
    margin-inline: auto;
    padding-inline: var(--space-6); /* px-6 = 1.5rem */
    padding-block: var(--space-16); /* py-16 = 4rem */
  }
  @media (min-width: 768px) {
    .terms-article {
      padding-block: var(--space-24); /* py-24 = 6rem */
    }
  }
</style>
