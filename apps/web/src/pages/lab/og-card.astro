    }
  }

  .page-lead {
    font-family: var(--font-sans);
    font-size: var(--font-size-base);
    color: var(--color-fg);
    max-width: 48rem; /* max-w-3xl, nessun token */
    line-height: 1.625; /* leading-relaxed vince sul line-height implicito di text-base/lg */
  }
  @media (min-width: 768px) {
    .page-lead {
      font-size: var(--font-size-lg);
    }
  }

  .table-section {
    max-width: 64rem; /* max-w-5xl, nessun token */
    margin-inline: auto;
    padding-inline: var(--space-6);
    padding-block: var(--space-8);
    border-top: 1px solid color-mix(in oklab, var(--color-fg) 10%, transparent);
  }

