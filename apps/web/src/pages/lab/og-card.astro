---
// LAB — helper di verifica delle card Open Graph.
// Le card sono generate a build-time dal generatore in produzione
// (`data/ogCards.ts` + `pages/og/[...path].png.ts`): questa pagina non le
// ridisegna, elenca solo cosa è stato generato e offre le scorciatoie per
// controllarlo sugli strumenti esterni.
import BaseLayout from '#layouts/BaseLayout.astro';
import { getAllOgCards, ogPngPathForRoute } from '../../data/ogCards';

const PROD = 'https://wearebutik.github.io';
const ogCards = await getAllOgCards();
const cardLinks = [...ogCards.entries()]
  .map(([route, card]) => {
    const pageUrl = PROD + (route === '/' ? '/' : `${route}/`);
    return {
      route,
      title: card.title,
      layout: card.layout ?? 'plain',
      png: ogPngPathForRoute(route),
      pageUrl,
      opengraph: `https://www.opengraph.xyz/url/${encodeURIComponent(pageUrl)}`,
      linkedin: `https://www.linkedin.com/post-inspector/inspect/${encodeURIComponent(pageUrl)}`,
    };
  })
  .sort((a, b) => a.route.localeCompare(b.route));
---

<BaseLayout title="Card OG — verifica — Butik" description="Helper interno: le card Open Graph generate e come controllarle.">
  <section class="page-intro">
    <p class="eyebrow">Interno · helper</p>
    <h1 class="page-title">Card Open Graph — verifica</h1>
    <p class="page-lead">
      Una PNG per pagina, generata alla build dal generatore in produzione. Qui sotto
      l’elenco completo: apri il <strong>PNG</strong> per vedere l’immagine (funziona
      anche in locale), oppure passa l’URL della pagina ai validator — quelli
      richiedono il sito pubblicato.
    </p>
  </section>

  <section class="table-section">
    <p class="section-eyebrow">
      Card generate · in produzione
    </p>
    <h2 class="section-title">
      Immagini reali & test
    </h2>
    <p class="section-lead">
      Per ogni pagina: l’immagine PNG effettivamente generata, l’URL della pagina
      (da incollare nei validator) e una scorciatoia per testarla. In locale apri il
      <strong>PNG</strong>; per i validator serve l’URL pubblico (online dopo il deploy).
    </p>
    <div class="table-wrap">
      <table class="card-table">
        <thead>
          <tr class="table-head-row">
            <th class="table-head-cell">Pagina</th>
            <th class="table-head-cell">Layout</th>
            <th class="table-head-cell">Immagine</th>
            <th class="table-head-cell">URL pagina</th>
            <th class="table-head-cell">Test</th>
          </tr>
        </thead>
        <tbody>
          {cardLinks.map((c) => (
            <tr class="table-row">
              <td class="cell-route">{c.route}</td>
              <td class="cell-layout">{c.layout}</td>
              <td class="cell-png">
                <a href={c.png} target="_blank" class="cell-link">PNG ↗</a>
              </td>
              <td class="cell-url">
                <a href={c.pageUrl} target="_blank" class="cell-url-link">{c.pageUrl}</a>
              </td>
              <td class="cell-test">
                <a href={c.opengraph} target="_blank" class="cell-link">opengraph.xyz</a>
                <span class="cell-sep"> · </span>
                <a href={c.linkedin} target="_blank" class="cell-link">LinkedIn</a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

</BaseLayout>

<style>
