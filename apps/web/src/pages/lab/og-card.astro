---
// LAB — helper di verifica delle card Open Graph.
// Le card sono generate a build-time dal generatore in produzione
// (`data/ogCards.ts` + `pages/og/[...path].png.ts`): questa pagina non le
// ridisegna, elenca solo cosa è stato generato e offre le scorciatoie per
// controllarlo sugli strumenti esterni.
import BaseLayout from '#layouts/BaseLayout.astro';
import { getAllOgCards, ogPngPathForRoute } from '../../data/ogCards';

const PROD = 'https://wearebutik.github.io';
const ogCards = await getAllOgCards();
const cardLinks = [...ogCards.entries()]
  .map(([route, card]) => {
    const pageUrl = PROD + (route === '/' ? '/' : `${route}/`);
    return {
      route,
      title: card.title,
      layout: card.layout ?? 'plain',
      png: ogPngPathForRoute(route),
      pageUrl,
      opengraph: `https://www.opengraph.xyz/url/${encodeURIComponent(pageUrl)}`,
      linkedin: `https://www.linkedin.com/post-inspector/inspect/${encodeURIComponent(pageUrl)}`,
    };
  })
  .sort((a, b) => a.route.localeCompare(b.route));
---

<BaseLayout title="Card OG — verifica — Butik" description="Helper interno: le card Open Graph generate e come controllarle.">
  <section class="max-w-5xl mx-auto px-6 pt-24 pb-8">
    <p class="font-display text-xs font-bold tracking-widest uppercase text-butik-red-ink mb-3">Interno · helper</p>
    <h1 class="font-heading text-4xl md:text-5xl font-bold text-butik-dark mb-4">Card Open Graph — verifica</h1>
    <p class="font-sans text-base md:text-lg text-butik-body max-w-3xl leading-relaxed">
      Una PNG per pagina, generata alla build dal generatore in produzione. Qui sotto
      l’elenco completo: apri il <strong>PNG</strong> per vedere l’immagine (funziona
      anche in locale), oppure passa l’URL della pagina ai validator — quelli
      richiedono il sito pubblicato.
    </p>
  </section>

  <section class="max-w-5xl mx-auto px-6 py-8 border-t border-butik-dark/10">
    <p class="font-display text-xs font-bold tracking-widest uppercase text-butik-red-ink mb-2">
      Card generate · in produzione
    </p>
    <h2 class="font-heading text-2xl md:text-3xl font-bold text-butik-dark mb-2">
      Immagini reali & test
    </h2>
    <p class="font-sans text-sm text-butik-dark/60 max-w-2xl leading-relaxed mb-6">
      Per ogni pagina: l’immagine PNG effettivamente generata, l’URL della pagina
      (da incollare nei validator) e una scorciatoia per testarla. In locale apri il
      <strong>PNG</strong>; per i validator serve l’URL pubblico (online dopo il deploy).
    </p>
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="border-b border-butik-dark/15">
            <th class="font-display text-xs font-bold tracking-widest uppercase text-butik-red-ink py-2 pr-4">Pagina</th>
            <th class="font-display text-xs font-bold tracking-widest uppercase text-butik-red-ink py-2 pr-4">Layout</th>
            <th class="font-display text-xs font-bold tracking-widest uppercase text-butik-red-ink py-2 pr-4">Immagine</th>
            <th class="font-display text-xs font-bold tracking-widest uppercase text-butik-red-ink py-2 pr-4">URL pagina</th>
            <th class="font-display text-xs font-bold tracking-widest uppercase text-butik-red-ink py-2">Test</th>
          </tr>
        </thead>
        <tbody>
          {cardLinks.map((c) => (
            <tr class="border-b border-butik-dark/10 align-top">
              <td class="font-sans text-sm text-butik-dark py-3 pr-4 whitespace-nowrap">{c.route}</td>
              <td class="font-sans text-xs text-butik-dark/60 py-3 pr-4 whitespace-nowrap">{c.layout}</td>
              <td class="py-3 pr-4 whitespace-nowrap">
                <a href={c.png} target="_blank" class="font-sans text-sm text-butik-red-ink underline">PNG ↗</a>
              </td>
              <td class="py-3 pr-4">
                <a href={c.pageUrl} target="_blank" class="font-sans text-sm text-butik-dark/70 underline break-all">{c.pageUrl}</a>
              </td>
              <td class="py-3 whitespace-nowrap">
                <a href={c.opengraph} target="_blank" class="font-sans text-sm text-butik-red-ink underline">opengraph.xyz</a>
                <span class="text-butik-dark/30"> · </span>
                <a href={c.linkedin} target="_blank" class="font-sans text-sm text-butik-red-ink underline">LinkedIn</a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

</BaseLayout>
