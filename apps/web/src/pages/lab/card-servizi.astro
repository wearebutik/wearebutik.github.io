---
// LAB — prova usa e getta: come rendere più visibile il nome del servizio
// nelle card dell'hero, e dove usare gli accenti tipografici di @butik/ui
// (Underline, Mark). Ogni variante dichiara cosa cambia. Dopo la scelta la
// variante vincente va in ServiceCard/Hero e questa pagina si cancella.
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '#layouts/BaseLayout.astro';
import Mark from '@butik/ui/Mark';
import Underline from '@butik/ui/Underline';
import { imageSize } from '#lib/media';

const home = await getEntry('pagine', 'home');
const sfondo = home?.data.type === 'home' ? home.data.heroImages[0]?.src : undefined;
const titolo = home?.data.type === 'home' ? home.data.heroTitle : 'Attiviamo territori attraverso la musica';
const [testa, ultima] = [titolo.slice(0, titolo.lastIndexOf(' ')), titolo.slice(titolo.lastIndexOf(' ') + 1)];

const servizi = (await getCollection('servizi', (e) => !e.data.draft)).sort((a, b) => a.data.order - b.data.order);

// Soluzione 3: descrizioni di una riga, accorciate da quelle attuali (nessun
// dato nuovo). Solo per la prova: se vince, vanno nel campo `card.desc` su Sanity.
const brevi: Record<string, string> = {
  'progettazione-culturale': 'Progetti culturali finanziati.',
  'consulenza-strategica': 'Il patrimonio musicale come asset.',
  'formazione-capacity-building': 'Percorsi per operatori e giovani.',
  'eventi-culturali-musicali': 'Format che attivano comunità.',
  'prodotti-turistico-musicali': 'Itinerari, mappe e guide.',
};

const icons: Record<string, string> = {
  'progettazione-culturale': '<path d="M12 3v18M3 12h18M5.6 5.6l12.8 12.8M18.4 5.6 5.6 18.4"/>',
  'consulenza-strategica': '<circle cx="12" cy="12" r="9"/><path d="M9.5 14.5 11 9l4.5-1.5L14 13z"/>',
  'formazione-capacity-building': '<path d="M12 4 2 9l10 5 10-5z"/><path d="M6 11v4c0 1.1 2.7 3 6 3s6-1.9 6-3v-4"/>',
  'eventi-culturali-musicali': '<path d="M4 12v1.5M8 8.5v7M12 5v14M16 9v6M20 11v2.5"/>',
  'prodotti-turistico-musicali': '<path d="M12 21s7-6 7-11a7 7 0 1 0-14 0c0 5 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/>',
};

type Accento = 'nessuno' | 'linea' | 'mark';
const varianti: { id: string; nome: string; nota: string; grande: boolean; accento: Accento; breve: boolean }[] = [
  { id: '0', nome: 'Attuale', nota: 'Titolo 17 px, descrizione su tre righe, filigrana.', grande: false, accento: 'nessuno', breve: false },
  { id: '1', nome: '1 · Titolo più grande', nota: 'Titolo ~21 px con più aria sotto. Gerarchia netta, nessun elemento in più.', grande: true, accento: 'nessuno', breve: false },
  { id: '1+2a', nome: '1 + 2 · Lineetta rossa', nota: 'Una lineetta rossa sopra il titolo: riprende l’ancora che dava l’icona.', grande: true, accento: 'linea', breve: false },
  { id: '1+2b', nome: '1 + 2 · Mark', nota: 'Al posto della lineetta, un Mark (stella a quattro punte) di @butik/ui.', grande: true, accento: 'mark', breve: false },
  { id: '1+3', nome: '1 + 3 · Descrizione corta', nota: 'Una riga di descrizione: il titolo resta l’elemento principale.', grande: true, accento: 'nessuno', breve: true },
  { id: '1+2+3', nome: '1 + 2 + 3 · Tutto insieme', nota: 'Titolo grande, lineetta rossa, descrizione di una riga.', grande: true, accento: 'linea', breve: true },
];
---

<BaseLayout title="Card servizi — Lab" description="Prova interna sulle card dei servizi." noindex>
  <section class="intro">
    <p class="eyebrow">Lab · prova usa e getta</p>
    <h1 class="h1">Card dei servizi e accenti tipografici</h1>
    <p class="lead">
      Le soluzioni per rendere più visibile il nome del servizio, da sole e combinate, sullo stesso
      sfondo dell’hero. In fondo, gli accenti tipografici (Underline, Mark) sul titolo dell’hero.
    </p>
  </section>

  {varianti.map((v) => (
    <section class="banda" aria-labelledby={`v-${v.id}`}>
      {sfondo && <Image src={sfondo} {...imageSize(sfondo)} alt="" widths={[1280, 1920]} sizes="100vw" class="banda__bg" />}
      <div class="banda__velo" aria-hidden="true"></div>
      <div class="banda__inner">
        <h2 id={`v-${v.id}`} class="banda__nome">{v.nome}</h2>
        <p class="banda__nota">{v.nota}</p>
        <div class="cards">
          {servizi.map((s) => (
            <a href={`/servizi/${s.id}`} class:list={['card', { 'card--grande': v.grande }]}>
              <svg class="card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[s.id]} />
              <div class="card__body">
                {v.accento === 'linea' && <span class="card__linea" aria-hidden="true"></span>}
                {v.accento === 'mark' && <span class="card__mark" aria-hidden="true"><Mark type="spark" size={16} /></span>}
                <h3 class="card__title">{s.data.card.title}</h3>
                <p class="card__desc">{v.breve ? brevi[s.id] ?? s.data.card.desc : s.data.card.desc}</p>
                <span class="card__stat">{`${s.data.card.statValue} ${s.data.card.statLabel}`}</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  ))}

  <section class="banda banda--hero" aria-labelledby="v-hero">
    {sfondo && <Image src={sfondo} {...imageSize(sfondo)} alt="" widths={[1280, 1920]} sizes="100vw" class="banda__bg" />}
    <div class="banda__velo" aria-hidden="true"></div>
    <div class="banda__inner">
      <h2 id="v-hero" class="banda__nome">Accenti tipografici sul titolo dell’hero</h2>
      <p class="banda__nota">A: Underline sull’ultima parola (si disegna entrando in vista; con reduced-motion è già disegnata). B: Underline + due Mark ai lati. C: solo Mark.</p>

      <p class="banda__etichetta">A · Underline</p>
      <p class="hero-title">{testa} <Underline client:visible tone="accent">{ultima}</Underline></p>

      <p class="banda__etichetta">B · Underline + Mark</p>
      <p class="hero-title">
        <span class="hero-mark hero-mark--sx" aria-hidden="true"><Mark type="sparkle" size={28} tone="accent" twinkle /></span>
        {testa} <Underline client:visible tone="accent">{ultima}</Underline>
        <span class="hero-mark hero-mark--dx" aria-hidden="true"><Mark type="spark" size={20} tone="highlight" twinkle /></span>
      </p>

      <p class="banda__etichetta">C · Solo Mark</p>
      <p class="hero-title">
        <span class="hero-mark hero-mark--sx" aria-hidden="true"><Mark type="sparkle" size={28} tone="accent" twinkle /></span>
        {titolo}
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .intro {
    max-width: 72rem; /* larghezza contenitore del lab */
    margin-inline: auto;
    padding: var(--space-24) var(--space-6) var(--space-8);
  }
  .eyebrow {
    font-family: var(--font-display);
    font-size: var(--font-size-xs);
    font-weight: 700;
    letter-spacing: 0.1em; /* come l'eyebrow di lab/index */
    text-transform: uppercase;
    color: var(--color-accent-text);
    margin-bottom: var(--space-3);
  }
  .h1 {
    font-family: var(--font-heading);
    font-size: var(--text-4xl);
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: var(--space-4);
  }
  .lead {
    font-family: var(--font-sans);
    font-size: var(--font-size-base);
    line-height: 1.6;
    max-width: 48rem; /* misura di lettura */
  }

  /* Banda con lo stesso sfondo dell'hero (foto + velo al 60%). */
  .banda {
    position: relative;
    overflow: hidden;
    background-color: var(--color-fg);
  }
  .banda__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .banda__velo {
    position: absolute;
    inset: 0;
    background-color: color-mix(in srgb, var(--color-fg) 60%, transparent);
  }
  .banda__inner {
    position: relative;
    max-width: 80rem; /* come l'hero */
    margin-inline: auto;
    padding: var(--space-12) var(--space-8);
  }
  .banda__nome {
    font-family: var(--font-heading);
    font-size: var(--font-size-xl);
    font-weight: 700;
    color: var(--color-white);
    text-transform: none;
    letter-spacing: 0;
  }
  .banda__nota,
  .banda__etichetta {
    font-family: var(--font-sans);
    font-size: var(--font-size-sm);
    color: color-mix(in srgb, var(--color-white) 85%, transparent);
    margin: var(--space-2) 0 var(--space-6);
    max-width: 48rem; /* misura di lettura */
  }
  .banda__etichetta {
    margin: var(--space-8) 0 var(--space-2);
    font-weight: 700;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }
  @media (min-width: 1024px) {
    .cards {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }

  /* Card: copia della ServiceCard attuale, con le varianti. */
  .card {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    background: var(--color-white);
    border: 1px solid color-mix(in srgb, var(--color-fg) 15%, transparent);
    padding: 1.25rem 1.25rem 1.4rem; /* come ServiceCard */
    text-decoration: none;
  }
  .card:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }
  .card__icon {
    position: absolute;
    right: -1.75rem;
    bottom: -1.75rem;
    width: 8.5rem; /* come ServiceCard */
    height: 8.5rem;
    color: var(--color-accent);
    opacity: 0.12;
  }
  .card__body {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.5rem; /* come ServiceCard */
  }
  .card__title {
    font-family: var(--font-heading);
    font-size: 1.0625rem; /* attuale: 17px */
    font-weight: 700;
    line-height: 1.2;
    text-transform: none;
    letter-spacing: -0.005em;
    color: var(--color-fg);
    margin: 0;
  }
  .card--grande .card__title {
    font-size: 1.3125rem; /* 21px: soluzione 1 */
    line-height: 1.15;
    margin-bottom: var(--space-1);
  }
  .card__desc {
    font-family: var(--font-sans);
    font-size: 0.875rem; /* come ServiceCard */
    line-height: 1.45;
    color: color-mix(in srgb, var(--color-fg) 70%, transparent);
    flex: 1;
    margin: 0;
  }
  .card__stat {
    font-family: var(--font-display);
    font-size: 0.6875rem; /* come ServiceCard */
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-fg) 65%, transparent);
  }
  .card__linea {
    display: block;
    width: 1.75rem;
    height: 3px;
    background-color: var(--color-accent);
    margin-bottom: var(--space-1);
  }
  .card__mark {
    display: block;
    color: var(--color-accent);
    line-height: 0;
  }

  .hero-title {
    position: relative;
    font-family: var(--font-heading);
    font-size: var(--text-5xl);
    font-weight: 700;
    line-height: 1.1;
    color: var(--color-white);
    text-align: center;
    max-width: 56rem; /* come l'hero */
    margin-inline: auto;
  }
  .hero-mark {
    display: inline-block;
    vertical-align: super;
    line-height: 0;
  }
  .hero-mark--sx {
    margin-right: var(--space-2);
  }
  .hero-mark--dx {
    margin-left: var(--space-2);
  }
</style>
