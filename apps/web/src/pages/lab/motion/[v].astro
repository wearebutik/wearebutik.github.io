---
// LAB — prova usa e getta: tre direzioni di animazione d'ingresso sulla home
// vera (stesso componente HomePage di pages/index.astro). Cambia solo il CSS,
// applicato dal contenitore [data-motion]. Dopo la scelta la direzione vincente
// diventa un sistema riusabile (token + attributo sulle sezioni) e questa
// pagina si cancella.
//
// La prova B è la versione con un piccolo script (in fondo): ogni elemento
// si anima una volta sola, la prima volta che entra, e gli elementi che
// entrano insieme partono in sequenza (come le card dell'hero). L'entrata
// dell'hero è quella del sito (Hero.astro). A e C hanno le regole CSS sotto.
//
// Tecnica comune, solo CSS (la stessa dei numeri, components/home/Numbers.astro):
// ogni sezione ha un interruttore legato allo scroll (--in-vista 0→1 quando
// entra in vista); i suoi elementi, con una style query su --in-vista, avviano
// un'animazione A TEMPO. Niente segue lo scroll. Senza view timeline (Firefox)
// o con reduced-motion non si nasconde né si anima nulla.
//
// L'hero è già in vista all'apertura: la sua entrata parte al caricamento,
// a tempo, senza interruttore (e resta attiva anche dove le view timeline non
// ci sono; con reduced-motion no).
import BaseLayout from '#layouts/BaseLayout.astro';
import HomePage from '#components/home/HomePage.astro';

export function getStaticPaths() {
  return [
    { params: { v: 'a' }, props: { nome: 'A · Rivelazione sobria', nota: 'Dissolvenza e piccola salita; gli elementi delle griglie entrano in sequenza.' } },
    { params: { v: 'b' }, props: { nome: 'B · Ritmo musicale (con JavaScript)', nota: 'Ogni elemento sale con un piccolo rimbalzo la prima volta che entra, poi resta. Quelli che entrano insieme partono in sequenza, 120ms l’uno dall’altro (il metodo, su desktop, entra in fila come i servizi). I titoli di sezione si sottolineano di rosso.' } },
    { params: { v: 'c' }, props: { nome: 'C · Editoriale', nota: 'I titoli si rivelano da una maschera, le foto entrano con una tendina, i testi in dissolvenza.' } },
  ];
}

const { v } = Astro.params;
const { nome, nota } = Astro.props;
const altre = ['a', 'b', 'c'].filter((x) => x !== v);
---

<BaseLayout title={`Motion ${v?.toUpperCase()} — Lab`} description="Prova interna di animazioni d’ingresso." noindex>
  <aside class="lab-bar" aria-label="Prova di motion">
    <strong>{nome}</strong> — {nota}
    <span class="lab-bar__links">
      {altre.map((x) => <a href={`/lab/motion/${x}`}>Vai a {x.toUpperCase()}</a>)}
    </span>
  </aside>
  <div class="motion" data-motion={v} style={v === 'b' ? '--motion-inset: 12%' : undefined}>
    <HomePage />
  </div>
</BaseLayout>

<style>
  .lab-bar {
    position: fixed;
    z-index: 60;
    left: var(--space-4);
    bottom: var(--space-4);
    max-width: 32rem; /* barra informativa compatta */
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-lg);
    background-color: var(--color-white);
    color: var(--color-fg);
    font-family: var(--font-sans);
    font-size: var(--font-size-sm);
    box-shadow: 0 8px 24px rgba(7, 17, 8, 0.2);
  }
  .lab-bar__links {
    display: flex;
    gap: var(--space-4);
    margin-top: var(--space-2);
  }
  .lab-bar a {
    color: var(--color-accent-text);
    font-weight: 700;
  }
</style>

<style is:global>
  /* ── Comune: interruttore per sezione ─────────────────────────────────── */
  @property --in-vista {
    syntax: '<integer>';
    initial-value: 0;
    inherits: true;
  }
  @keyframes lab-interruttore {
    from { --in-vista: 0; }
    to { --in-vista: 1; }
  }

  /* ── Hero: entrata al caricamento ─────────────────────────────────────── */
  @media (prefers-reduced-motion: no-preference) {
    @keyframes lab-hero-su {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: none; }
    }
    @keyframes lab-hero-eq {
      0% { opacity: 0; transform: scaleY(0.3); }
      60% { opacity: 1; transform: scaleY(1.08); }
      100% { opacity: 1; transform: none; }
    }
    @keyframes lab-hero-maschera {
      from { clip-path: inset(0 0 100% 0); transform: translateY(0.3em); }
      to { clip-path: inset(0 0 -0.3em 0); transform: none; }
    }
    @keyframes lab-hero-zoom {
      from { transform: scale(1.08); }
      to { transform: none; }
    }
    @keyframes lab-hero-dissolvi {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    /* A: tutto sale in dissolvenza, in sequenza: titolo, sottotitolo, pulsante, card. */
    [data-motion='a'] :is(.hero-title, .hero-subtitle, .hero-cta, .hero-svc-cards > *, .hero-svc-list, .hero-explore) {
      animation: lab-hero-su 700ms var(--ease-out) both;
    }
    [data-motion='a'] .hero-subtitle { animation-delay: 120ms; }
    [data-motion='a'] .hero-cta { animation-delay: 240ms; }
    [data-motion='a'] :is(.hero-svc-cards > *, .hero-svc-list) { animation-delay: 360ms; }
    [data-motion='a'] .hero-svc-cards > :nth-child(2) { animation-delay: 440ms; }
    [data-motion='a'] .hero-svc-cards > :nth-child(3) { animation-delay: 520ms; }
    [data-motion='a'] .hero-svc-cards > :nth-child(4) { animation-delay: 600ms; }
    [data-motion='a'] .hero-svc-cards > :nth-child(5) { animation-delay: 680ms; }
    [data-motion='a'] .hero-explore { animation-delay: 800ms; }


    /* C: la foto parte leggermente ingrandita e si assesta; il titolo si
       rivela da una maschera, il resto entra in dissolvenza. */
    [data-motion='c'] .hero-slides {
      animation: lab-hero-zoom 1800ms var(--ease-out) both;
    }
    [data-motion='c'] .hero-title {
      animation: lab-hero-maschera 900ms var(--ease-out) 150ms both;
    }
    [data-motion='c'] :is(.hero-subtitle, .hero-cta, .hero-svc-cards, .hero-svc-list, .hero-explore) {
      animation: lab-hero-dissolvi 800ms var(--ease-out) both;
    }
    [data-motion='c'] .hero-subtitle { animation-delay: 500ms; }
    [data-motion='c'] .hero-cta { animation-delay: 650ms; }
    [data-motion='c'] :is(.hero-svc-cards, .hero-svc-list) { animation-delay: 850ms; }
    [data-motion='c'] .hero-explore { animation-delay: 1000ms; }
  }

  /* Elementi animati, per tutte le direzioni:
     - titoli di sezione (h2)
     - elementi delle griglie e delle liste (figli di classi *grid*, *list*, *cards*)
     - testi introduttivi (p diretti delle intestazioni) e immagini. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .motion:is([data-motion='a'], [data-motion='c']) section:not(.hero) {
        animation: lab-interruttore linear both;
        animation-timeline: view();
        animation-range: entry 15% entry 16%;
      }

      /* ── A · Rivelazione sobria ─────────────────────────────────────── */
      @keyframes lab-a {
        from { opacity: 0; transform: translateY(16px); }
        to { opacity: 1; transform: none; }
      }
      [data-motion='a'] section:not(.hero) :is(h2, p, [class*='grid'] > *, [class*='list'] > *, [class*='cards'] > *, ol > li, img) {
        opacity: 0;
      }
      @container style(--in-vista: 1) {
        [data-motion='a'] section:not(.hero) :is(h2, p, [class*='grid'] > *, [class*='list'] > *, [class*='cards'] > *, ol > li, img) {
          animation: lab-a 600ms var(--ease-out) both;
        }
        [data-motion='a'] :is([class*='grid'], [class*='list'], [class*='cards'], ol) > :nth-child(2) { animation-delay: 80ms; }
        [data-motion='a'] :is([class*='grid'], [class*='list'], [class*='cards'], ol) > :nth-child(3) { animation-delay: 160ms; }
        [data-motion='a'] :is([class*='grid'], [class*='list'], [class*='cards'], ol) > :nth-child(4) { animation-delay: 240ms; }
        [data-motion='a'] :is([class*='grid'], [class*='list'], [class*='cards'], ol) > :nth-child(5) { animation-delay: 320ms; }
        [data-motion='a'] :is([class*='grid'], [class*='list'], [class*='cards'], ol) > :nth-child(n + 6) { animation-delay: 400ms; }
        [data-motion='a'] section:not(.hero) p { animation-delay: 100ms; }
      }


      /* ── C · Editoriale ─────────────────────────────────────────────── */
      @keyframes lab-c-titolo {
        from { clip-path: inset(0 0 100% 0); transform: translateY(0.4em); }
        to { clip-path: inset(0 0 -0.2em 0); transform: none; }
      }
      @keyframes lab-c-foto {
        from { clip-path: inset(0 100% 0 0); }
        to { clip-path: inset(0 0 0 0); }
      }
      @keyframes lab-c-testo {
        from { opacity: 0; }
        to { opacity: 1; }
      }
      [data-motion='c'] section:not(.hero) h2 { clip-path: inset(0 0 100% 0); }
      [data-motion='c'] section:not(.hero) img { clip-path: inset(0 100% 0 0); }
      [data-motion='c'] section:not(.hero) :is(p, [class*='grid'] > *, [class*='list'] > *, [class*='cards'] > *, ol > li) { opacity: 0; }
      @container style(--in-vista: 1) {
        [data-motion='c'] section:not(.hero) h2 { animation: lab-c-titolo 800ms var(--ease-out) both; }
        [data-motion='c'] section:not(.hero) img { animation: lab-c-foto 1000ms cubic-bezier(0.65, 0, 0.35, 1) 150ms both; }
        [data-motion='c'] section:not(.hero) :is(p, [class*='grid'] > *, [class*='list'] > *, [class*='cards'] > *, ol > li) {
          animation: lab-c-testo 700ms var(--ease-out) 300ms both;
        }
      }
    }
  }
  /* ── B · Ritmo musicale, con JavaScript ─────────────────────────────────
     Lo script arma gli elementi (data-reveal="attesa") e li fa partire
     (data-reveal="in") quando entrano, con il ritardo --d della sequenza.
     Senza script nulla è armato: tutto resta visibile. */
  @keyframes lab-b-battito {
    0% { opacity: 0; transform: scaleY(0.4); }
    60% { opacity: 1; transform: scaleY(1.06); }
    100% { opacity: 1; transform: none; }
  }
  @keyframes lab-b-sottolinea {
    from { text-decoration-color: transparent; text-underline-offset: 0.6em; }
    to { text-decoration-color: var(--color-accent); text-underline-offset: 0.18em; }
  }
  @media (prefers-reduced-motion: no-preference) {
    [data-motion='b'] [data-reveal='attesa']:not(h2) {
      opacity: 0;
    }
    [data-motion='b'] [data-reveal='in']:not(h2) {
      transform-origin: bottom;
      animation: lab-b-battito 600ms cubic-bezier(0.34, 1.4, 0.64, 1) var(--d, 0ms) both;
    }
    [data-motion='b'] h2[data-reveal] {
      text-decoration-line: underline;
      text-decoration-thickness: 3px;
      text-decoration-color: transparent;
      text-underline-offset: 0.6em;
    }
    [data-motion='b'] h2[data-reveal='in'] {
      animation: lab-b-sottolinea 600ms cubic-bezier(0.34, 1.4, 0.64, 1) 150ms both;
    }
  }
</style>

<script>
  // Prova B: animazione d'ingresso una volta sola, con sequenza per gli
  // elementi che entrano insieme. Idempotente sotto il ClientRouter
  // (docs/guidances/client-scripts.md): si arma a ogni astro:page-load solo
  // sui nodi non ancora armati, e l'osservatore si stacca prima dello swap.
  const GRUPPI = "section:not(.hero) :is([class*='grid'], [class*='list'], [class*='cards'], ol:not(.prose ol))";
  const PASSO = 120; // ms fra un elemento e il successivo della stessa entrata
  const ATTESA = 150; // ms prima del primo, perché il rimbalzo si veda

  function initRevealB() {
    const root = document.querySelector<HTMLElement>("[data-motion='b']");
    if (!root || root.dataset.revealBound) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (!('IntersectionObserver' in window)) return;
    root.dataset.revealBound = 'true';

    const elementi = [
      ...root.querySelectorAll<HTMLElement>(`${GRUPPI} > :not([data-no-reveal])`),
      ...root.querySelectorAll<HTMLElement>('section:not(.hero) h2:not(.prose h2)'),
    ];
    elementi.forEach((el) => (el.dataset.reveal = 'attesa'));

    const io = new IntersectionObserver(
      (entries) => {
        // Gli elementi che entrano nello stesso momento partono in sequenza,
        // nell'ordine della pagina.
        const entrati = entries
          .filter((e) => e.isIntersecting)
          .map((e) => e.target as HTMLElement)
          .sort((a, b) => (a.compareDocumentPosition(b) & Node.DOCUMENT_POSITION_FOLLOWING ? -1 : 1));
        entrati.forEach((el, i) => {
          el.style.setProperty('--d', `${ATTESA + i * PASSO}ms`);
          el.dataset.reveal = 'in';
          io.unobserve(el);
        });
      },
      { rootMargin: '0px 0px -8% 0px' },
    );
    elementi.forEach((el) => io.observe(el));
    document.addEventListener('astro:before-swap', () => io.disconnect(), { once: true });
  }

  document.addEventListener('astro:page-load', initRevealB);
</script>
