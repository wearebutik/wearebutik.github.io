---
// LAB — prova usa e getta: due varianti del menu mobile sulla home vera
// (A a tutto schermo, B tendina scura). Si guarda da telefono o con la
// finestra stretta. Dopo la scelta la vincente diventa il menu del sito
// (Header.astro, senza data-menu) e questa pagina si cancella.
import BaseLayout from '#layouts/BaseLayout.astro';
import HomePage from '#components/home/HomePage.astro';

export function getStaticPaths() {
  return [
    { params: { v: 'a' }, props: { nome: 'A · Menu a tutto schermo', nota: 'Vetro scuro sopra la pagina, voci grandi, pulsante rosso, X per chiudere.' } },
    { params: { v: 'b' }, props: { nome: 'B · Tendina scura', nota: 'Pannello sotto l’header in vetro scuro, voci più grandi separate da linee, pulsante rosso.' } },
  ];
}
const { v } = Astro.params as { v: 'a' | 'b' };
const { nome, nota } = Astro.props;
---

<BaseLayout title={`Menu ${v.toUpperCase()} — Lab`} description="Prova interna del menu mobile." noindex menu={v}>
  <aside class="lab-bar" aria-label="Prova del menu">
    <strong>{nome}</strong> — {nota} Apri il menu (☰) in alto a destra.
    <a href={`/lab/menu/${v === 'a' ? 'b' : 'a'}`}>Vai a {v === 'a' ? 'B' : 'A'}</a>
  </aside>
  <HomePage />
</BaseLayout>

<style>
  .lab-bar {
    position: fixed;
    z-index: 40;
    left: var(--space-4);
    right: var(--space-4);
    bottom: var(--space-4);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-lg);
    background-color: var(--color-white);
    color: var(--color-fg);
    font-family: var(--font-sans);
    font-size: var(--font-size-sm);
    box-shadow: 0 8px 24px rgba(7, 17, 8, 0.2);
  }
  .lab-bar a {
    display: inline-block;
    margin-left: var(--space-2);
    color: var(--color-accent-text);
    font-weight: 700;
  }
</style>
