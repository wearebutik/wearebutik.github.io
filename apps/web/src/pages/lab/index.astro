---
// LAB — indice interno delle pagine di servizio non raggiungibili dal menu.
// I confronti fra varianti che vivevano qui sono chiusi: le direzioni scelte
// sono in produzione, il catalogo dei componenti è Storybook (ADR-0008).
import BaseLayout from '#layouts/BaseLayout.astro';

interface LabLink {
  href: string;
  title: string;
  desc: string;
}
interface LabGroup {
  eyebrow: string;
  titolo: string;
  intro: string;
  links: LabLink[];
}

const gruppi: LabGroup[] = [
  {
    eyebrow: 'Design system',
    titolo: 'Workshop dei componenti',
    intro:
      'Il workshop del catalogo è Storybook, con i componenti di @butik/ui come island React (ADR-0008) — atomi, molecole, organismi e gli accenti di motion, ciascuno con varianti e stati. Qui resta l’anteprima in-site del Button e la nota storica del confronto gallery-vs-Storybook.',
    links: [
      { href: '/lab/workshop', title: 'Component workshop (anteprima in-site)', desc: 'Button (Primary · Ghost) reso a HTML statico, su token @butik/ui-tokens.' },
      { href: '/lab/workshop/readme', title: 'Nota storica: gallery vs Storybook', desc: 'Trade-off delle due strade e la decisione presa (Storybook + island React, ADR-0008).' },
    ],
  },
  {
    eyebrow: 'Condivisione & social',
    titolo: 'Card Open Graph',
    intro:
      'Le card che appaiono condividendo i link (WhatsApp, LinkedIn, ecc.) sono generate in automatico per ogni pagina alla build. Questa pagina serve a controllarle.',
    links: [
      { href: '/lab/og-card', title: 'Card generate — verifica', desc: 'Elenco rotta → PNG generata, con le scorciatoie per opengraph.xyz e LinkedIn Post Inspector.' },
    ],
  },
  {
    eyebrow: 'Pagine di contenuto',
    titolo: 'Pagine da rivedere',
    intro: 'Pagine reali del sito utili da rivedere col team, raccolte qui per comodità.',
    links: [
      { href: '/partners', title: 'Elenco partner', desc: 'Lista logo + nome di istituzioni ed enti con cui Butik ha collaborato.' },
    ],
  },
];
---

<BaseLayout title="Lab — Butik" description="Indice interno dei prototipi e delle varianti in valutazione.">
  <section class="max-w-5xl mx-auto px-6 pt-24 pb-10">
    <p class="font-display text-xs font-bold tracking-widest uppercase text-butik-red-ink mb-3">Interno · non indicizzato dal menu</p>
    <h1 class="font-heading text-4xl md:text-5xl font-bold text-butik-dark mb-4">Lab — pagine di servizio</h1>
    <p class="font-sans text-base md:text-lg text-butik-body max-w-2xl leading-relaxed">
      Quel che resta non raggiungibile dal menu: il workshop dei componenti, la verifica delle card
      social e le pagine comode da rivedere col team. I confronti fra varianti sono chiusi — le
      direzioni scelte sono nelle pagine reali.
    </p>
  </section>

  {gruppi.map((g) => (
    <section class="max-w-5xl mx-auto px-6 py-8 border-t border-butik-dark/10">
      <p class="font-display text-xs font-bold tracking-widest uppercase text-butik-red-ink mb-2">{g.eyebrow}</p>
      <h2 class="font-heading text-2xl md:text-3xl font-bold text-butik-dark mb-2">{g.titolo}</h2>
      <p class="font-sans text-sm text-butik-dark/60 max-w-2xl leading-relaxed mb-6">{g.intro}</p>
      <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {g.links.map((l) => (
          <li>
            <a href={l.href} class="group block border border-butik-dark/15 bg-white p-5 hover:border-butik-red transition-colors">
              <span class="block font-heading text-base font-bold text-butik-dark group-hover:text-butik-red-ink transition-colors">
                {l.title}
              </span>
              <span class="block font-sans text-sm text-butik-dark/60 mt-1 leading-relaxed">{l.desc}</span>
              <span class="block font-display text-xs font-bold tracking-widest uppercase text-butik-red-ink mt-3">{l.href}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</BaseLayout>
