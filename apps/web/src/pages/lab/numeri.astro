---
// LAB — prova usa e getta: la sezione numeri della home. Tre direzioni con i
// dati veri (pagina home su Sanity). Dopo la scelta la vincente va in
// components/home/Numbers.astro e questa pagina si cancella.
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '#layouts/BaseLayout.astro';
import CountUp from '@butik/ui/CountUp';
import Underline from '@butik/ui/Underline';
import { imageSize } from '#lib/media';

const home = await getEntry('pagine', 'home');
const h = home?.data.type === 'home' ? home.data : undefined;
const butik = h?.butikMetrics ?? [];
const mmw = h?.mmwMetrics ?? [];
const mmwLabel = h?.mmwLabel ?? 'Milano Music Week';
// Il dato forte della MMW (persone raggiunte) e le edizioni, per la card.
const mmwPersone = mmw.find((m) => /K/i.test(m.value)) ?? mmw.at(-1);
const mmwEdizioni = mmw.find((m) => m !== mmwPersone);

const progettoMmw = await getEntry('progetti', 'milano-music-week');
const foto = progettoMmw?.data.heroImage;

// "30+" → { value: 30, suffix: '+' }; "70K+" → { value: 70, suffix: 'K+' }.
const conta = (v: string) => {
  const m = v.match(/^(\d+)(.*)$/);
  return m ? { value: Number(m[1]), suffix: m[2] } : undefined;
};
---

<BaseLayout title="Numeri — Lab" description="Prova interna sulla sezione numeri della home." noindex>
  <section class="intro">
    <p class="eyebrow">Lab · prova usa e getta</p>
    <h1 class="h1">Sezione numeri: tre direzioni</h1>
    <p class="lead">Stessi dati della home. Scorri: in 1 i numeri contano da zero quando entrano in vista (con reduced-motion compaiono subito).</p>
  </section>

  <!-- ── 1 · Una riga sola ─────────────────────────────────────────── -->
  <p class="etichetta"><strong>1 · Una riga sola</strong> — i cinque numeri di butik più la Milano Music Week come sesto, evidenziato. Niente “2 edizioni”, niente linea. Fascia più bassa, conteggio all’ingresso.</p>
  <section class="v1">
    <dl class="v1__grid">
      {butik.map((m) => {
        const c = conta(m.value);
        return (
          <div class="v1__item">
            <dt class="v1__label">{m.label}</dt>
            <dd class="v1__value">{c ? <CountUp client:visible value={c.value} suffix={c.suffix} /> : m.value}</dd>
          </div>
        );
      })}
      {mmwPersone && (
        <div class="v1__item v1__item--mmw">
          <dt class="v1__label">{mmwPersone.label} alla {mmwLabel}</dt>
          <dd class="v1__value">{(() => { const c = conta(mmwPersone.value); return c ? <CountUp client:visible value={c.value} suffix={c.suffix} /> : mmwPersone.value; })()}</dd>
        </div>
      )}
    </dl>
  </section>

  <!-- ── 2 · Foto + vetro ──────────────────────────────────────────── -->
  <p class="etichetta"><strong>2 · Numeri sopra una foto</strong> — foto della Milano Music Week con il velo dell’hero, numeri di butik in card di vetro, la MMW in una card più grande con link al progetto.</p>
  <section class="v2">
    {foto && <Image src={foto} {...imageSize(foto)} alt="" widths={[1280, 1920, 2560]} sizes="100vw" class="v2__bg" />}
    <div class="v2__velo" aria-hidden="true"></div>
    <div class="v2__inner">
      <dl class="v2__grid">
        {butik.map((m) => (
          <div class="v2__card">
            <dt class="v2__label">{m.label}</dt>
            <dd class="v2__value">{m.value}</dd>
          </div>
        ))}
      </dl>
      {mmwPersone && (
        <a href="/progetti/milano-music-week" class="v2__mmw">
          <span class="v2__mmw-eyebrow">{mmwLabel}</span>
          <span class="v2__mmw-value">{mmwPersone.value}</span>
          <span class="v2__mmw-label">{mmwPersone.label}{mmwEdizioni && ` in ${mmwEdizioni.value} ${mmwEdizioni.label}`}</span>
          <span class="v2__go" aria-hidden="true"><svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 8h11M9 4l4 4-4 4" /></svg></span>
        </a>
      )}
    </div>
  </section>

  <!-- ── 3 · Fondo chiaro ──────────────────────────────────────────── -->
  <p class="etichetta"><strong>3 · Fondo chiaro</strong> — prosegue il rosa dei loghi: numeri grandi scuri con la sottolineatura rossa, la MMW come unica card scura.</p>
  <section class="v3">
    <div class="v3__inner">
      <dl class="v3__grid">
        {butik.map((m) => (
          <div class="v3__item">
            <dt class="v3__label">{m.label}</dt>
            <dd class="v3__value"><Underline client:visible>{m.value}</Underline></dd>
          </div>
        ))}
      </dl>
      {mmwPersone && (
        <a href="/progetti/milano-music-week" class="v3__mmw">
          <span class="v3__mmw-eyebrow">{mmwLabel}</span>
          <span class="v3__mmw-value">{mmwPersone.value}</span>
          <span class="v3__mmw-label">{mmwPersone.label}{mmwEdizioni && ` in ${mmwEdizioni.value} ${mmwEdizioni.label}`}</span>
        </a>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .intro {
    max-width: 72rem; /* larghezza contenitore del lab */
    margin-inline: auto;
    padding: var(--space-24) var(--space-6) var(--space-8);
  }
  .eyebrow {
    font-family: var(--font-display);
    font-size: var(--font-size-xs);
    font-weight: 700;
    letter-spacing: 0.1em; /* come l'eyebrow di lab/index */
    text-transform: uppercase;
    color: var(--color-accent-text);
    margin-bottom: var(--space-3);
  }
  .h1 {
    font-family: var(--font-heading);
    font-size: var(--text-4xl);
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: var(--space-4);
  }
  .lead,
  .etichetta {
    font-family: var(--font-sans);
    font-size: var(--font-size-base);
    line-height: 1.6;
  }
  .etichetta {
    max-width: 72rem; /* larghezza contenitore del lab */
    margin: var(--space-12) auto var(--space-4);
    padding-inline: var(--space-6);
    font-size: var(--font-size-sm);
  }

  /* Numeri: stessa grammatica di Numbers.astro (display, verde evidenza). */
  .v1__value,
  .v2__value,
  .v2__mmw-value {
    font-family: var(--font-display);
    font-weight: 700;
    line-height: 1;
    color: var(--color-highlight);
  }

  /* ── 1 ───────────────────────────────────────────────────────────── */
  .v1 {
    background-color: var(--color-fg);
    padding: var(--space-12) var(--space-6);
  }
  .v1__grid {
    max-width: 80rem; /* come l'hero */
    margin-inline: auto;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-8) var(--space-6);
  }
  @media (min-width: 1024px) {
    .v1__grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
  }
  .v1__item {
    display: flex;
    flex-direction: column-reverse;
    gap: var(--space-2);
  }
  .v1__item--mmw {
    padding-left: var(--space-6);
    border-left: 2px solid var(--color-accent);
  }
  .v1__value {
    font-size: var(--text-5xl);
  }
  .v1__label {
    font-family: var(--font-sans);
    font-size: var(--font-size-sm);
    line-height: 1.4;
    color: color-mix(in srgb, var(--color-white) 80%, transparent);
  }

  /* ── 2 ───────────────────────────────────────────────────────────── */
  .v2 {
    position: relative;
    overflow: hidden;
    background-color: var(--color-fg);
  }
  .v2__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .v2__velo {
    position: absolute;
    inset: 0;
    background-color: color-mix(in srgb, var(--color-fg) 60%, transparent);
  }
  .v2__inner {
    position: relative;
    max-width: 80rem; /* come l'hero */
    margin-inline: auto;
    padding: var(--space-16) var(--space-6);
    display: grid;
    gap: var(--space-4);
  }
  @media (min-width: 1024px) {
    .v2__inner {
      grid-template-columns: 2fr 1fr;
      align-items: stretch;
    }
  }
  .v2__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }
  @media (min-width: 768px) {
    .v2__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .v2__card,
  .v2__mmw {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: var(--space-2);
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    border: 1px solid color-mix(in srgb, var(--color-white) 25%, transparent);
    background-color: color-mix(in srgb, var(--color-fg) 35%, transparent);
    backdrop-filter: blur(12px); /* come le card dei servizi */
    -webkit-backdrop-filter: blur(12px);
  }
  .v2__value {
    font-size: var(--text-4xl);
  }
  .v2__label {
    font-family: var(--font-sans);
    font-size: var(--font-size-sm);
    line-height: 1.4;
    color: color-mix(in srgb, var(--color-white) 85%, transparent);
  }
  .v2__mmw {
    flex-direction: column;
    justify-content: flex-end;
    color: var(--color-white);
    text-decoration: none;
    transition: background-color var(--duration-fast) ease, border-color var(--duration-fast) ease;
  }
  .v2__mmw:hover,
  .v2__mmw:focus-visible {
    background-color: color-mix(in srgb, var(--color-fg) 55%, transparent);
    border-color: var(--color-white);
  }
  .v2__mmw:focus-visible {
    outline: 2px solid var(--color-white);
    outline-offset: 3px;
  }
  .v2__mmw-eyebrow {
    font-family: var(--font-display);
    font-size: var(--font-size-xs);
    font-weight: 700;
    letter-spacing: 0.1em; /* come le etichette del sito */
    text-transform: uppercase;
    color: var(--color-highlight);
  }
  .v2__mmw-value {
    font-size: var(--text-6xl);
  }
  .v2__mmw-label {
    font-family: var(--font-sans);
    font-size: var(--font-size-base);
    color: color-mix(in srgb, var(--color-white) 90%, transparent);
  }
  .v2__go {
    margin-top: var(--space-3);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-full);
    border: 2px solid var(--color-white);
    transition: background-color var(--duration-fast) ease, border-color var(--duration-fast) ease;
  }
  .v2__mmw:hover .v2__go,
  .v2__mmw:focus-visible .v2__go {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
  }

  /* ── 3 ───────────────────────────────────────────────────────────── */
  .v3 {
    background-color: var(--color-bg, var(--color-white));
    padding: var(--space-16) var(--space-6);
  }
  .v3__inner {
    max-width: 80rem; /* come l'hero */
    margin-inline: auto;
    display: grid;
    gap: var(--space-8);
  }
  @media (min-width: 1024px) {
    .v3__inner {
      grid-template-columns: 2fr 1fr;
      align-items: center;
    }
  }
  .v3__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-8) var(--space-6);
  }
  @media (min-width: 768px) {
    .v3__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .v3__item {
    display: flex;
    flex-direction: column-reverse;
    gap: var(--space-3);
  }
  .v3__value {
    font-family: var(--font-display);
    font-size: var(--text-5xl);
    font-weight: 700;
    line-height: 1;
    color: var(--color-fg);
  }
  .v3__label {
    font-family: var(--font-sans);
    font-size: var(--font-size-sm);
    line-height: 1.4;
    color: color-mix(in srgb, var(--color-fg) 75%, transparent);
  }
  .v3__mmw {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-8);
    border-radius: var(--radius-lg);
    background-color: var(--color-fg);
    color: var(--color-white);
    text-decoration: none;
  }
  .v3__mmw:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }
  .v3__mmw-eyebrow {
    font-family: var(--font-display);
    font-size: var(--font-size-xs);
    font-weight: 700;
    letter-spacing: 0.1em; /* come le etichette del sito */
    text-transform: uppercase;
    color: var(--color-highlight);
  }
  .v3__mmw-value {
    font-family: var(--font-display);
    font-size: var(--text-6xl);
    font-weight: 700;
    line-height: 1;
    color: var(--color-highlight);
  }
  .v3__mmw-label {
    font-family: var(--font-sans);
    font-size: var(--font-size-base);
    color: color-mix(in srgb, var(--color-white) 90%, transparent);
  }
</style>
