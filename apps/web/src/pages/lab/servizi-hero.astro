---
// LAB — prova usa e getta: come presentare i cinque servizi nell'hero della
// home in modo che si capisca che sono cliccabili, senza coprire le foto di
// sfondo. Tre direzioni, ciascuna in un hero completo (foto, velo, titolo).
// Dopo la scelta la vincente va in Hero/ServiceCard e questa pagina si cancella.
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '#layouts/BaseLayout.astro';
import Button from '@butik/ui/Button';
import Underline from '@butik/ui/Underline';
import { imageSize } from '#lib/media';

const home = await getEntry('pagine', 'home');
const h = home?.data.type === 'home' ? home.data : undefined;
const sfondi = h?.heroImages ?? [];
const titolo = h?.heroTitle ?? '';
const cut = titolo.lastIndexOf(' ');
const [testa, ultima] = [titolo.slice(0, cut + 1), titolo.slice(cut + 1)];

const servizi = (await getCollection('servizi', (e) => !e.data.draft))
  .sort((a, b) => a.data.order - b.data.order)
  .map((s) => ({
    href: `/servizi/${s.id}`,
    title: s.data.card.title,
    desc: s.data.card.desc,
    stat: `${s.data.card.statValue} ${s.data.card.statLabel}`,
    foto: s.data.heroImage,
  }));

const direzioni = [
  { id: 'b', nome: 'B · Senza box', nota: 'I servizi stanno sulla foto, divisi da linee sottili. Titolo bianco che si sottolinea all’hover, “Scopri” in basso. La foto resta visibile per intero.', sfondo: 1 },
  { id: 'c', nome: 'C · Vetro', nota: 'Rettangoli arrotondati semitrasparenti (la foto si intravede sfocata), link “Scopri il servizio” in fondo. Più vicina a oggi, ma leggera.', sfondo: 2 },
  { id: 'a', nome: 'A · Vetro con foto del servizio', nota: 'Come C, con una miniatura tonda della foto del servizio: il segnale più forte che si tratta di una porta d’ingresso.', sfondo: 3 },
];
---

<BaseLayout title="Servizi nell’hero — Lab" description="Prova interna sulla presentazione dei servizi nell’hero." noindex>
  <section class="intro">
    <p class="eyebrow">Lab · prova usa e getta</p>
    <h1 class="h1">Servizi nell’hero: tre direzioni</h1>
    <p class="lead">
      Stesso hero (foto, velo al 60%, titolo, pulsante), cambia solo come si presentano i cinque servizi.
      L’obiettivo: che si capisca che sono cliccabili senza coprire le foto. Passa il mouse sui servizi
      e prova la navigazione da tastiera (Tab).
    </p>
  </section>

  {direzioni.map((d) => {
    const bg = sfondi[d.sfondo] ?? sfondi[0];
    return (
      <section class="hero" aria-labelledby={`d-${d.id}`}>
        {bg && <Image src={bg.src} {...imageSize(bg.src)} alt="" widths={[1280, 1920, 2560]} sizes="100vw" class="hero__bg" />}
        <div class="hero__velo" aria-hidden="true"></div>
        <div class="hero__gradiente" aria-hidden="true"></div>

        <p id={`d-${d.id}`} class="etichetta"><strong>{d.nome}</strong> — {d.nota}</p>

        <div class="hero__lead">
          <p class="hero__title">{testa}<Underline trigger="load">{ultima}</Underline></p>
          <p class="hero__sub">{h?.heroSubtitle}</p>
          <div class="hero__cta"><Button href={h?.heroCtaHref ?? '/contatti'}>{h?.heroCtaLabel}</Button></div>
        </div>

        <div class="hero__svc">
          {d.id === 'b' && (
            <ul class="b-list">
              {servizi.map((s) => (
                <li>
                  <a href={s.href} class="b-item">
                    <span class="b-title">{s.title}</span>
                    <span class="b-desc">{s.desc}</span>
                    <span class="b-go">Scopri</span>
                  </a>
                </li>
              ))}
            </ul>
          )}

          {(d.id === 'c' || d.id === 'a') && (
            <ul class="c-list">
              {servizi.map((s) => (
                <li>
                  <a href={s.href} class:list={['c-item', { 'c-item--foto': d.id === 'a' }]}>
                    {d.id === 'a' && (
                      <Image src={s.foto} {...imageSize(s.foto)} alt="" widths={[160]} sizes="80px" class="c-foto" />
                    )}
                    <span class="c-title">{s.title}</span>
                    <span class="c-desc">{s.desc}</span>
                    <span class="c-go">Scopri il servizio</span>
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>
      </section>
    );
  })}
</BaseLayout>

<style>
  .intro {
    max-width: 72rem; /* larghezza contenitore del lab */
    margin-inline: auto;
    padding: var(--space-24) var(--space-6) var(--space-8);
  }
  .eyebrow {
    font-family: var(--font-display);
    font-size: var(--font-size-xs);
    font-weight: 700;
    letter-spacing: 0.1em; /* come l'eyebrow di lab/index */
    text-transform: uppercase;
    color: var(--color-accent-text);
    margin-bottom: var(--space-3);
  }
  .h1 {
    font-family: var(--font-heading);
    font-size: var(--text-4xl);
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: var(--space-4);
  }
  .lead {
    font-family: var(--font-sans);
    font-size: var(--font-size-base);
    line-height: 1.6;
    max-width: 48rem; /* misura di lettura */
  }

  /* ── Hero: replica di components/home/Hero.astro ─────────────────────── */
  .hero {
    position: relative;
    overflow: hidden;
    min-height: 82vh; /* come l'hero */
    display: flex;
    flex-direction: column;
    background-color: var(--color-fg);
    margin-bottom: var(--space-2);
  }
  .hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero__velo {
    position: absolute;
    inset: 0;
    background-color: color-mix(in srgb, var(--color-fg) 60%, transparent);
  }
  .hero__gradiente {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--color-fg) 30%, transparent),
      transparent,
      color-mix(in srgb, var(--color-fg) 60%, transparent)
    );
  }
  .etichetta {
    position: relative;
    margin: 0;
    padding: var(--space-3) var(--space-8);
    background-color: var(--color-white);
    color: var(--color-fg);
    font-family: var(--font-sans);
    font-size: var(--font-size-sm);
  }
  .hero__lead {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    text-align: center;
    max-width: 56rem; /* come l'hero */
    margin-inline: auto;
    padding: var(--space-12) var(--space-6) var(--space-6);
  }
  .hero__title {
    font-family: var(--font-heading);
    font-size: var(--text-5xl);
    font-weight: 700;
    line-height: 1.05;
    color: var(--color-white);
    text-shadow: 0 2px 20px rgba(7, 17, 8, 0.6); /* come l'hero */
  }
  .hero__sub {
    margin-top: 1.25rem; /* come l'hero */
    font-family: var(--font-sans);
    font-size: var(--font-size-lg);
    color: var(--color-white);
    text-shadow: 0 2px 20px rgba(7, 17, 8, 0.6); /* come l'hero */
  }
  .hero__cta {
    margin-top: var(--space-8);
  }
  .hero__svc {
    position: relative;
    width: 100%;
    max-width: 80rem; /* come l'hero */
    margin-inline: auto;
    padding: 0 var(--space-8) var(--space-8);
  }

  /* ── B · Senza box ───────────────────────────────────────────────────── */
  .b-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid color-mix(in srgb, var(--color-white) 30%, transparent);
  }
  @media (min-width: 1024px) {
    .b-list {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }
  .b-list li + li {
    border-left: 1px solid color-mix(in srgb, var(--color-white) 30%, transparent);
  }
  .b-item {
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-6) var(--space-5, 1.25rem);
    text-decoration: none;
    color: var(--color-white);
    transition: background-color var(--duration-fast) ease;
  }
  .b-item:hover,
  .b-item:focus-visible {
    background-color: color-mix(in srgb, var(--color-white) 8%, transparent);
  }
  .b-item:focus-visible {
    outline: 2px solid var(--color-white);
    outline-offset: -2px;
  }
  .b-title {
    font-family: var(--font-heading);
    font-size: var(--font-size-xl);
    font-weight: 700;
    line-height: 1.15;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
    transition: text-decoration-color var(--duration-fast) ease;
  }
  .b-item:hover .b-title,
  .b-item:focus-visible .b-title {
    text-decoration-color: var(--color-accent);
  }
  .b-desc {
    flex: 1;
    font-family: var(--font-sans);
    font-size: var(--font-size-sm);
    line-height: 1.45;
    color: color-mix(in srgb, var(--color-white) 85%, transparent);
  }
  .b-go {
    font-family: var(--font-display);
    font-size: var(--font-size-xs);
    font-weight: 700;
    letter-spacing: 0.1em; /* come le etichette del sito */
    text-transform: uppercase;
    color: var(--color-white);
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.35em;
  }

  /* ── C / A · Vetro ───────────────────────────────────────────────────── */
  .c-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }
  @media (min-width: 1024px) {
    .c-list {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }
  .c-item {
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5, 1.25rem);
    border-radius: var(--radius-lg);
    border: 1px solid color-mix(in srgb, var(--color-white) 25%, transparent);
    background-color: color-mix(in srgb, var(--color-fg) 35%, transparent);
    backdrop-filter: blur(12px); /* nessun token blur */
    -webkit-backdrop-filter: blur(12px);
    color: var(--color-white);
    text-decoration: none;
    transition: background-color var(--duration-fast) ease, border-color var(--duration-fast) ease, transform var(--duration-fast) ease;
  }
  .c-item:hover,
  .c-item:focus-visible {
    background-color: color-mix(in srgb, var(--color-fg) 55%, transparent);
    border-color: var(--color-white);
    transform: translateY(-3px);
  }
  .c-item:focus-visible {
    outline: 2px solid var(--color-white);
    outline-offset: 3px;
  }
  @media (prefers-reduced-motion: reduce) {
    .c-item:hover,
    .c-item:focus-visible {
      transform: none;
    }
  }
  .c-foto {
    width: 3.5rem;
    height: 3.5rem;
    border-radius: var(--radius-full);
    object-fit: cover;
    border: 2px solid var(--color-white);
    margin-bottom: var(--space-1);
  }
  .c-title {
    font-family: var(--font-heading);
    font-size: var(--font-size-xl);
    font-weight: 700;
    line-height: 1.15;
  }
  .c-desc {
    flex: 1;
    font-family: var(--font-sans);
    font-size: var(--font-size-sm);
    line-height: 1.45;
    color: color-mix(in srgb, var(--color-white) 88%, transparent);
  }
  .c-go {
    align-self: flex-start;
    font-family: var(--font-display);
    font-size: var(--font-size-xs);
    font-weight: 700;
    letter-spacing: 0.1em; /* come le etichette del sito */
    text-transform: uppercase;
    padding-bottom: 0.2em;
    border-bottom: 2px solid var(--color-accent);
  }
</style>
