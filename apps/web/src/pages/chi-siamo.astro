---
import { getEntry } from 'astro:content';
import BaseLayout from '#layouts/BaseLayout.astro';
import HeroBanner from '#components/HeroBanner.astro';
import CtaBanner from '#components/CtaBanner.astro';
import Testimonials from '#components/home/Testimonials.astro';
import { Image } from 'astro:assets';

import heroImg from '#assets/hero-home.jpg';
import Eyebrow from '@butik/ui/Eyebrow';

// Copy editoriale content-driven via collezione `pagine` (ADR-0004): il testo è
// editabile da Sitepins, la presentazione resta qui. Alcuni paragrafi contengono
// <strong>/link inline e vengono resi con `set:html` per output identico.
const entry = await getEntry('pagine', 'chi-siamo');
if (!entry || entry.data.type !== 'chi-siamo') {
  throw new Error('Contenuto pagina "chi-siamo" mancante o non valido (collezione pagine).');
}
const c = entry.data;

// Testimonianze: entry condivisa `pagine/testimonials`, riusata identica da
// index.astro (issue #26 — prima duplicata inline nel componente).
const testimonialsEntry = await getEntry('pagine', 'testimonials');
if (!testimonialsEntry || testimonialsEntry.data.type !== 'testimonials') {
  throw new Error('Contenuto pagina "testimonials" mancante o non valido (collezione pagine).');
}
const testimonials = testimonialsEntry.data;

// Founder come ARRAY dalla collezione: nome/ruolo/bio/email/linkedin + foto
// (media risolto a build-time da `image()`).
const founders = c.founders;

// Obiettivi di Sviluppo Sostenibile (Agenda ONU 2030): num + titolo sono copy
// editoriale (array in collezione); colore/icona restano config di design qui —
// i colori sono quelli ufficiali SDG (tutti e 17), mappati per numero obiettivo.
// Fallback neutro per qualsiasi num fuori range 1-17 (refuso in Sitepins):
// niente stile mancante silenzioso (issue #26 — W4).
const sdgStyle: Record<number, { color: string; icon: string }> = {
  1: { color: '#E5243B', icon: '🚫' },
  2: { color: '#DDA63A', icon: '🌾' },
  3: { color: '#4C9F38', icon: '🩺' },
  4: { color: '#C5192D', icon: '📚' },
  5: { color: '#FF3A21', icon: '♀️' },
  6: { color: '#26BDE2', icon: '💧' },
  7: { color: '#FCC30B', icon: '⚡' },
  8: { color: '#A21942', icon: '🎯' },
  9: { color: '#FD6925', icon: '🏗️' },
  10: { color: '#DD1367', icon: '⚖️' },
  11: { color: '#FD9D24', icon: '🏙️' },
  12: { color: '#BF8B2E', icon: '♻️' },
  13: { color: '#3F7E44', icon: '🌍' },
  14: { color: '#0A97D9', icon: '🐟' },
  15: { color: '#56C02B', icon: '🌳' },
  16: { color: '#00689D', icon: '🕊️' },
  17: { color: '#19486A', icon: '🤝' },
};
const sdgFallbackStyle = { color: '#6B7280', icon: '🌐' };
const sdg = c.sdg.map((o) => ({ ...o, ...(sdgStyle[o.num] ?? sdgFallbackStyle) }));
---

<BaseLayout
  title={c.metaTitle}
  description={c.metaDescription}
>
  <HeroBanner
    title={c.heroTitle}
    subtitle={c.heroSubtitle}
    image={heroImg}
    imageAlt={c.heroImageAlt}
  />

  <!-- Chi siamo -->
  <section class="max-w-3xl mx-auto px-6 py-16 md:py-20">
    <Eyebrow align="left">{c.introEyebrow}</Eyebrow>
    <div class="space-y-5 font-sans text-base md:text-lg text-butik-body leading-relaxed">
      <p set:html={c.introP1}></p>
      <p set:html={c.introP2}></p>
      <p set:html={c.introP3}></p>
      <p set:html={c.introP4}></p>
    </div>
  </section>

  <!-- La nostra missione + SDG -->
  <section class="bg-white py-16 md:py-20">
    <div class="max-w-5xl mx-auto px-6">
      <div class="max-w-3xl">
        <Eyebrow align="left">{c.missionEyebrow}</Eyebrow>
        <p class="font-heading text-2xl md:text-3xl font-bold text-butik-dark leading-snug">
          {c.missionStatement}
        </p>
      </div>

      <div class="mt-12 md:mt-16">
        <Eyebrow align="left">{c.sdgEyebrow}</Eyebrow>
        <p class="font-sans text-base text-butik-body leading-relaxed max-w-3xl">
          {c.sdgIntro}
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 mt-8">
          {sdg.map((o) => (
            <div class="flex items-center gap-5 border border-butik-dark/15 bg-butik-light/50 p-5 md:p-6">
              <span
                class="flex h-16 w-16 flex-shrink-0 flex-col items-center justify-center text-white"
                style={`background-color: ${o.color}`}
                aria-hidden="true"
              >
                <span class="text-xl leading-none">{o.icon}</span>
                <span class="font-display text-lg font-bold leading-none mt-1">{o.num}</span>
              </span>
              <div>
                <p class="font-display text-xs font-bold tracking-widest uppercase text-butik-red-ink">
                  {c.sdgObiettivoLabel} {o.num}
                </p>
                <p class="font-heading text-base md:text-lg font-bold text-butik-dark leading-snug mt-1">
                  {o.title}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Il nostro team -->
  <section class="max-w-6xl mx-auto px-6 py-16 md:py-20">
    <div class="max-w-3xl">
      <Eyebrow align="left">{c.teamEyebrow}</Eyebrow>
      <div class="space-y-5 font-sans text-base md:text-lg text-butik-body leading-relaxed">
        <p set:html={c.teamP1}></p>
        <p set:html={c.teamP2}></p>
        <p set:html={c.teamP3}></p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-10 mt-12 md:mt-16">
      {founders.map((f) => (
        <article class="flex flex-col">
          <div class="overflow-hidden mb-5 aspect-[4/5] bg-butik-light">
            {f.photo && (
              <Image
                src={f.photo}
                alt={`Ritratto di ${f.name}`}
                widths={[300, 500]}
                sizes="(max-width: 768px) 100vw, 33vw"
                quality={72}
                class="w-full h-full object-cover"
              />
            )}
          </div>
          <h2 class="font-heading text-xl font-bold text-butik-dark leading-tight">{f.name}</h2>
          <p class="font-display text-xs font-bold tracking-widest uppercase text-butik-red-ink mt-1">{f.role}</p>
          <p class="font-sans text-sm text-butik-body leading-relaxed mt-4 flex-1">{f.bio}</p>
          <div class="flex items-center gap-4 mt-5">
            <a
              href={f.linkedin}
              class="inline-flex items-center gap-2 font-display text-xs font-bold tracking-widest uppercase text-butik-dark hover:text-butik-red-ink transition-colors"
              aria-label={`Profilo LinkedIn di ${f.name}`}
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
              </svg>
              {c.linkedinLabel}
            </a>
            <a
              href={`mailto:${f.email}`}
              class="font-sans text-sm text-butik-dark/70 underline hover:text-butik-red-ink transition-colors break-all"
            >
              {f.email}
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Testimonianza in evidenza (Cult Funding) -->
  <section class="bg-butik-dark text-white py-16 md:py-20">
    <figure class="max-w-3xl mx-auto px-6 text-center">
      <svg class="w-10 h-10 mx-auto text-butik-red mb-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M9.983 3v7.391c0 5.704-3.731 9.57-8.983 10.609l-.995-2.151c2.432-.917 3.995-3.638 3.995-5.849h-4v-10h9.983zm14.017 0v7.391c0 5.704-3.748 9.571-9 10.609l-.996-2.151c2.433-.917 3.996-3.638 3.996-5.849h-3.983v-10h9.983z" />
      </svg>
      <blockquote class="font-heading text-xl md:text-2xl font-bold leading-snug">
        {c.testimonialQuote}
      </blockquote>
      <figcaption class="font-sans text-sm text-white/70 mt-6">
        {c.testimonialAuthor}
      </figcaption>
    </figure>
  </section>

  <!-- Testimonianze -->
  <Testimonials
    eyebrow={testimonials.eyebrow}
    sectionTitle={testimonials.sectionTitle}
    testimonials={testimonials.testimonials}
  />

  <!-- CTA finale -->
  <CtaBanner
    title={c.ctaTitle}
    body={c.ctaBody}
    primaryCta={{ label: c.ctaLabel, href: c.ctaHref }}
  />
</BaseLayout>
