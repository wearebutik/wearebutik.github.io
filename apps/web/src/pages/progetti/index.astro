---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import SectionHeading from '@butik/ui/SectionHeading';

const progetti = (await getCollection('progetti', e => !e.data.draft))
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Progetti — Butik"
  description="Esplora i progetti di Butik: dalla Milano Music Week al Festival del Turismo Musicale."
>
  <!-- Page header -->
  <div class="page-header">
    <SectionHeading as="h1" eyebrow="Portfolio" title="Progetti" />
  </div>

  <!-- Grid -->
  <section class="projects-section">
    <div class="projects-grid">
      {progetti.map((p, i) => (
        <a href={`/progetti/${p.id}`} class="project-card">
          <div class="project-card__media">
            <Image
              src={p.data.heroImage}
              alt={p.data.heroAlt}
              widths={[400, 700]}
              sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw"
              quality={72}
              loading={i < 3 ? 'eager' : 'lazy'}
              class="project-card__image"
              transition:name={`progetto-${p.id}`}
            />
          </div>
          <div class="project-card__meta">
            {p.data.category && (
              <span class="project-card__category">
                {p.data.category}
              </span>
            )}
            {p.data.year && (
              <span class="project-card__year">{p.data.year}</span>
            )}
          </div>
          <h2 class="project-card__title" transition:name={`progetto-${p.id}-title`}>
            {p.data.title}
          </h2>
          <p class="project-card__subtitle" transition:name={`progetto-${p.id}-subtitle`}>
            {p.data.subtitle}
          </p>
          {p.data.client && (
            <p class="project-card__client">
              Cliente: {p.data.client}
            </p>
          )}
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .page-header {
    padding-top: 5rem; /* pt-20, nessun token spacing a 5rem */
    padding-bottom: var(--space-12);
    text-align: center;
  }

  .projects-section {
    max-width: 80rem; /* max-w-7xl, nessun token */
    margin-inline: auto;
    padding-inline: var(--space-6);
    padding-bottom: var(--space-24);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: 2.5rem; /* gap-10, nessun token */
  }
  @media (min-width: 768px) {
    .projects-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .projects-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .project-card {
    display: block;
  }

  .project-card__media {
    overflow: hidden;
    margin-bottom: 1.25rem; /* mb-5, nessun token */
  }

  .project-card__image {
    width: 100%;
    height: 16rem; /* h-64, nessun token */
    object-fit: cover;
    transition-property: transform, translate, scale, rotate;
    transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    transition-duration: 500ms; /* duration-500, nessun token */
  }
  .project-card:hover .project-card__image {
    scale: 105% 105%;
  }

  .project-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
  }

  .project-card__category {
    font-family: var(--font-display);
    font-size: var(--font-size-xs);
    line-height: calc(1 / 0.75); /* line-height che text-xs porta con sé */
    font-weight: 700;
    letter-spacing: 0.1em; /* tracking-widest, nessun token */
    text-transform: uppercase;
    color: var(--color-butik-red-ink);
  }

  .project-card__year {
    font-family: var(--font-display);
    font-size: var(--font-size-xs);
    line-height: calc(1 / 0.75); /* line-height che text-xs porta con sé */
    color: var(--color-butik-body);
  }

  .project-card__title {
    font-family: var(--font-heading);
    font-size: 1.25rem; /* text-xl: --font-size-xl vale 1.5rem, non coincide */
    line-height: calc(1.75 / 1.25); /* line-height che text-xl porta con sé */
    font-weight: 700;
    color: var(--color-butik-dark);
    margin-bottom: var(--space-2);
    transition: color var(--duration-fast) cubic-bezier(0.4, 0, 0.2, 1);
  }
  .project-card:hover .project-card__title {
    color: var(--color-butik-red);
  }

  .project-card__subtitle {
    font-family: var(--font-sans);
    font-size: var(--font-size-sm);
    line-height: 1.625; /* leading-relaxed vince su text-sm */
    color: var(--color-butik-body);
  }

  .project-card__client {
    margin-top: var(--space-2);
    font-family: var(--font-display);
    font-size: var(--font-size-xs);
    line-height: calc(1 / 0.75); /* line-height che text-xs porta con sé */
    letter-spacing: 0.1em; /* tracking-widest, nessun token */
    text-transform: uppercase;
    color: var(--color-butik-body);
  }
</style>
