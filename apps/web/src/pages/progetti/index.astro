---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import SectionHeading from '@butik/ui/SectionHeading';

const progetti = (await getCollection('progetti', e => !e.data.draft))
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Progetti — Butik"
  description="Esplora i progetti di Butik: dalla Milano Music Week al Festival del Turismo Musicale."
>
  <!-- Page header -->
  <div class="pt-20 pb-12 text-center">
    <SectionHeading as="h1" eyebrow="Portfolio" title="Progetti" />
  </div>

  <!-- Grid -->
  <section class="max-w-7xl mx-auto px-6 pb-24">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
      {progetti.map((p, i) => (
        <a href={`/progetti/${p.id}`} class="group block">
          <div class="overflow-hidden mb-5">
            <Image
              src={p.data.heroImage}
              alt={p.data.heroAlt}
              widths={[400, 700]}
              sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw"
              quality={72}
              loading={i < 3 ? 'eager' : 'lazy'}
              class="w-full h-64 object-cover group-hover:scale-105 transition-transform duration-500"
              transition:name={`progetto-${p.id}`}
            />
          </div>
          <div class="flex flex-wrap items-center gap-3 mb-2">
            {p.data.category && (
              <span class="font-display text-xs font-bold tracking-widest uppercase text-butik-red-ink">
                {p.data.category}
              </span>
            )}
            {p.data.year && (
              <span class="font-display text-xs text-butik-body">{p.data.year}</span>
            )}
          </div>
          <h2 class="font-heading text-xl font-bold text-butik-dark mb-2 group-hover:text-butik-red transition-colors" transition:name={`progetto-${p.id}-title`}>
            {p.data.title}
          </h2>
          <p class="font-sans text-sm text-butik-body leading-relaxed" transition:name={`progetto-${p.id}-subtitle`}>
            {p.data.subtitle}
          </p>
          {p.data.client && (
            <p class="mt-2 font-display text-xs tracking-widest uppercase text-butik-body">
              Cliente: {p.data.client}
            </p>
          )}
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
