---
// Le sezioni della pagina su Sanity, nell'ordine scelto nello Studio
// (ADR-0004, *Pages as sections*).
import { getEntry } from 'astro:content';
import BaseLayout from '#layouts/BaseLayout.astro';
import Sezioni from '#components/sezioni/Sezioni.astro';
import DatiStrutturati from '#components/seo/DatiStrutturati.astro';

const entry = await getEntry('pagine', 'progetti');
if (!entry || entry.data.type !== 'progetti-index') {
  throw new Error('Contenuto pagina "progetti" mancante o non valido (collezione pagine).');
}
const c = entry.data;
---

<BaseLayout title={c.metaTitle} description={c.metaDescription}>
  <DatiStrutturati slot="head" briciole={[{ perMenu: '/progetti' }]} />
  <Sezioni sezioni={c.sezioni} />
</BaseLayout>
