---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import { PortableText } from 'astro-portabletext';
import ContentLayout from '../../layouts/ContentLayout.astro';
import { portableTextComponents } from '#components/portabletext/components';

export async function getStaticPaths() {
  const progetti = await getCollection('progetti', e => !e.data.draft);
  return progetti.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;

// L'immagine OG da Sanity passa dalla pipeline di Astro come le altre: il
// <meta og:image> punta a /_astro/, mai a cdn.sanity.io (#52). JPEG 1200×630,
// il formato che tutti gli scraper social leggono.
const ogImage = entry.data.ogImage
  ? (await getImage({
      src: `${entry.data.ogImage}?w=1200&h=630&fit=crop`,
      width: 1200,
      height: 630,
      format: 'jpg',
    })).src
  : undefined;
---

<ContentLayout
  title={entry.data.title}
  subtitle={entry.data.subtitle}
  heroImage={entry.data.heroImage}
  heroAlt={entry.data.heroAlt}
  heroLqip={entry.data.heroLqip}
  metaTitle={entry.data.metaTitle}
  metaDescription={entry.data.metaDescription}
  ogImage={ogImage}
  transitionName={`progetto-${entry.id}`}
  client={entry.data.client}
  year={entry.data.year}
  category={entry.data.category}
>
  <PortableText value={entry.data.body} components={portableTextComponents} />
</ContentLayout>

<span
  id="ph-project-data"
  hidden
  data-slug={entry.id}
  data-title={entry.data.title}
  data-category={entry.data.category ?? ''}
></span>

<script>
  import { trackEvent } from '#lib/analytics/posthog.client';

  document.addEventListener('astro:page-load', () => {
    const el = document.getElementById('ph-project-data');
    if (!el) return;
    trackEvent('project_viewed', {
      slug: el.dataset.slug,
      title: el.dataset.title,
      category: el.dataset.category || undefined,
    });
  });
</script>
