---
import BaseLayout from '#layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';
import HomePage from '#components/home/HomePage.astro';

const homeEntry = await getEntry('pagine', 'home');
if (!homeEntry || homeEntry.data.type !== 'home') {
  throw new Error('Contenuto pagina "home" mancante o non valido (collezione pagine).');
}
const c = homeEntry.data;
---

<BaseLayout title={c.metaTitle} description={c.metaDescription}>
  <HomePage />
</BaseLayout>
