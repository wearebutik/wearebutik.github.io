---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import { PortableText } from 'astro-portabletext';
import BaseLayout from '#layouts/BaseLayout.astro';
import ServiceHero from '#components/serviziHero/ServiceHero.astro';
import { servizioComponents } from '#components/portabletext/components';

export async function getStaticPaths() {
  const servizi = await getCollection('servizi', e => !e.data.draft);
  return servizi.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;

// Immagine OG da Sanity: passa dalla pipeline di Astro come le altre, mai
// da cdn.sanity.io (ADR-0004). JPEG 1200×630.
const ogImage = entry.data.ogImage
  ? (await getImage({ src: `${entry.data.ogImage}?w=1200&h=630&fit=crop`, width: 1200, height: 630, format: 'jpg' })).src
  : undefined;
---

<BaseLayout
  title={entry.data.metaTitle ?? `${entry.data.title} — Butik`}
  description={entry.data.metaDescription ?? entry.data.subtitle}
  ogImage={ogImage}
>
  <ServiceHero
    variant={entry.data.heroVariant}
    content={entry.data.hero}
    title={entry.data.title}
    subtitle={entry.data.subtitle}
    image={entry.data.heroImage}
    imageAlt={entry.data.heroAlt}
    transitionName={`servizio-${entry.id}`}
  />

  <article class="service-body">
    <div class="prose prose-full">
      <PortableText value={entry.data.body} components={servizioComponents} />
    </div>
  </article>
</BaseLayout>

<span
  id="ph-service-data"
  hidden
  data-slug={entry.id}
  data-title={entry.data.title}
></span>

<script>
  import { trackEvent } from '#lib/analytics/posthog.client';

  document.addEventListener('astro:page-load', () => {
    const el = document.getElementById('ph-service-data');
    if (!el) return;
    trackEvent('service_viewed', {
      slug: el.dataset.slug,
      title: el.dataset.title,
    });
  });
</script>

<style>
  .service-body {
    max-width: var(--measure-5xl);
    margin-inline: auto;
    padding-inline: var(--space-6);
    padding-block: var(--space-16);
  }
</style>
