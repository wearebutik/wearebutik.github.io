---
// /servizi — router per pubblico: si sceglie chi si è, e la griglia mostra solo
// i servizi che parlano a quel ruolo. Ogni servizio è un blocco espanso
// (per chi · cosa ottieni), non una card-teaser: la prova sintetica sta in home.
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '#layouts/BaseLayout.astro';
import ServiceExpanded from '#components/serviziCards/ServiceExpanded.astro';
import Metodo from '#components/home/Metodo.astro';
import type { MetodoIconName } from '#data/metodo';
import CtaBanner from '#components/CtaBanner.astro';

// Copy editoriale content-driven (ADR-0004): header, intro, etichette dei
// filtri, metodo e CTA finale dalla collezione `pagine` (entry `servizi`).
const entry = await getEntry('pagine', 'servizi');
if (!entry || entry.data.type !== 'servizi-index') {
  throw new Error('Contenuto pagina "servizi" mancante o non valido (collezione pagine).');
}
const c = entry.data;

// Il pubblico di ogni servizio è un campo della sua entry (`audience`): è la
// stessa informazione degli "Adatto a" nel corpo della scheda, in forma di id.
const servizi = (await getCollection('servizi', (e) => !e.data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

// Icone per tappa del metodo: config di design, non copy editoriale.
const metodoIcons: MetodoIconName[] = ['ascolto', 'co-progettazione', 'protagonismo', 'formazione', 'eventi'];
---

<BaseLayout title={c.metaTitle} description={c.metaDescription}>
  <section class="svc-intro">
    <p class="svc-eyebrow">{c.headerEyebrow}</p>
    <h1 class="svc-title">{c.headerTitle}</h1>
    <p class="svc-lead">
      {c.headerIntro1}
    </p>
    <p class="svc-lead" set:html={c.headerIntro2}></p>
  </section>

  <section class="svc-main">
    <div class="svc-filters" data-svc-filters role="group" aria-label="Filtra i servizi per pubblico">
      {c.filtri.map((f, i) => (
        <button
          type="button"
          class:list={['svc-filter', i === 0 && 'is-active']}
          data-filter={f.id}
          aria-pressed={i === 0 ? 'true' : 'false'}
        >
          {f.label}
        </button>
      ))}
    </div>

    <div class="svc-grid" data-svc-grid>
      {servizi.map((s) => (
        <div data-audience={s.data.audience.map((a) => a.id).join(' ')} class="svc-grid-item">
          <ServiceExpanded slug={s.id} />
        </div>
      ))}
    </div>

    <p class="svc-status" role="status" data-svc-status></p>
  </section>

  <Metodo
    eyebrow={c.metodoEyebrow}
    title={c.metodoTitle}
    tappe={c.metodo}
    icons={metodoIcons}
  />

  <CtaBanner
    title={c.ctaTitle}
    primaryCta={{ label: c.ctaPrimaryLabel, href: c.ctaPrimaryHref }}
    secondaryCta={{ label: c.ctaSecondaryLabel, href: c.ctaSecondaryHref }}
  />
</BaseLayout>

<style>
  .svc-intro {
    max-width: 64rem; /* max-w-5xl, nessun token */
    margin-inline: auto;
    padding-inline: var(--space-6);
    padding-top: 5rem; /* pt-20, nessun token */
    padding-bottom: var(--space-8);
    text-align: center;
  }
  @media (min-width: 768px) {
    .svc-intro {
      padding-top: var(--space-24);
    }
  }

  .svc-eyebrow {
    font-family: var(--font-display);
    font-size: 0.75rem;
    line-height: calc(1 / 0.75);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-butik-red-ink);
    margin-bottom: var(--space-4);
  }

  .svc-title {
    font-family: var(--font-heading);
    font-size: clamp(1.9rem, 1.35rem + 2.4vw, 2.25rem); /* text-4xl, nessun token per questo clamp */
    line-height: calc(2.5 / 2.25);
    font-weight: 700;
    color: var(--color-butik-dark);
    margin-bottom: 1.25rem; /* mb-5, nessun token */
  }
  @media (min-width: 768px) {
    .svc-title {
      font-size: clamp(2.2rem, 1.4rem + 3.4vw, 3rem); /* text-5xl, nessun token per questo clamp */
      line-height: 1;
    }
  }

  .svc-lead {
    font-family: var(--font-sans);
    font-size: var(--font-size-base);
    /* leading-relaxed era già sull'utility: vince lui sul line-height di
       text-base/text-lg, non i valori di riga di quelle taglie. */
    line-height: 1.625;
    color: var(--color-butik-body);
    max-width: 42rem; /* max-w-2xl, nessun token */
    margin-inline: auto;
  }
  @media (min-width: 768px) {
    .svc-lead {
      font-size: var(--font-size-lg);
    }
  }
  .svc-lead + .svc-lead {
    margin-top: var(--space-4);
  }

  .svc-main {
    max-width: 80rem; /* max-w-7xl, nessun token */
    margin-inline: auto;
    padding-inline: var(--space-6);
    padding-bottom: 5rem; /* pb-20, nessun token */
  }

  .svc-filters {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
    margin-bottom: 2.5rem; /* mb-10, nessun token */
  }

  .svc-filter {
    padding: 0.5rem 0.9rem;
    border: 1px solid color-mix(in srgb, var(--color-butik-dark) 18%, transparent);
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-butik-dark);
    background: transparent;
    cursor: pointer;
    transition: background-color 140ms ease, color 140ms ease, border-color 140ms ease;
  }
  .svc-filter:hover {
    border-color: var(--color-butik-red);
    color: var(--color-butik-red-ink);
  }
  .svc-filter.is-active {
    background: var(--color-butik-red);
    border-color: var(--color-butik-red);
    color: #fff;
  }
  .svc-filter:focus-visible {
    outline: 2px solid var(--color-butik-red);
    outline-offset: 2px;
  }
  @media (prefers-reduced-motion: reduce) {
    .svc-filter {
      transition: none;
    }
  }

  .svc-grid {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: 1.25rem; /* gap-5, nessun token */
  }
  @media (min-width: 1024px) {
    .svc-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .svc-grid-item {
    border: 1px solid color-mix(in oklab, var(--color-butik-dark) 12%, transparent);
    padding: var(--space-6);
  }
  @media (min-width: 768px) {
    .svc-grid-item {
      padding: var(--space-8);
    }
  }

  /* sr-only: fuori dal flusso visivo, presente per screen reader/status live. */
  .svc-status {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border-width: 0;
  }
</style>

<script>
  // Filtro per pubblico. Idempotente e riagganciato a ogni navigazione: sotto
  // le view transitions lo script gira una volta ma il DOM viene sostituito
  // (docs/guidances/client-scripts.md). Senza JS restano visibili tutti i
  // servizi, che è il default corretto.
  function initServiziFilter() {
    const filters = Array.from(
      document.querySelectorAll<HTMLButtonElement>('[data-svc-filters] .svc-filter'),
    );
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-svc-grid] [data-audience]'));
    const status = document.querySelector<HTMLElement>('[data-svc-status]');
    if (!filters.length) return;

    const apply = (val: string) => {
      let shown = 0;
      cards.forEach((card) => {
        const aud = (card.dataset.audience || '').split(' ');
        const match = val === 'tutti' || aud.includes(val);
        card.hidden = !match;
        if (match) shown += 1;
      });
      filters.forEach((f) => {
        const active = f.dataset.filter === val;
        f.classList.toggle('is-active', active);
        f.setAttribute('aria-pressed', String(active));
      });
      if (status) {
        status.textContent = `${shown} ${shown === 1 ? 'servizio' : 'servizi'} in elenco.`;
      }
    };

    filters.forEach((f) => {
      if (f.dataset.svcBound) return;
      f.dataset.svcBound = 'true';
      f.addEventListener('click', () => apply(f.dataset.filter || 'tutti'));
    });
  }
  document.addEventListener('astro:page-load', initServiziFilter);
</script>
