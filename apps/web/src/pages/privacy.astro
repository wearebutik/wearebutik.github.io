---
// Privacy & Cookie Policy dalla pagina "Privacy e cookie" su Sanity
// (ADR-0004). Due corpi di testo legale: la Cookie Policy è separata perché il
// suo titolo porta l'ancora fissa #cookie, a cui rimanda il banner dei cookie.
import { getEntry } from 'astro:content';
import GithubSlugger from 'github-slugger';
import BaseLayout from '#layouts/BaseLayout.astro';
import LegalText from '#components/testo/LegalText.astro';

const entry = await getEntry('pagine', 'privacy');
if (!entry || entry.data.type !== 'privacy') {
  throw new Error('Contenuto pagina "privacy" mancante o non valido (collezione pagine).');
}
const c = entry.data;
// Un solo slugger per la pagina: id dei titoli univoci tra i due corpi.
const slugger = new GithubSlugger();
slugger.slug('cookie');
---

<BaseLayout
  title={c.metaTitle}
  description={c.metaDescription}
>
  <article class="privacy-article">
    <div class="prose prose-full">
      <h1>{c.pageTitle}</h1>
      <p><em>Ultimo aggiornamento: {c.updatedDate}.</em></p>
      <LegalText value={c.body} slugger={slugger} />
      <hr />
      <h2 id="cookie">{c.cookieTitle}</h2>
      <LegalText value={c.cookieBody} slugger={slugger} />
    </div>
  </article>
</BaseLayout>

<style>
  .privacy-article {
    max-width: var(--measure-3xl);
    margin-inline: auto;
    padding-inline: var(--space-6); /* px-6 = 1.5rem */
    padding-block: var(--space-16); /* py-16 = 4rem */
  }
  @media (min-width: 768px) {
    .privacy-article {
      padding-block: var(--space-24); /* py-24 = 6rem */
    }
  }
</style>
