---
import { getImage } from 'astro:assets';
import logo from '../assets/logos/bollo-rosso.svg';
import { socials } from '../data/socials';
import SocialLinks from '@butik/ui/SocialLinks';
import Logo from '@butik/ui/Logo';

// getImage() (non <Image>) perché il risultato alimenta l'atomo React Logo di
// @butik/ui — vedi ADR-0008 amendment 2026-07-21 sul vincolo immagini Astro
// dentro le isole.
const logoImg = await getImage({ src: logo, width: 72, height: 72 });

const linksColumn1 = [
  { href: '/chi-siamo', label: 'Chi siamo' },
  { href: '/servizi', label: 'Servizi' },
  { href: '/progetti', label: 'Portfolio' },
  { href: '/formats', label: 'Formats' },
  { href: '/blog', label: 'Blog' },
];

const linksColumn2 = [
  { href: '/network', label: 'Network' },
  { href: '/contatti', label: 'Contattaci' },
  { href: '/sostienici', label: 'Sostienici' },
  { href: '/transparency', label: 'Transparency' },
];

const year = new Date().getFullYear();
---

<footer class="bg-butik-light text-butik-dark py-8 md:py-12">
  <div class="max-w-7xl mx-auto px-6">
    <div class="border border-butik-dark/15 px-5 md:px-8 py-6">

      <div class="grid grid-cols-1 md:grid-cols-[1fr_auto_auto] gap-x-12 md:gap-x-24 gap-y-6 items-start">
        <!-- Col 1: Logo + info aziendale -->
        <div class="flex flex-col">
          <a href="/" class="flex items-center flex-shrink-0">
            <Logo src={logoImg.src} width={72} height={72} className="h-[4.5rem] w-auto" />
          </a>

          <address class="not-italic font-sans text-sm text-butik-dark/70 leading-relaxed mt-4">
            <strong class="font-bold text-butik-dark">Butik s.r.l. Impresa Sociale</strong><br />
            Via Plinio 14, 20129 Milano — Italy<br />
            P. IVA 10429130965
          </address>

          <div class="mt-4">
            <p class="font-display text-xs font-bold tracking-widest uppercase mb-1">
              PEC &amp; Email
            </p>
            <p class="font-sans text-sm">
              <a href="mailto:butik@legalmail.it" class="text-butik-dark underline hover:text-butik-red-ink">butik@legalmail.it</a><br />
              <a href="mailto:info@wearebutik.com" class="text-butik-dark underline hover:text-butik-red-ink">info@wearebutik.com</a>
            </p>
          </div>

          <div class="mt-4">
            <SocialLinks socials={socials} />
          </div>
        </div>

        <!-- Col 3: link 1 (allineata al top del row) -->
        <nav aria-label="Sezioni sito">
          <ul class="flex flex-col">
            {linksColumn1.map(link => (
              <li>
                <a
                  href={link.href}
                  class="block py-2 font-sans text-sm text-butik-dark hover:text-butik-red-ink transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <!-- Col 4: link 2 (allineata al top, mr per spaziatura uniforme col bordo) -->
        <nav aria-label="Sezioni servizio" class="md:mr-16">
          <ul class="flex flex-col">
            {linksColumn2.map(link => (
              <li>
                <a
                  href={link.href}
                  class="block py-2 font-sans text-sm text-butik-dark hover:text-butik-red-ink transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>

      <!-- Bottom bar -->
      <div class="border-t border-butik-dark/10 mt-6 pt-4 flex flex-col md:flex-row md:justify-between gap-3 text-xs text-butik-dark/70">
        <p>&copy; {year} Butik. Tutti i diritti riservati.</p>
        <p class="flex flex-wrap gap-x-4 gap-y-2">
          <a href="/privacy" class="hover:text-butik-red-ink transition-colors">Privacy policy</a>
          <a href="/termini" class="hover:text-butik-red-ink transition-colors">Termini di utilizzo</a>
          <!-- Riapre la modale delle preferenze cookie (ADR-0006). -->
          <button
            id="cookie-preferences"
            type="button"
            class="font-sans text-xs text-inherit bg-transparent border-0 p-0 m-0 cursor-pointer hover:text-butik-red-ink transition-colors"
          >
            Preferenze cookie
          </button>
        </p>
      </div>
    </div>
  </div>
</footer>

<!-- Bind del bottone "Preferenze cookie" alla modale (ADR-0006). Rieseguito a
     ogni astro:page-load: dopo una view transition il bottone è un nuovo nodo. -->
<script>
  import { showCookiePreferences } from '#lib/consent/init.client';
  document.addEventListener('astro:page-load', () => {
    const btn = document.getElementById('cookie-preferences');
    btn?.addEventListener('click', () => showCookiePreferences());
  });
</script>
