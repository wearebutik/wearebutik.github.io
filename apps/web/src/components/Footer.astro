---
import { getImage } from 'astro:assets';
import { getEntry } from 'astro:content';
import logo from '../assets/logos/bollo-rosso.svg';
import { conIcone } from '../data/socials';
import { soloLinkValidi } from '#lib/links';
import SocialLinks from '@butik/ui/SocialLinks';
import Logo from '@butik/ui/Logo';
import MetaLabel from '@butik/ui/MetaLabel';

// getImage() (non <Image>) perché il risultato alimenta l'atomo React Logo di
// @butik/ui — vedi ADR-0008 amendment 2026-07-21 sul vincolo immagini Astro
// dentro le isole.
const logoImg = await getImage({ src: logo, width: 72, height: 72 });

// Contenuti del footer da Sanity (documento Footer, ADR-0004). I link che non
// portano da nessuna parte (segnaposto, pagine inesistenti) non si mostrano:
// nello Studio restano, segnalati in giallo. Finché il documento non esiste
// (es. su un dataset non ancora aggiornato) il footer mostra logo, link legali
// di base e preferenze cookie.
const entry = await getEntry('pagine', 'footer');
const f = entry?.data.type === 'footer' ? entry.data : undefined;
const socials = conIcone((await soloLinkValidi(f?.social ?? [])));
const colonna1 = await soloLinkValidi(f?.colonna1 ?? []);
const colonna2 = await soloLinkValidi(f?.colonna2 ?? []);
const linkLegali = await soloLinkValidi(
  f?.linkLegali ?? [
    { label: 'Privacy policy', href: '/privacy' },
    { label: 'Termini di utilizzo', href: '/termini' },
  ],
);

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-container">
    <div class="footer-panel">

      <div class="footer-grid">
        <!-- Col 1: Logo + info aziendale -->
        <div class="footer-brand">
          <a href="/" class="footer-brand-link">
            <Logo src={logoImg.src} width={72} height={72} className="footer-logo" />
          </a>

          {f && (
            <address class="footer-address">
              <strong class="footer-company-name">{f.ragioneSociale}</strong><br />
              {f.indirizzo.split('\n').map((riga) => <>{riga}<br /></>)}
              P. IVA {f.partitaIva}
            </address>
          )}

          {f && (
            <div class="footer-contact">
              <MetaLabel as="p">{f.contattiLabel}</MetaLabel>
              <p class="footer-contact-emails">
                <a href={`mailto:${f.pec}`} class="footer-link">{f.pec}</a><br />
                <a href={`mailto:${f.email}`} class="footer-link">{f.email}</a>
              </p>
            </div>
          )}

          {socials.length > 0 && (
            <div class="footer-social">
              <SocialLinks socials={socials} />
            </div>
          )}
        </div>

        <!-- Col 3: link 1 (allineata al top del row) -->
        <nav aria-label="Sezioni sito" class="footer-nav">
          <ul class="footer-nav-list">
            {colonna1.map(link => (
              <li>
                <a
                  href={link.href}
                  class="footer-nav-link"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <!-- Col 4: link 2 (allineata al top, mr per spaziatura uniforme col bordo) -->
        <nav aria-label="Sezioni servizio" class="footer-nav footer-nav-service">
          <ul class="footer-nav-list">
            {colonna2.map(link => (
              <li>
                <a
                  href={link.href}
                  class="footer-nav-link"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>

      <!-- Bottom bar -->
      <div class="footer-bottom">
        <p>&copy; {year} {f?.copyright ?? 'Butik'}</p>
        <p class="footer-bottom-links">
          {linkLegali.map((l) => <a href={l.href} class="footer-bottom-link">{l.label}</a>)}
          <!-- Riapre la modale delle preferenze cookie (ADR-0006). -->
          <button
            id="cookie-preferences"
            type="button"
            class="footer-bottom-link footer-cookie-btn"
          >
            {f?.cookieLabel ?? 'Preferenze cookie'}
          </button>
        </p>
      </div>
    </div>
  </div>
</footer>

<!-- Bind del bottone "Preferenze cookie" alla modale (ADR-0006). Rieseguito a
     ogni astro:page-load: dopo una view transition il bottone è un nuovo nodo. -->
<script>
  import { showCookiePreferences } from '#lib/consent/init.client';
  document.addEventListener('astro:page-load', () => {
    const btn = document.getElementById('cookie-preferences');
    btn?.addEventListener('click', () => showCookiePreferences());
  });
</script>

<style>
  .site-footer {
    background-color: var(--color-bg);
    color: var(--color-fg);
    padding-block: var(--space-8);
  }

  .footer-container {
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--space-6);
  }

  .footer-panel {
    border: 1px solid color-mix(in srgb, var(--color-fg) 15%, transparent);
    padding-inline: var(--space-5);
    padding-block: var(--space-6);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    column-gap: var(--space-12);
    row-gap: var(--space-6);
    align-items: start;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
  }

  .footer-brand-link {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  /* Logo reso dall'isola React @butik/ui/Logo: l'attributo di scoping di
     Astro non raggiunge il DOM dell'isola, serve :global() con .site-footer
     come pivot scoped (stesso pattern di Header.astro #site-logo). */
  .site-footer :global(.footer-logo) {
    /* 4.5rem era già un valore arbitrario Tailwind (h-[4.5rem]), non una
       tappa della scala spaziatura: nessun token applicabile. */
    height: 4.5rem;
    width: auto;
  }

  .footer-address {
    font-style: normal;
    font-family: var(--font-sans);
    font-size: var(--font-size-sm);
    color: color-mix(in srgb, var(--color-fg) 70%, transparent);
    /* Tailwind leading-relaxed: 1.625, nessun token nella scala. */
    line-height: 1.625;
    margin-top: var(--space-4);
  }

  .footer-company-name {
    font-weight: 700;
    color: var(--color-fg);
  }

  /* L'etichetta dei recapiti è un metadato (MetaLabel), in --color-fg come in
     /contatti/. Lo scarto lo dà il valore: l'isola non prende margini. */
  .footer-contact {
    margin-top: var(--space-4);
    --meta-label-color: var(--color-fg);
  }

  .footer-contact-emails {
    margin-top: var(--space-1);
    font-family: var(--font-sans);
    font-size: var(--font-size-sm);
    /* Tailwind text-sm porta con se anche il line-height. */
    line-height: calc(1.25 / 0.875);
  }

  .footer-link {
    color: var(--color-fg);
    text-decoration: underline;
    /* Tailwind transition-colors: durata = --duration-fast, ma l'easing
       (cubic-bezier(0.4, 0, 0.2, 1)) non coincide con --ease-out del repo. */
    transition: color var(--duration-fast) cubic-bezier(0.4, 0, 0.2, 1);
  }
  .footer-link:hover {
    color: var(--color-accent-text);
  }

  .footer-social {
    margin-top: var(--space-4);
  }

  .footer-nav-list {
    display: flex;
    flex-direction: column;
  }

  .footer-nav-link {
    display: block;
    padding-block: var(--space-2);
    font-family: var(--font-sans);
    font-size: var(--font-size-sm);
    /* Tailwind text-sm porta con se anche il line-height. */
    line-height: calc(1.25 / 0.875);
    color: var(--color-fg);
    transition: color var(--duration-fast) cubic-bezier(0.4, 0, 0.2, 1);
  }
  .footer-nav-link:hover {
    color: var(--color-accent-text);
  }

  .footer-bottom {
    border-top: 1px solid color-mix(in srgb, var(--color-fg) 10%, transparent);
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    font-size: var(--font-size-xs);
    /* Tailwind text-xs porta con se anche il line-height. */
    line-height: calc(1 / 0.75);
    color: color-mix(in srgb, var(--color-fg) 70%, transparent);
  }

  .footer-bottom-links {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--space-4);
    row-gap: var(--space-2);
  }

  .footer-bottom-link {
    transition: color var(--duration-fast) cubic-bezier(0.4, 0, 0.2, 1);
  }
  .footer-bottom-link:hover {
    color: var(--color-accent-text);
  }

  .footer-cookie-btn {
    font-family: var(--font-sans);
    font-size: var(--font-size-xs);
    /* Tailwind text-xs porta con se anche il line-height. */
    line-height: calc(1 / 0.75);
    color: inherit;
    background-color: transparent;
    border: 0;
    padding: 0;
    margin: 0;
    cursor: pointer;
  }

  @media (min-width: 768px) {
    .site-footer {
      padding-block: var(--space-12);
    }

    .footer-panel {
      padding-inline: var(--space-8);
    }

    .footer-grid {
      grid-template-columns: 1fr auto auto;
      column-gap: var(--space-24);
    }

    .footer-nav-service {
      margin-right: var(--space-16);
    }

    .footer-bottom {
      flex-direction: row;
      justify-content: space-between;
    }
  }
</style>
