---
/*
 * ImageBlock — wrapper sottile app-side. La presentazione (figure, img,
 * caption) vive in @butik/ui/ImageBlock, molecola React condivisa (ADR-0008
 * amendment 2026-07-21). Questo wrapper resta .astro per risolvere
 * l'immagine (`resolveAsset`, `getImage()` — entrambi Astro/Vite-only, non
 * eseguibili dentro un'isola React né in Storybook).
 *
 * La prop `height` (personalizzazione dell'altezza del box) non era usata da
 * nessun contenuto reale (5/5 usi con l'altezza di default) — rimossa;
 * l'altezza di default è ora fissata in ImageBlock.module.css.
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { isRemote, resolveAsset } from '#lib/media';
import ImageBlock from '@butik/ui/ImageBlock';

interface Props {
  src: ImageMetadata | string;
  alt?: string;
  caption?: string;
}

const { src, alt = '', caption } = Astro.props;
const resolved = typeof src === 'string' ? resolveAsset(src) : src;

const resolvedImg =
  typeof resolved === 'string' && !isRemote(resolved)
    ? { src: resolved, srcSet: undefined, sizes: undefined, width: undefined, height: undefined }
    : await (async () => {
        const img = await getImage({
          src: resolved,
          inferSize: typeof resolved === 'string',
          widths: [800, 1200, 1600],
          sizes: '100vw',
          quality: 72,
        });
        return {
          src: img.src,
          srcSet: img.srcSet.attribute,
          sizes: '100vw',
          width: img.attributes.width,
          height: img.attributes.height,
        };
      })();
---

<ImageBlock
  src={resolvedImg.src}
  srcSet={resolvedImg.srcSet}
  sizes={resolvedImg.sizes}
  width={resolvedImg.width}
  height={resolvedImg.height}
  alt={alt}
  caption={caption}
/>
