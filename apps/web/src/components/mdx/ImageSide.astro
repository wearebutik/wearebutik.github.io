---
/*
 * ImageSide — wrapper sottile app-side. La figura (img + caption) vive in
 * @butik/ui/ImageSide, molecola React condivisa (ADR-0008 amendment
 * 2026-07-21). Il layout a due colonne, il lato e lo slot (`.prose`) restano
 * qui: sono concern di composizione pagina. Il lato è l'ordine del DOM — con
 * `side="right"` il testo viene prima della figura — così anche lettori di
 * schermo e mobile (una colonna) seguono l'ordine che si vede.
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { imageSize, isRemote } from '#lib/media';
import ImageSide from '@butik/ui/ImageSide';

interface Props {
  src: ImageMetadata | string;
  alt?: string;
  caption?: string;
  /** Lato dell'immagine rispetto al testo. */
  side?: 'left' | 'right';
}

const { src, alt = '', caption, side = 'left' } = Astro.props;
const resolved = src;

const resolvedImg =
  typeof resolved === 'string' && !isRemote(resolved)
    ? { src: resolved, srcSet: undefined, sizes: undefined, width: undefined, height: undefined }
    : await (async () => {
        const img = await getImage({
          src: resolved,
          ...imageSize(resolved),
          widths: [400, 800],
          sizes: '(max-width: 768px) 100vw, 50vw',
          quality: 72,
        });
        return {
          src: img.src,
          srcSet: img.srcSet.attribute,
          sizes: '(max-width: 768px) 100vw, 50vw',
          width: img.attributes.width,
          height: img.attributes.height,
        };
      })();
---

<div class="image-text-row not-prose">
  {side === 'right' && (
    <div class="prose prose-full">
      <slot />
    </div>
  )}

  <ImageSide
    src={resolvedImg.src}
    srcSet={resolvedImg.srcSet}
    sizes={resolvedImg.sizes}
    width={resolvedImg.width}
    height={resolvedImg.height}
    alt={alt}
    caption={caption}
  />

  {side === 'left' && (
    <div class="prose prose-full">
      <slot />
    </div>
  )}
</div>

<style>
  .image-text-row {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    align-items: center;
    gap: var(--space-8);
    margin-block: var(--space-12);
  }

  @media (min-width: 768px) {
    .image-text-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
