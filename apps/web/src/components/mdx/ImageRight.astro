---
/*
 * ImageRight — wrapper sottile app-side. La figura (img + caption) vive in
 * @butik/ui/ImageRight, molecola React condivisa (ADR-0008 amendment
 * 2026-07-21). Il layout a due colonne e lo slot MDX (`.prose`) restano
 * qui: sono concern di composizione pagina, non del componente condiviso.
 * Lo slot testo è DOM-first (rispetto alla figura) — è questo, non una
 * classe diversa, a mettere l'immagine a destra.
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { resolveAsset } from '#lib/media';
import ImageRight from '@butik/ui/ImageRight';

interface Props {
  src: ImageMetadata | string;
  alt?: string;
  caption?: string;
}

const { src, alt = '', caption } = Astro.props;
const resolved = typeof src === 'string' ? resolveAsset(src) : src;

const resolvedImg =
  typeof resolved === 'string'
    ? { src: resolved, srcSet: undefined, sizes: undefined, width: undefined, height: undefined }
    : await (async () => {
        const img = await getImage({
          src: resolved,
          widths: [400, 800],
          sizes: '(max-width: 768px) 100vw, 50vw',
          quality: 72,
        });
        return {
          src: img.src,
          srcSet: img.srcSet.attribute,
          sizes: '(max-width: 768px) 100vw, 50vw',
          width: img.attributes.width,
          height: img.attributes.height,
        };
      })();
---

<div class="image-text-row not-prose">
  <div class="prose prose-full">
    <slot />
  </div>

  <ImageRight
    src={resolvedImg.src}
    srcSet={resolvedImg.srcSet}
    sizes={resolvedImg.sizes}
    width={resolvedImg.width}
    height={resolvedImg.height}
    alt={alt}
    caption={caption}
  />
</div>

<style>
  .image-text-row {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    align-items: center;
    gap: var(--space-8);
    margin-block: var(--space-12);
  }

  @media (min-width: 768px) {
    .image-text-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
