---
/*
 * ImageCarousel — wrapper sottile app-side. La presentazione e
 * l'interattività (scroll-snap, frecce, dots) vivono in
 * @butik/ui/ImageCarousel, molecola React condivisa (ADR-0008 amendment
 * 2026-07-21) — a differenza delle altre molecole immagine è
 * genuinamente interattiva, quindi consumata con `client:visible` (non
 * presentazionale pura). Questo wrapper resta .astro per risolvere le
 * immagini (`getImage()` — Astro/Vite-only).
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { imageSize, isRemote } from '#lib/media';
import ImageCarousel from '@butik/ui/ImageCarousel';

interface CarouselImage {
  src: ImageMetadata | string;
  alt?: string;
  caption?: string;
}

interface Props {
  images: CarouselImage[];
}

const { images } = Astro.props;

const resolvedImages = await Promise.all(
  images.map(async ({ src, alt, caption }) => {
    const resolved = src;
    if (typeof resolved === 'string' && !isRemote(resolved)) {
      return { src: resolved, alt, caption };
    }
    const img = await getImage({ src: resolved, ...imageSize(resolved), widths: [800, 1200], sizes: '100vw', quality: 72 });
    return {
      src: img.src,
      srcSet: img.srcSet.attribute,
      sizes: '100vw',
      width: img.attributes.width,
      height: img.attributes.height,
      alt,
      caption,
    };
  }),
);
---

<ImageCarousel images={resolvedImages} client:visible />
