---
// Blocco servizio "espanso" con trattamento grafico: badge-icona, numero
// indice fantasma, mini-equalizer (firma musicale) all'hover e reveal allo
// scroll. Testi dal documento servizio: card (titolo) e hero (target, sub,
// esiti).
import type { CollectionEntry } from 'astro:content';
import ArrowLink from '@butik/ui/ArrowLink';
import MetaLabel from '@butik/ui/MetaLabel';

interface Props {
  servizio: CollectionEntry<'servizi'>;
  /** Posizione nell'elenco (da 1): numero fantasma e accento a rotazione. */
  index: number;
}
const { servizio, index } = Astro.props;
const slug = servizio.id;
const { hero, card } = servizio.data;
const title = card.title;
const href = `/servizi/${slug}`;

const idx = String(index).padStart(2, '0');

// Accento cromatico a rotazione (contrasto sicuro su sfondo chiaro).
const accents = [
  'var(--color-butik-red)',
  'var(--color-butik-dark)',
  'var(--color-butik-purple)',
  'var(--color-butik-red)',
  'var(--color-butik-dark)',
];
const accent = accents[(index - 1) % accents.length];

// Variante "ink" dello stesso accento, per il testo piccolo su fondo chiaro.
const accentsInk = [
  'var(--color-butik-red-ink)',
  'var(--color-butik-dark)',
  'var(--color-butik-purple)',
  'var(--color-butik-red-ink)',
  'var(--color-butik-dark)',
];
const accentInk = accentsInk[(index - 1) % accentsInk.length];

// Icone monolinea per servizio (geometriche, niente clip-art).
const icons: Record<string, string> = {
  'progettazione-culturale': '<path d="M12 3v18M3 12h18M5.6 5.6l12.8 12.8M18.4 5.6 5.6 18.4"/>',
  'consulenza-strategica': '<circle cx="12" cy="12" r="9"/><path d="M9.5 14.5 11 9l4.5-1.5L14 13z"/>',
  'formazione-capacity-building': '<path d="M12 4 2 9l10 5 10-5z"/><path d="M6 11v4c0 1.1 2.7 3 6 3s6-1.9 6-3v-4"/>',
  'eventi-culturali-musicali': '<path d="M4 12v1.5M8 8.5v7M12 5v14M16 9v6M20 11v2.5"/>',
  'prodotti-turistico-musicali': '<path d="M12 21s7-6 7-11a7 7 0 1 0-14 0c0 5 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/>',
};
---

<article class="svc-exp" id={slug} style={`--accent:${accent};--accent-ink:${accentInk};--meta-label-color:${accentInk}`}>
  <div class="svc-exp__head">
    <span class="svc-exp__badge">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[slug]} />
      <span class="svc-exp__eq" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
    </span>
    <span class="svc-exp__index" aria-hidden="true">{idx}</span>
  </div>

  <MetaLabel as="p">
    {hero?.eyebrow}
  </MetaLabel>
  <h3 class="svc-exp__title">
    {title}
  </h3>
  <p class="svc-exp__desc">
    {hero?.sub ?? servizio.data.subtitle}
  </p>

  <ul class="svc-exp__outcomes">
    {(hero?.outcomes ?? []).map((o) => (
      <li class="svc-exp__outcome">
        <span class="svc-exp__check" aria-hidden="true">✓</span>
        <span>{o}</span>
      </li>
    ))}
  </ul>

  <div class="svc-exp__cta">
    <ArrowLink href={href} className="svc-exp__link">Scopri {title}</ArrowLink>
  </div>
</article>

<style>
  .svc-exp {
    scroll-margin-top: 6rem;
    position: relative;
  }
  /* Tutta la card è cliccabile: l'area del link "Scopri …" si allarga
     all'intera card (pseudo-elemento sopra la card: il testo non si
     seleziona col mouse, si legge e si copia dalla scheda del servizio). L'entrata allo scroll la fa il sistema del sito
     (styles/motion.css + @butik/ui/reveal). */
  .svc-exp :global(.svc-exp__link)::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .svc-exp:has(:global(.svc-exp__link):focus-visible) {
    outline: 2px solid var(--accent, var(--color-accent));
    outline-offset: 4px;
  }
  .svc-exp :global(.svc-exp__link):focus-visible {
    outline: none;
  }

  .svc-exp__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }

  /* Badge-icona col tint dell'accento. */
  .svc-exp__badge {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 0.85rem;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 11%, transparent);
  }
  .svc-exp__badge svg {
    width: 1.6rem;
    height: 1.6rem;
  }

  /* Mini-equalizer: la firma musicale, ferma a riposo, "suona" all'hover. */
  .svc-exp__eq {
    position: absolute;
    right: -0.5rem;
    bottom: -0.5rem;
    display: flex;
    align-items: flex-end;
    gap: 2px;
    height: 1rem;
    padding: 0.2rem;
    border-radius: 0.4rem;
    background: var(--color-butik-dark);
  }
  .svc-exp__eq i {
    width: 2.5px;
    height: 30%;
    border-radius: 1px;
    background: var(--color-butik-green);
    transition: height 200ms ease;
  }
  .svc-exp:hover .svc-exp__eq i {
    animation: svc-eq 750ms ease-in-out infinite;
  }
  .svc-exp:hover .svc-exp__eq i:nth-child(2) { animation-delay: 120ms; }
  .svc-exp:hover .svc-exp__eq i:nth-child(3) { animation-delay: 240ms; }
  .svc-exp:hover .svc-exp__eq i:nth-child(4) { animation-delay: 360ms; }
  @keyframes svc-eq {
    0%, 100% { height: 25%; }
    50% { height: 95%; }
  }

  /* Numero indice fantasma. */
  .svc-exp__index {
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: 3.5rem;
    line-height: 0.8;
    color: var(--accent);
    opacity: 0.14;
    letter-spacing: -0.03em;
  }

  .svc-exp__check {
    font-weight: 700;
    color: var(--accent);
  }
  /* Neutralizza lo stile globale di h3 (uppercase/rosso/tracking). */
  .svc-exp__title {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.25;
    margin-top: var(--space-2);
    text-transform: none !important;
    letter-spacing: -0.005em !important;
    color: var(--color-butik-dark) !important;
  }
  @media (min-width: 768px) {
    .svc-exp__title {
      font-size: clamp(1.6rem, 1.25rem + 1.5vw, 1.875rem);
    }
  }

  .svc-exp__desc {
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.625;
    margin-top: var(--space-3);
    max-width: 42rem;
    color: color-mix(in oklab, var(--color-butik-dark) 75%, transparent);
  }
  @media (min-width: 768px) {
    .svc-exp__desc {
      font-size: 1.125rem;
    }
  }

  .svc-exp__outcomes {
    display: grid;
    margin-top: 1.25rem;
    gap: var(--space-2) var(--space-6);
    max-width: 42rem;
  }
  @media (min-width: 640px) {
    .svc-exp__outcomes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .svc-exp__outcome {
    display: flex;
    gap: var(--space-2);
    font-family: var(--font-sans);
    font-size: 0.875rem;
    line-height: 1.375;
    color: var(--color-butik-dark);
  }
  @media (min-width: 768px) {
    .svc-exp__outcome {
      font-size: 1rem;
    }
  }

  .svc-exp__cta {
    margin-top: var(--space-6);
  }

  @media (prefers-reduced-motion: reduce) {
    .svc-exp:hover .svc-exp__eq i {
      animation: none;
    }
  }
</style>
