---
// Card-servizio in vetro sulle foto dell'hero: titolo + descrizione + prova in
// fondo, con il glifo monolinea del servizio in filigrana nell'angolo in basso
// a destra. Il vetro (semitrasparente e sfocato) lascia intravedere la foto e
// con gli angoli arrotondati e lo stato hover si legge come un link.
// È la presentazione scelta per i servizi nell'hero da tablet in su (da mobile
// li presenta ServiceLauncher, vedi Hero.astro).
//
// I dati sono copy editoriale e arrivano come prop dal chiamante (ADR-0004):
// in home dal campo `card` di ciascun documento servizio (Sanity).
// L'icona resta config di design e vive qui, indicizzata per slug.
export interface ServiceCardData {
  /** Slug della collection `servizi`, usato per scegliere l'icona. */
  slug: string;
  title: string;
  desc: string;
  href: string;
  /** Prova reale, in valore + etichetta ("9" · "bandi vinti"). */
  statValue: string;
  statLabel: string;
}

interface Props {
  data: ServiceCardData;
}
const { data } = Astro.props;

// Icone monolinea per slug. Geometriche, niente clip-art.
const icons: Record<string, string> = {
  'progettazione-culturale':
    '<path d="M12 3v18M3 12h18M5.6 5.6l12.8 12.8M18.4 5.6 5.6 18.4"/>',
  'consulenza-strategica':
    '<circle cx="12" cy="12" r="9"/><path d="M9.5 14.5 11 9l4.5-1.5L14 13z"/>',
  'formazione-capacity-building':
    '<path d="M12 4 2 9l10 5 10-5z"/><path d="M6 11v4c0 1.1 2.7 3 6 3s6-1.9 6-3v-4"/>',
  'eventi-culturali-musicali':
    '<path d="M4 12v1.5M8 8.5v7M12 5v14M16 9v6M20 11v2.5"/>',
  'prodotti-turistico-musicali':
    '<path d="M12 21s7-6 7-11a7 7 0 1 0-14 0c0 5 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/>',
};
---

<a href={data.href} class="card group">
  <svg
    class="card__icon"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    set:html={icons[data.slug]}
  />

  <div class="card__body">
  <h3 class="card__title">{data.title}</h3>
  <p class="card__desc">{data.desc}</p>

  <span class="card__stat">{`${data.statValue} ${data.statLabel}`}</span>
  </div>

</a>

<style>
  /* Vetro: fondo scuro semitrasparente + sfocatura della foto sottostante.
     Il testo bianco sta sopra il velo dell'hero (60%) più il vetro: il
     contrasto non dipende dalla foto. */
  .card {
    position: relative;
    overflow: hidden; /* la filigrana esce dal bordo e viene tagliata */
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.25rem 1.25rem 1.4rem; /* nessun token a 1.25rem */
    border-radius: var(--radius-lg);
    border: 1px solid color-mix(in srgb, var(--color-white) 25%, transparent);
    background-color: color-mix(in srgb, var(--color-butik-dark) 35%, transparent);
    backdrop-filter: blur(12px); /* nessun token blur */
    -webkit-backdrop-filter: blur(12px);
    color: var(--color-white);
    text-decoration: none;
    transition: transform 160ms ease, background-color 160ms ease, border-color 160ms ease;
  }
  .card:hover,
  .card:focus-visible {
    transform: translateY(-3px);
    background-color: color-mix(in srgb, var(--color-butik-dark) 55%, transparent);
    border-color: var(--color-white);
  }
  .card:focus-visible {
    outline: 2px solid var(--color-white);
    outline-offset: 3px;
  }

  /* Testo sopra la filigrana. */
  .card__body {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  /* Titolo: neutralizza lo stile globale di h3 (rosso/uppercase/tracking).
     Il nome del servizio è l'elemento principale della card. */
  .card__title {
    font-family: var(--font-heading);
    font-size: var(--font-size-xl);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.005em;
    text-transform: none;
    color: var(--color-white);
    margin: 0;
  }
  .card__desc {
    flex: 1;
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--font-size-sm);
    line-height: 1.45;
    color: color-mix(in srgb, var(--color-white) 88%, transparent);
  }
  .card__stat {
    font-family: var(--font-display);
    font-size: 0.6875rem; /* come le etichette delle card: nessun token a 11px */
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-white) 75%, transparent);
  }

  /* Filigrana: glifo grande e tenue, tagliato dal bordo in basso a destra;
     all'hover si accende e ruota appena. */
  .card__icon {
    position: absolute;
    right: -1.75rem;
    bottom: -1.75rem;
    width: 8.5rem; /* scala della filigrana: nessun token di dimensione icona */
    height: 8.5rem;
    color: var(--color-butik-red);
    opacity: 0.35;
    transition: opacity 160ms ease, transform 300ms ease;
  }
  .card:hover .card__icon,
  .card:focus-visible .card__icon {
    opacity: 0.55;
    transform: rotate(-8deg) scale(1.05);
  }

  @media (prefers-reduced-motion: reduce) {
    .card,
    .card__icon {
      transition: background-color 160ms ease, border-color 160ms ease, opacity 160ms ease;
    }
    .card:hover,
    .card:focus-visible,
    .card:hover .card__icon,
    .card:focus-visible .card__icon {
      transform: none;
    }
  }
</style>
