---
// Card-servizio: titolo + descrizione + prova in fondo, con il glifo
// monolinea del servizio in filigrana nell'angolo in basso a destra.
// È la presentazione scelta per i servizi nell'hero da tablet in su (da mobile
// li presenta ServiceLauncher, vedi Hero.astro).
//
// I dati sono copy editoriale e arrivano come prop dal chiamante (ADR-0004):
// in home dal campo `card` di ciascun documento servizio (Sanity).
// L'icona resta config di design e vive qui, indicizzata per slug.
export interface ServiceCardData {
  /** Slug della collection `servizi`, usato per scegliere l'icona. */
  slug: string;
  title: string;
  desc: string;
  href: string;
  /** Prova reale, in valore + etichetta ("9" · "bandi vinti"). */
  statValue: string;
  statLabel: string;
}

interface Props {
  data: ServiceCardData;
}
const { data } = Astro.props;

// Icone monolinea per slug. Geometriche, niente clip-art.
const icons: Record<string, string> = {
  'progettazione-culturale':
    '<path d="M12 3v18M3 12h18M5.6 5.6l12.8 12.8M18.4 5.6 5.6 18.4"/>',
  'consulenza-strategica':
    '<circle cx="12" cy="12" r="9"/><path d="M9.5 14.5 11 9l4.5-1.5L14 13z"/>',
  'formazione-capacity-building':
    '<path d="M12 4 2 9l10 5 10-5z"/><path d="M6 11v4c0 1.1 2.7 3 6 3s6-1.9 6-3v-4"/>',
  'eventi-culturali-musicali':
    '<path d="M4 12v1.5M8 8.5v7M12 5v14M16 9v6M20 11v2.5"/>',
  'prodotti-turistico-musicali':
    '<path d="M12 21s7-6 7-11a7 7 0 1 0-14 0c0 5 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/>',
};
---

<a href={data.href} class="card group">
  <svg
    class="card__icon"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    set:html={icons[data.slug]}
  />

  <div class="card__body">
  <h3 class="card__title">{data.title}</h3>
  <p class="card__desc">{data.desc}</p>

  <span class="card__stat">{`${data.statValue} ${data.statLabel}`}</span>
  </div>

  <span class="card__go" aria-hidden="true">→</span>
</a>

<style>
  .card {
    position: relative;
    overflow: hidden; /* la filigrana esce dal bordo e viene tagliata */
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid color-mix(in srgb, var(--color-butik-dark) 15%, transparent);
    padding: 1.25rem 1.25rem 1.4rem;
    text-decoration: none;
    transition: transform 160ms ease, box-shadow 160ms ease, border-color 160ms ease;
  }
  .card:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 30px rgba(7, 17, 8, 0.12);
    border-color: color-mix(in srgb, var(--color-butik-dark) 30%, transparent);
  }
  .card:focus-visible {
    outline: 2px solid var(--color-butik-red);
    outline-offset: 3px;
  }

  /* Titolo: neutralizza lo stile globale di h3 (rosso/uppercase/tracking). */
  /* Il nome del servizio è l'elemento principale della card: più grande
     della descrizione (una riga), con aria sotto. */
  .card__title {
    font-family: var(--font-heading);
    font-size: 1.3125rem; /* 21px: nessun token fra --font-size-lg e --font-size-xl */
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.005em;
    text-transform: none;
    color: var(--color-butik-dark);
    margin: 0 0 var(--space-1);
  }
  .card__desc {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    line-height: 1.45;
    color: color-mix(in srgb, var(--color-butik-dark) 70%, transparent);
    flex: 1;
    margin: 0;
  }

  /* Testo sopra la filigrana. */
  .card__body {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  /* Filigrana: glifo grande, tenue, tagliato dal bordo in basso a destra.
     Fino al 16% (hover) il testo che ci passa sopra resta sopra 4.5:1. */
  .card__icon {
    position: absolute;
    right: -1.75rem;
    bottom: -1.75rem;
    width: 8.5rem; /* scala della filigrana: nessun token di dimensione icona */
    height: 8.5rem;
    color: var(--color-butik-red);
    opacity: 0.12;
    transition: opacity 160ms ease, transform 300ms ease;
  }
  .card:hover .card__icon,
  .card:focus-visible .card__icon {
    opacity: 0.16;
    transform: rotate(-8deg) scale(1.05);
  }

  .card__stat {
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    /* 65%: sopra 4.5:1 anche dove passa la filigrana (al 55% era 4.26:1 già su bianco). */
    color: color-mix(in srgb, var(--color-butik-dark) 65%, transparent);
  }

  /* Affordance senza costo di spazio: la freccia è fuori dal flusso (angolo)
     e compare solo all'hover/focus. La card intera è il link. */
  .card__go {
    position: absolute;
    top: 1.1rem;
    right: 1.1rem;
    font-size: 1.1rem;
    line-height: 1;
    color: var(--color-butik-red);
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 150ms ease, transform 150ms ease;
  }
  .card:hover .card__go,
  .card:focus-visible .card__go {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .card {
      transition: box-shadow 160ms ease, border-color 160ms ease;
    }
    .card:hover {
      transform: none;
    }
    .card__go {
      transition: opacity 150ms ease;
      transform: none;
    }
    .card__icon,
    .card:hover .card__icon,
    .card:focus-visible .card__icon {
      transition: opacity 160ms ease;
      transform: none;
    }
  }
</style>
