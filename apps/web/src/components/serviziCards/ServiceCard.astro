---
// Card-servizio in vetro sulle foto dell'hero: titolo + descrizione + freccia,
// con il glifo monolinea del servizio in filigrana nell'angolo in basso
// a destra. Il vetro (semitrasparente e sfocato) lascia intravedere la foto e
// con gli angoli arrotondati e lo stato hover si legge come un link.
// È la presentazione scelta per i servizi nell'hero da tablet in su (da mobile
// li presenta ServiceLauncher, vedi Hero.astro).
//
// I dati sono copy editoriale e arrivano come prop dal chiamante (ADR-0004):
// in home dalla lista Card del blocco Hero (Sanity). L'icona si sceglie nello
// Studio fra quelle di @butik/site-config/icone; il disegno vive qui.
// Senza `href` (link che non porta da nessuna parte, per esempio a una scheda
// non pubblicata: lib/links.ts) la card resta, senza freccia né hover.
import ArrowCircle from '@butik/ui/ArrowCircle';
import type { IconaCard } from '@butik/site-config/icone';
import { ICONE_SVG } from './icone';

export interface ServiceCardData {
  /** Glifo in filigrana; senza, la card non ne ha. */
  icona?: IconaCard;
  title: string;
  desc: string;
  href?: string;
}

interface Props {
  data: ServiceCardData;
}
const { data } = Astro.props;
const Tag = data.href ? 'a' : 'div';

---

<Tag href={data.href} class="card group" data-arrow-circle-host={data.href ? '' : undefined}>
  {data.icona && (
    <svg
      class="card__icon"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      set:html={ICONE_SVG[data.icona]}
    />
  )}

  <div class="card__body">
  <h2 class="card__title">{data.title}</h2>
  <p class="card__desc">{data.desc}</p>

  {data.href && <ArrowCircle tone="invert" size="md" className="card__go" />}
  </div>

</Tag>

<style>
  /* Vetro: fondo scuro semitrasparente + sfocatura della foto sottostante.
     Il testo bianco sta sopra il velo dell'hero (60%) più il vetro: il
     contrasto non dipende dalla foto. */
  .card {
    position: relative;
    overflow: hidden; /* la filigrana esce dal bordo e viene tagliata */
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: var(--space-5) var(--space-5) 1.4rem;
    border-radius: var(--radius-lg);
    border: 1px solid color-mix(in srgb, var(--color-fg-invert) 25%, transparent);
    background-color: color-mix(in srgb, var(--color-bg-invert) 35%, transparent);
    /* Solo la proprietà standard (ADR-0003, CSS minification): Safari 17 e
       precedenti non sfocano; il fondo scuro e il testo restano. */
    backdrop-filter: blur(var(--blur-glass));
    color: var(--color-fg-invert);
    text-decoration: none;
    transition: transform var(--duration-fast) var(--ease-standard), background-color var(--duration-fast) var(--ease-standard), border-color var(--duration-fast) var(--ease-standard);
  }
  a.card:hover,
  a.card:focus-visible {
    transform: translateY(-3px);
    background-color: color-mix(in srgb, var(--color-bg-invert) 55%, transparent);
    border-color: var(--color-fg-invert);
  }
  .card:focus-visible {
    outline: 2px solid var(--color-fg-invert);
    outline-offset: 3px;
  }

  /* Testo sopra la filigrana. */
  .card__body {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  /* Titolo H2: le card stanno subito sotto l'H1 della home. Il nome del
     servizio è l'elemento principale della card. */
  .card__title {
    font-family: var(--font-heading);
    font-size: var(--font-size-xl);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.005em;
    text-transform: none;
    color: var(--color-fg-invert);
    margin: 0;
  }
  .card__desc {
    flex: 1;
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--font-size-sm);
    line-height: 1.45;
    color: color-mix(in srgb, var(--color-fg-invert) 88%, transparent);
  }
  /* Invito al click: ArrowCircle, sempre visibile (su tablet e touch l'hover
     non c'è). La card porta data-arrow-circle-host: il suo hover/focus
     riempie il cerchio di rosso e fa avanzare la freccia. Qui solo la
     posizione; l'atomo è un'isola, il selettore passa per :global()
     (ADR-0008 #astro-island-boundary). */
  .card :global(.card__go) {
    align-self: flex-start;
    margin-top: var(--space-2);
  }

  /* Filigrana: glifo grande e tenue, tagliato dal bordo in basso a destra;
     all'hover si accende e ruota appena. */
  .card__icon {
    /* design-lint-disable red-as-text: filigrana SVG, non testo */
    position: absolute;
    right: -1.75rem;
    bottom: -1.75rem;
    width: 8.5rem; /* scala della filigrana: nessun token di dimensione icona */
    height: 8.5rem;
    color: var(--color-accent);
    opacity: 0.35;
    transition: opacity var(--duration-fast) var(--ease-standard), transform var(--duration-slow) var(--ease-standard);
  }
  .card:hover .card__icon,
  .card:focus-visible .card__icon {
    opacity: 0.55;
    transform: rotate(-8deg) scale(1.05);
  }

  @media (prefers-reduced-motion: reduce) {
    .card,
    .card__icon {
      transition: background-color var(--duration-fast) var(--ease-standard), border-color var(--duration-fast) var(--ease-standard), opacity var(--duration-fast) var(--ease-standard);
    }
    .card:hover,
    .card:focus-visible,
    .card:hover .card__icon,
    .card:focus-visible .card__icon {
      transform: none;
    }
  }
</style>
