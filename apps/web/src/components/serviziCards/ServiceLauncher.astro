---
// Launcher compatto dei servizi: una riga per servizio (nome + frase + freccia),
// tutti scansionabili senza scroll. È la presentazione scelta per i servizi
// nell'hero su mobile, dove le card non stanno sopra la piega (da tablet in su
// li presenta ServiceCard, vedi Hero.astro). La frase è la stessa descrizione
// che la card mostra da tablet in su.
//
// I dati sono copy editoriale e arrivano come prop dal chiamante (ADR-0004).
// `tone` adatta i colori a sfondo chiaro o scuro (hero home = scuro).
export interface ServiceLauncherItem {
  slug: string;
  title: string;
  href: string;
  desc: string;
}

interface Props {
  items: ServiceLauncherItem[];
  tone?: 'onLight' | 'onDark';
  /** Se true, ogni voce punta all'ancora #slug nella stessa pagina. */
  useAnchors?: boolean;
}
const { items, tone = 'onLight', useAnchors = false } = Astro.props;
const linkFor = (slug: string, href: string) => (useAnchors ? `#${slug}` : href);
---

<ul class:list={['launcher-list', tone]}>
  {items.map((c) => (
    <li>
      <a href={linkFor(c.slug, c.href)} class="row">
        <span class="row-text">
          <span class="row-title">{c.title}</span>
          <span class="row-desc">{c.desc}</span>
        </span>
        <span class="row-chev" aria-hidden="true">›</span>
      </a>
    </li>
  ))}
</ul>

<style>
  /* ── LIST ──────────────────────────────────────────────────────────── */
  /* Linee solo fra una riga e l'altra: la lista sta dentro un riquadro con
     il suo bordo, e una linea sopra la prima e sotto l'ultima riga finiva
     quasi addosso a quel bordo. */
  .launcher-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .launcher-list li + li {
    border-top: 1px solid var(--rule);
  }
  .row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) 0.6rem;
    margin: 0 -0.6rem;
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--ink);
    transition: background-color var(--duration-fast) var(--ease-standard);
  }
  .row:hover,
  .row:active,
  .row:focus-visible {
    background: var(--row-hover);
  }
  /* Nome sopra, frase sotto: in colonna la frase va a capo senza togliere
     spazio al nome. */
  .row-text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .row-title {
    font-family: var(--font-heading);
    font-size: var(--font-size-base);
    font-weight: 700;
    letter-spacing: -0.005em;
    line-height: 1.15;
  }
  .row-desc {
    font-family: var(--font-sans);
    font-size: var(--font-size-sm);
    line-height: 1.4;
    color: var(--muted);
  }
  /* Chevron di disclosure: segnala che la riga è toccabile (visibile sempre,
     non solo all'hover, così funziona anche su mobile). */
  .row-chev {
    flex-shrink: 0;
    font-size: 1.35rem;
    line-height: 1;
    color: var(--accent);
    opacity: 0.55;
    transition: opacity var(--duration-fast) var(--ease-standard), transform var(--duration-fast) var(--ease-standard);
  }
  .row:hover .row-chev,
  .row:focus-visible .row-chev {
    opacity: 1;
    transform: translateX(2px);
  }
  .row:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .row:hover .row-title {
    color: var(--accent-text, var(--accent));
  }

  /* ── Tone tokens ───────────────────────────────────────────────────── */
  .onLight {
    --ink: var(--color-butik-dark);
    /* 70%: la frase regge 4.5:1 sul fondo chiaro, anche in hover. */
    --muted: color-mix(in srgb, var(--color-butik-dark) 70%, transparent);
    --rule: color-mix(in srgb, var(--color-butik-dark) 15%, transparent);
    --accent: var(--color-butik-red);
    --accent-text: var(--color-butik-red-ink);
    --row-hover: color-mix(in srgb, var(--color-butik-dark) 6%, transparent);
  }
  .onDark {
    --ink: var(--color-fg-invert);
    /* 80%: la frase regge 4.5:1 sul vetro scuro della lista, anche in hover. */
    --muted: color-mix(in srgb, var(--color-fg-invert) 80%, transparent);
    --rule: color-mix(in srgb, var(--color-fg-invert) 20%, transparent);
    --accent: var(--color-butik-green);
    --row-hover: color-mix(in srgb, var(--color-fg-invert) 10%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .row,
    .row-chev {
      transition: none;
    }
  }
</style>
