---
// Launcher compatto dei servizi: una riga per servizio (nome + frase + freccia),
// tutti scansionabili senza scroll. È la presentazione scelta per i servizi
// nell'hero su mobile, dove le card non stanno sopra la piega (da tablet in su
// li presenta ServiceCard, vedi Hero.astro). La frase è la stessa descrizione
// che la card mostra da tablet in su.
//
// I dati sono copy editoriale e arrivano come prop dal chiamante (ADR-0004).
// Sta sull'hero della home, su vetro scuro: i colori sono quelli di un fondo
// scuro.
export interface ServiceLauncherItem {
  slug: string;
  title: string;
  href: string;
  desc: string;
}

interface Props {
  items: ServiceLauncherItem[];
}
const { items } = Astro.props;
---

<ul class="launcher-list">
  {items.map((c) => (
    <li>
      <a href={c.href} class="row">
        <span class="row-text">
          <span class="row-title">{c.title}</span>
          <span class="row-desc">{c.desc}</span>
        </span>
        <span class="row-chev" aria-hidden="true">›</span>
      </a>
    </li>
  ))}
</ul>

<style>
  /* ── LIST ──────────────────────────────────────────────────────────── */
  /* Linee solo fra una riga e l'altra: la lista sta dentro un riquadro con
     il suo bordo, e una linea sopra la prima e sotto l'ultima riga finiva
     quasi addosso a quel bordo. */
  .launcher-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .launcher-list li + li {
    border-top: 1px solid var(--rule);
  }
  .row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-2-5);
    margin: 0 calc(-1 * var(--space-2-5));
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--ink);
    transition: background-color var(--duration-fast) var(--ease-standard);
  }
  .row:hover,
  .row:active,
  .row:focus-visible {
    background: var(--row-hover);
  }
  /* Nome sopra, frase sotto: in colonna la frase va a capo senza togliere
     spazio al nome. */
  .row-text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .row-title {
    font-family: var(--font-heading);
    font-size: var(--font-size-base);
    font-weight: 700;
    letter-spacing: -0.005em;
    line-height: 1.15;
  }
  .row-desc {
    font-family: var(--font-sans);
    font-size: var(--font-size-sm);
    line-height: 1.4;
    color: var(--muted);
  }
  /* Chevron di disclosure: segnala che la riga è toccabile (visibile sempre,
     non solo all'hover, così funziona anche su mobile). */
  .row-chev {
    flex-shrink: 0;
    font-size: 1.35rem;
    line-height: 1;
    color: var(--accent);
    opacity: 0.55;
    transition: opacity var(--duration-fast) var(--ease-standard), transform var(--duration-fast) var(--ease-standard);
  }
  .row:hover .row-chev,
  .row:focus-visible .row-chev {
    opacity: 1;
    transform: translateX(2px);
  }
  .row:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .row:hover .row-title {
    color: var(--accent);
  }

  /* ── Colori (fondo scuro) ─────────────────────────────────────────── */
  .launcher-list {
    --ink: var(--color-fg-invert);
    /* 80%: la frase regge 4.5:1 sul vetro scuro della lista, anche in hover. */
    --muted: color-mix(in srgb, var(--color-fg-invert) 80%, transparent);
    --rule: color-mix(in srgb, var(--color-fg-invert) 20%, transparent);
    --accent: var(--color-highlight);
    --row-hover: color-mix(in srgb, var(--color-fg-invert) 10%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .row,
    .row-chev {
      transition: none;
    }
  }
</style>
