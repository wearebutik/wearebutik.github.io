---
// Launcher compatto dei servizi: una riga per servizio (nome + prova + freccia),
// tutti scansionabili senza scroll. È la presentazione scelta per i servizi
// nell'hero su mobile, dove le card non stanno sopra la piega (da tablet in su
// li presenta ServiceCard, vedi Hero.astro).
//
// I dati sono copy editoriale e arrivano come prop dal chiamante (ADR-0004).
// `tone` adatta i colori a sfondo chiaro o scuro (hero home = scuro).
export interface ServiceLauncherItem {
  slug: string;
  title: string;
  href: string;
  statValue: string;
  statLabel: string;
}

interface Props {
  items: ServiceLauncherItem[];
  tone?: 'onLight' | 'onDark';
  /** Se true, ogni voce punta all'ancora #slug nella stessa pagina. */
  useAnchors?: boolean;
}
const { items, tone = 'onLight', useAnchors = false } = Astro.props;
const linkFor = (slug: string, href: string) => (useAnchors ? `#${slug}` : href);
---

<ul class:list={['launcher-list', tone]}>
  {items.map((c) => (
    <li>
      <a href={linkFor(c.slug, c.href)} class="row">
        <span class="row-title">{c.title}</span>
        <span class="row-stat">{`${c.statValue} ${c.statLabel}`}</span>
        <span class="row-chev" aria-hidden="true">›</span>
      </a>
    </li>
  ))}
</ul>

<style>
  /* ── LIST ──────────────────────────────────────────────────────────── */
  .launcher-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }
  .launcher-list li {
    border-bottom: 1px solid var(--rule);
  }
  .row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 0.6rem;
    margin: 0 -0.6rem;
    border-radius: 0.5rem;
    text-decoration: none;
    color: var(--ink);
    transition: background-color 140ms ease;
  }
  .row:hover,
  .row:active,
  .row:focus-visible {
    background: var(--row-hover);
  }
  .row-title {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.005em;
    line-height: 1.15;
    flex: 1;
    min-width: 0;
  }
  .row-stat {
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
    flex-shrink: 0;
  }
  /* Chevron di disclosure: segnala che la riga è toccabile (visibile sempre,
     non solo all'hover, così funziona anche su mobile). */
  .row-chev {
    flex-shrink: 0;
    font-size: 1.35rem;
    line-height: 1;
    color: var(--accent);
    opacity: 0.55;
    transition: opacity 140ms ease, transform 140ms ease;
  }
  .row:hover .row-chev,
  .row:focus-visible .row-chev {
    opacity: 1;
    transform: translateX(2px);
  }
  .row:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .row:hover .row-title {
    color: var(--accent-text, var(--accent));
  }

  /* ── Tone tokens ───────────────────────────────────────────────────── */
  .onLight {
    --ink: var(--color-butik-dark);
    --muted: color-mix(in srgb, var(--color-butik-dark) 55%, transparent);
    --rule: color-mix(in srgb, var(--color-butik-dark) 15%, transparent);
    --accent: var(--color-butik-red);
    --accent-text: var(--color-butik-red-ink);
    --row-hover: color-mix(in srgb, var(--color-butik-dark) 6%, transparent);
  }
  .onDark {
    --ink: #fff;
    --muted: rgba(255, 255, 255, 0.65);
    --rule: rgba(255, 255, 255, 0.2);
    --accent: var(--color-butik-green);
    --row-hover: rgba(255, 255, 255, 0.1);
  }

  @media (prefers-reduced-motion: reduce) {
    .row,
    .row-chev {
      transition: none;
    }
  }
</style>
