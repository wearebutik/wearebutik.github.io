---
// Copy content-driven (ADR-0004): titolo, testo e micro-copy arrivano dalla
// collezione `pagine` (entry `home`), passati da index.astro. Il messaggio di
// successo viaggia in un data-attribute e viene letto dallo script inline.
interface Props {
  title: string;
  body: string;
  placeholder: string;
  button: string;
  privacy: string;
  success: string;
}

const { title, body, placeholder, button, privacy, success } = Astro.props;
---

<section class="newsletter">
  <div class="newsletter-inner">
    <h2 class="newsletter-title">
      {title}
    </h2>

    <p class="newsletter-body">
      {body}
    </p>

    <div id="newsletter-container">
      <form id="newsletter-form" action="#" method="post" class="newsletter-form">
        <label class="visually-hidden" for="newsletter-email">Email</label>
        <input
          id="newsletter-email"
          type="email"
          name="email"
          required
          placeholder={placeholder}
          autocomplete="email"
          class="newsletter-input"
        />

        <input
          type="text"
          name="website"
          tabindex="-1"
          autocomplete="off"
          class="hidden"
          aria-hidden="true"
        />

        <button type="submit" class="newsletter-submit">
          {button}
        </button>
      </form>

      <p class="newsletter-privacy" set:html={privacy}></p>
    </div>

    <p
      id="newsletter-status"
      class="newsletter-status hidden"
      role="status"
      aria-live="polite"
      data-success={success}
    ></p>
  </div>
</section>

<script>
  import { trackEvent } from '#lib/analytics/posthog.client';

  // Rieseguito a ogni astro:page-load: con <ClientRouter /> il modulo gira una
  // volta sola per sessione, ma la view transition sostituisce il DOM. Senza
  // re-init, dopo una navigazione il submit non veniva più intercettato: il
  // form partiva in navigazione nativa e `newsletter_subscribed` non veniva
  // mai emesso, bucando il funnel PostHog.
  function initNewsletter() {
    const container = document.getElementById('newsletter-container');
    const status = document.getElementById('newsletter-status');
    const form = document.getElementById('newsletter-form') as HTMLFormElement | null;
    if (!container || !status || !form) return;

    // Guardia di idempotenza: se il nodo è lo stesso di prima (nessuna view
    // transition, solo un secondo evento) non raddoppiamo il listener.
    if (form.dataset.bound === 'true') return;
    form.dataset.bound = 'true';

    form.addEventListener('submit', (event) => {
      event.preventDefault();

      const honeypot = form.elements.namedItem('website') as HTMLInputElement | null;
      if (honeypot && honeypot.value.trim() !== '') {
        return;
      }

      container.classList.add('hidden');
      status.textContent = status.dataset.success ?? '';
      status.classList.remove('hidden');

      trackEvent('newsletter_subscribed');
    });
  }

  document.addEventListener('astro:page-load', initNewsletter);
</script>

<style>
  .newsletter {
    padding-block: var(--space-12);
    background: var(--color-bg);
  }
  @media (min-width: 768px) {
    .newsletter {
      padding-block: var(--space-16);
    }
  }

  .newsletter-inner {
    /* max-w-2xl: nessun token per i max-width in ui-tokens. */
    max-width: 42rem;
    margin-inline: auto;
    padding-inline: var(--space-6);
    text-align: center;
  }

  .newsletter-title {
    font-family: var(--font-heading);
    /* Il @theme del sito sovrascrive --text-3xl/4xl/5xl con dei clamp(), ma non
       i rispettivi --text-*--line-height: Tailwind continua ad applicare i
       suoi, che quindi vanno riportati insieme alla dimensione. Nessun token
       combacia con questi clamp(). */
    font-size: clamp(1.6rem, 1.25rem + 1.5vw, 1.875rem);
    line-height: 1.2;
    font-weight: 700;
    color: var(--color-fg);
    margin-bottom: var(--space-6);
  }
  @media (min-width: 768px) {
    .newsletter-title {
      font-size: clamp(1.9rem, 1.35rem + 2.4vw, 2.25rem);
      line-height: calc(2.5 / 2.25);
    }
  }
  @media (min-width: 1024px) {
    .newsletter-title {
      font-size: clamp(2.2rem, 1.4rem + 3.4vw, 3rem);
      line-height: 1;
    }
  }

  .newsletter-body {
    font-family: var(--font-sans);
    font-size: var(--font-size-base);
    line-height: calc(1.5 / 1);
    color: color-mix(in srgb, var(--color-fg) 70%, transparent);
    /* mb-10 = 2.5rem: nessun token di spacing combacia (space-8=2rem, space-12=3rem). */
    margin-bottom: 2.5rem;
  }

  .newsletter-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  @media (min-width: 768px) {
    .newsletter-form {
      flex-direction: row;
    }
  }

  /* Annuncio del campo per le tecnologie assistive, fuori dal flusso visivo. */
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .newsletter-input {
    flex: 1 1 0%;
    /* px-5 = 1.25rem: nessun token combacia (space-4=1rem, space-6=1.5rem). */
    padding-inline: 1.25rem;
    padding-block: var(--space-3);
    border: 1px solid color-mix(in srgb, var(--color-fg) 30%, transparent);
    background: var(--color-white);
    font-family: var(--font-sans);
    font-size: var(--font-size-base);
    line-height: calc(1.5 / 1);
  }
  @media (min-width: 768px) {
    .newsletter-input {
      padding-block: var(--space-4);
    }
  }
  .newsletter-input:focus {
    outline: none;
    border-color: var(--color-accent);
  }

  /* Nome mantenuto uguale allo script: initNewsletter fa classList.add/remove
     su 'hidden' sia sull'honeypot che su container e status. */
  .hidden {
    display: none;
  }

  .newsletter-submit {
    background: var(--color-bg-invert);
    color: var(--color-fg-invert);
    padding-inline: var(--space-8);
    padding-block: var(--space-3);
    font-family: var(--font-display);
    font-size: var(--font-size-xs);
    line-height: calc(1 / 0.75);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    /* transition-colors: durata = --duration-fast, ma l'easing
       (cubic-bezier(0.4, 0, 0.2, 1)) non coincide con --ease-out del repo. */
    transition: background-color var(--duration-fast) cubic-bezier(0.4, 0, 0.2, 1);
    width: 100%;
  }
  @media (min-width: 768px) {
    .newsletter-submit {
      padding-block: var(--space-4);
      width: auto;
    }
  }
  .newsletter-submit:hover {
    background: var(--color-accent);
  }

  .newsletter-privacy {
    font-family: var(--font-sans);
    font-size: var(--font-size-xs);
    line-height: calc(1 / 0.75);
    color: color-mix(in srgb, var(--color-fg) 50%, transparent);
    margin-top: var(--space-4);
  }

  .newsletter-status {
    font-family: var(--font-sans);
    font-size: var(--font-size-base);
    line-height: calc(1.5 / 1);
    color: var(--color-fg);
  }
</style>
