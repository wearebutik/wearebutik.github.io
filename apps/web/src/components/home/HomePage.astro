---
// Contenuto della home (tutto tranne il layout), usato da pages/index.astro:
// le sezioni della pagina Home su Sanity, nell'ordine scelto nello Studio
// (ADR-0004, *Pages as sections*).
import { getEntry } from 'astro:content';
import Sezioni from '#components/sezioni/Sezioni.astro';

const homeEntry = await getEntry('pagine', 'home');
if (!homeEntry || homeEntry.data.type !== 'home') {
  throw new Error('Contenuto pagina "home" mancante o non valido (collezione pagine).');
}
---

<Sezioni sezioni={homeEntry.data.sezioni} />
