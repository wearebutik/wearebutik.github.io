---
import { Image } from 'astro:assets';
import { partners as defaultPartners, type Partner } from '../../data/partners';

interface Props {
  partners?: Partner[];
}

const { partners = defaultPartners } = Astro.props;

// Desktop: una sola riga, lista duplicata per il loop continuo (translateX -50%).
const desktopTrack = [...partners, ...partners];

// Mobile: due righe. Spezziamo i partner a metà e duplichiamo ciascuna riga.
const half = Math.ceil(partners.length / 2);
const mobileRowA = partners.slice(0, half);
const mobileRowB = partners.slice(half);
const trackA = [...mobileRowA, ...mobileRowA];
const trackB = [...mobileRowB, ...mobileRowB];
---

<section class="partner-strip" data-partner-strip>
  {/* ---------- Desktop: marquee a riga singola ---------- */}
  <div class="partner-desktop">
    <div class="partner-track partner-track-row is-autoscroll" data-partner-track>
      {
        desktopTrack.map((partner) => (
          <div class="partner-card" data-name={partner.name}>
            <Image
              src={partner.logo}
              alt=""
              height={40}
              densities={[1, 2]}
              loading="eager"
              decoding="async"
              draggable={false}
              class="partner-card-logo"
            />
          </div>
        ))
      }
    </div>

    <p class="partner-label" data-partner-label aria-hidden="true"></p>
  </div>

  {/* ---------- Mobile: due righe trascinabili, nome sotto il logo ---------- */}
  <div class="partner-mobile">
    <div
      class="partner-track partner-track-row-mobile is-autoscroll"
      data-partner-track
      style="--marquee-dur: 40s"
    >
      {
        trackA.map((partner) => (
          <div class="partner-item">
            <div class="partner-item-frame">
              <Image
                src={partner.logo}
                alt=""
                height={36}
                densities={[1, 2]}
                loading="lazy"
                decoding="async"
                draggable={false}
                class="partner-item-logo"
              />
            </div>
            <span class="partner-item-name">{partner.name}</span>
          </div>
        ))
      }
    </div>

    <div
      class="partner-track partner-track-row-mobile is-autoscroll is-reverse"
      data-partner-track
      style="--marquee-dur: 48s"
    >
      {
        trackB.map((partner) => (
          <div class="partner-item">
            <div class="partner-item-frame">
              <Image
                src={partner.logo}
                alt=""
                height={36}
                densities={[1, 2]}
                loading="lazy"
                decoding="async"
                draggable={false}
                class="partner-item-logo"
              />
            </div>
            <span class="partner-item-name">{partner.name}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style is:global>
  /* ── Layout della strip (utility Tailwind risolte) ──────────────────── */
  .partner-strip {
    position: relative;
    overflow: hidden;
    background-color: var(--color-bg);
    padding-top: 2.5rem; /* pt-10: nessun token combacia (tra --space-8 e --space-12) */
    padding-bottom: 3.5rem; /* pb-14: nessun token combacia (tra --space-12 e --space-16) */
  }

  @media (min-width: 768px) {
    .partner-strip {
      padding-top: var(--space-12);
      padding-bottom: var(--space-16);
    }
  }

  /* Desktop: marquee a riga singola, nascosto sotto i 768px. */
  .partner-desktop {
    display: none;
  }

  @media (min-width: 768px) {
    .partner-desktop {
      display: block;
    }
  }

  /* Mobile: due righe impilate, nascoste da 768px in su. */
  .partner-mobile {
    display: flex;
    flex-direction: column;
    gap: 1.25rem; /* gap-5: nessun token combacia (tra --space-4 e --space-6) */
  }

  @media (min-width: 768px) {
    .partner-mobile {
      display: none;
    }
  }

  .partner-track {
    display: flex;
    width: max-content;
    will-change: transform;
    cursor: grab;
    user-select: none;
  }

  .partner-track-row {
    align-items: center;
    gap: var(--space-8);
  }

  .partner-track-row-mobile {
    align-items: flex-start;
    gap: 1.25rem; /* gap-5: nessun token combacia (tra --space-4 e --space-6) */
  }

  .partner-card {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 5rem; /* h-20: nessun token combacia (tra --space-16 e --space-24) */
    padding-inline: var(--space-8);
    background-color: var(--color-white);
    border-radius: 0.75rem; /* rounded-xl: nessun token combacia (--radius-md .5rem / --radius-lg 1rem) */
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--color-fg) 5%, transparent);
  }

  .partner-card-logo {
    max-height: 2.5rem; /* max-h-10: nessun token combacia (tra --space-8 e --space-12) */
    width: auto;
    pointer-events: none;
  }

  /* Nome del partner in basso, mostrato su hover della card (vedi script). */
  .partner-label {
    position: absolute;
    inset-inline: 0;
    bottom: var(--space-4);
    pointer-events: none;
    text-align: center;
    font-family: var(--font-display);
    font-size: var(--font-size-xs);
    line-height: calc(1 / 0.75); /* line-height che text-xs porta con sé */
    font-weight: 700;
    letter-spacing: 0.1em; /* tracking-widest */
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-fg) 60%, transparent);
    opacity: 0;
    transition: opacity 200ms cubic-bezier(0.4, 0, 0.2, 1); /* duration-200: nessun --duration-* combacia */
  }

  .partner-item {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    width: 7rem; /* w-28: nessun token combacia (tra --space-16 e --space-24) */
  }

  .partner-item-frame {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: center;
    height: var(--space-16);
    padding-inline: 1.25rem; /* px-5: nessun token combacia (tra --space-4 e --space-6) */
    background-color: var(--color-white);
    border-radius: 0.75rem; /* rounded-xl: nessun token combacia (--radius-md .5rem / --radius-lg 1rem) */
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--color-fg) 5%, transparent);
  }

  .partner-item-logo {
    max-height: var(--space-8);
    width: auto;
    pointer-events: none;
  }

  .partner-item-name {
    text-align: center;
    font-family: var(--font-display);
    font-size: 10px; /* text-[10px]: arbitrary, non porta line-height implicito */
    font-weight: 700;
    line-height: 1.25; /* leading-tight, presente sullo stesso elemento: vince su text-* */
    letter-spacing: 0.025em; /* tracking-wide */
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-fg) 55%, transparent);
  }

  @keyframes butik-marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  /* Stessa cosa al contrario, per la seconda riga mobile. */
  @keyframes butik-marquee-rev {
    from {
      transform: translateX(-50%);
    }
    to {
      transform: translateX(0);
    }
  }

  /* Scorrimento automatico di default: pura animazione CSS. */
  .partner-track.is-autoscroll {
    animation: butik-marquee var(--marquee-dur, 45s) linear infinite;
  }

  .partner-track.is-autoscroll.is-reverse {
    animation-name: butik-marquee-rev;
  }

  /* On hover della strip (solo desktop, dove l'hover esiste): il marquee si ferma. */
  .partner-strip:hover .partner-track.is-autoscroll {
    animation-play-state: paused;
  }

  .partner-track.is-dragging {
    cursor: grabbing;
  }

  @media (prefers-reduced-motion: reduce) {
    .partner-track.is-autoscroll {
      animation: none;
    }
  }
</style>

<script>
  // Soglia in px oltre la quale il movimento è considerato un drag (non un click).
  const DRAG_THRESHOLD = 4;

  const prefersReducedMotion = window.matchMedia(
    '(prefers-reduced-motion: reduce)'
  ).matches;

  // Configura una singola traccia trascinabile (riga marquee).
  function setupTrack(track: HTMLElement) {
    // Idempotente: con ClientRouter initPartners() può rieseguire; non
    // riagganciare due volte gli handler sullo stesso elemento.
    if (track.dataset.partnerReady) return;
    track.dataset.partnerReady = '1';

    // La track contiene la lista duplicata: metà della sua larghezza è il
    // punto in cui il contenuto si ripete (= il -50% del keyframe CSS).
    let halfWidth = track.scrollWidth / 2;
    const measure = () => {
      halfWidth = track.scrollWidth / 2;
    };
    window.addEventListener('resize', measure);

    // Direzione e durata dell'animazione = stessa fonte di verità del CSS.
    const isReverse = track.classList.contains('is-reverse');
    const durationSec = () => {
      const d = parseFloat(getComputedStyle(track).animationDuration);
      return Number.isFinite(d) && d > 0 ? d : 45;
    };

    let offset = 0;
    let interactive = false; // true = controllo JS, false = animazione CSS
    let rafId = 0;
    let isPointerDown = false;
    let isDragging = false;
    let startX = 0;
    let startOffset = 0;
    let lastX = 0;
    let lastT = 0;
    let velocity = 0; // px/secondo, per l'inerzia a fine drag.
    let lastFrame = 0;

    // Mantiene l'offset nell'intervallo (-halfWidth, 0] per il loop infinito.
    const wrap = (value: number) => {
      if (halfWidth <= 0) return value;
      let v = value % halfWidth;
      if (v > 0) v -= halfWidth;
      return v;
    };

    // Legge la translateX corrente applicata dall'animazione CSS.
    const currentTranslateX = () => {
      const t = getComputedStyle(track).transform;
      if (!t || t === 'none') return 0;
      try {
        return new DOMMatrixReadOnly(t).m41;
      } catch {
        return 0;
      }
    };

    const apply = () => {
      track.style.transform = `translate3d(${offset}px, 0, 0)`;
    };

    // CSS → JS: congela la posizione dell'animazione e passa al controllo JS.
    const enterInteractive = () => {
      if (interactive) return;
      interactive = true;
      measure(); // la riga potrebbe essere appena diventata visibile (breakpoint)
      offset = wrap(currentTranslateX());
      track.classList.remove('is-autoscroll');
      track.style.animationDelay = '';
      apply();
      lastFrame = 0;
      rafId = requestAnimationFrame(tick);
    };

    // JS → CSS: riallinea l'animazione alla posizione corrente e la riattiva.
    const exitInteractive = () => {
      interactive = false;
      if (rafId) {
        cancelAnimationFrame(rafId);
        rafId = 0;
      }
      offset = wrap(offset);

      // Con reduced-motion non c'è animazione: resta fermi dove siamo.
      if (prefersReducedMotion) {
        apply();
        return;
      }

      // Fase 0..1 dell'animazione corrispondente all'offset corrente.
      // Forward (0 → -50%):  p = -offset / halfWidth
      // Reverse (-50% → 0):  p = 1 + offset / halfWidth
      const p =
        halfWidth > 0
          ? isReverse
            ? 1 + offset / halfWidth
            : -offset / halfWidth
          : 0;
      track.style.transform = '';
      track.style.animationDelay = `${-(p * durationSec())}s`;
      track.classList.add('is-autoscroll');
    };

    function tick(now: number) {
      if (!interactive) return;
      const dt = lastFrame ? (now - lastFrame) / 1000 : 0;
      lastFrame = now;

      if (!isPointerDown) {
        if (Math.abs(velocity) > 20) {
          // Inerzia dopo il rilascio.
          offset = wrap(offset + velocity * dt);
          velocity *= 0.92;
          apply();
        } else {
          // Movimento esaurito: restituisce il controllo all'animazione CSS.
          exitInteractive();
          return;
        }
      }

      rafId = requestAnimationFrame(tick);
    }

    // --- Drag ---
    track.addEventListener('pointerdown', (e: PointerEvent) => {
      enterInteractive();
      isPointerDown = true;
      isDragging = false;
      startX = lastX = e.clientX;
      startOffset = offset;
      lastT = e.timeStamp;
      velocity = 0;
      track.setPointerCapture(e.pointerId);
    });

    track.addEventListener('pointermove', (e: PointerEvent) => {
      if (!isPointerDown) return;
      const dx = e.clientX - startX;
      if (!isDragging && Math.abs(dx) > DRAG_THRESHOLD) {
        isDragging = true;
        track.classList.add('is-dragging');
      }
      if (!isDragging) return;

      offset = wrap(startOffset + dx);
      apply();

      // Stima della velocità istantanea per l'inerzia.
      const dt = (e.timeStamp - lastT) / 1000;
      if (dt > 0) velocity = (e.clientX - lastX) / dt;
      lastX = e.clientX;
      lastT = e.timeStamp;
    });

    const onPointerUp = (e: PointerEvent) => {
      if (!isPointerDown) return;
      isPointerDown = false;
      track.classList.remove('is-dragging');
      if (track.hasPointerCapture(e.pointerId)) {
        track.releasePointerCapture(e.pointerId);
      }
      // Limita l'inerzia per evitare scatti troppo lunghi.
      velocity = Math.max(-1800, Math.min(1800, velocity));
      // Se non c'è stato drag reale, restituisce subito il controllo al CSS.
      if (!isDragging) exitInteractive();
    };

    track.addEventListener('pointerup', onPointerUp);
    track.addEventListener('pointercancel', onPointerUp);
    // Evita un eventuale click/navigazione se l'utente ha trascinato.
    track.addEventListener('click', (e) => {
      if (isDragging) {
        e.preventDefault();
        e.stopPropagation();
      }
    });
  }

  function initPartners() {
    document
      .querySelectorAll<HTMLElement>('[data-partner-track]')
      .forEach(setupTrack);

    // --- Desktop: nome del partner in basso, su hover della singola card ---
    document.querySelectorAll<HTMLElement>('[data-partner-strip]').forEach((strip) => {
      if (strip.dataset.partnerLabelReady) return;
      strip.dataset.partnerLabelReady = '1';

      const label = strip.querySelector<HTMLElement>('[data-partner-label]');
      if (!label) return;

      strip.addEventListener('mouseleave', () => {
        label.style.opacity = '0';
      });

      strip.querySelectorAll<HTMLElement>('[data-name]').forEach((card) => {
        const name = card.dataset.name ?? '';
        card.addEventListener('mouseenter', () => {
          label.textContent = name;
          label.style.opacity = '1';
        });
      });
    });
  }

  // Init al primo caricamento e a ogni navigazione client-side (view transitions).
  initPartners();
  document.addEventListener('astro:page-load', initPartners);
</script>
