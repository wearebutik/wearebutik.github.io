---
import { placeholderStyle } from '#lib/lqip';
import { stili, vtName } from '#lib/viewTransition';
import Foto from '#components/Foto.astro';
import { foto } from '#lib/foto';
import type { CollectionEntry } from 'astro:content';
import SectionHeading from '@butik/ui/SectionHeading';
import Button from '@butik/ui/Button';

interface Props {
  progetti: CollectionEntry<'progetti'>[];
}

const { progetti } = Astro.props;

const fotoCard = await Promise.all(
  progetti.map((p) =>
    foto(p.data.heroImage, { widths: [400, 700, 1000], sizes: '(max-width: 640px) 100vw, 50vw', ruolo: 'miniatura' }),
  ),
);
---

{progetti.length > 0 && (
  <section class="portfolio-section">
    <div class="portfolio-container">
      <div class="portfolio-header">
        <SectionHeading eyebrow="Progetti" title="Storie di trasformazione territoriale" />
        <p class="portfolio-intro">
          Quello che abbiamo costruito insieme ai nostri partner
        </p>
      </div>

      <div class="portfolio-grid" data-reveal-group data-prefetch="viewport">
        {progetti.map((p, i) => (
          <a
            href={`/progetti/${p.id}`}
            class="portfolio-card"
            aria-label={p.data.title}
          >
            <Foto
              foto={fotoCard[i]}
              alt={p.data.heroAlt}
              loading="lazy"
              class="portfolio-card-image"
              style={stili(placeholderStyle(p.data.heroLqip), vtName(`progetto-${p.id}`))}
            />
            <div class="portfolio-card-overlay">
              {p.data.category && (
                <span class="portfolio-card-category">
                  {p.data.category}
                </span>
              )}
              <h3
                class="portfolio-card-title"
                style={vtName(`progetto-${p.id}-title`)}
              >
                {p.data.title}
              </h3>
              <p class="portfolio-card-subtitle">
                {p.data.subtitle}
              </p>
            </div>
          </a>
        ))}
      </div>

      <div class="portfolio-cta" data-prefetch="viewport">
        <Button href="/progetti" variant="ghost" tone="accent">Vedi tutti i progetti</Button>
      </div>
    </div>
  </section>
)}

<style>
  .portfolio-section {
    padding-top: var(--space-12); /* py-12 = 3rem */
    padding-bottom: var(--space-12);
  }
  @media (min-width: 768px) {
    .portfolio-section {
      padding-top: var(--space-16); /* py-16 = 4rem */
      padding-bottom: var(--space-16);
    }
  }

  .portfolio-container {
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--space-6);
  }

  .portfolio-header {
    margin-bottom: var(--space-8); /* mb-8 = 2rem */
  }
  @media (min-width: 768px) {
    .portfolio-header {
      margin-bottom: var(--space-10);
    }
  }

  .portfolio-intro {
    font-family: var(--font-sans);
    font-size: var(--font-size-sm); /* text-sm = 0.875rem */
    line-height: calc(1.25 / 0.875); /* line-height che text-sm porta con sé */
    color: color-mix(in srgb, var(--color-fg) 70%, transparent);
    max-width: var(--measure-2xl);
    margin-top: var(--space-4);
  }
  @media (min-width: 768px) {
    .portfolio-intro {
      font-size: var(--font-size-base); /* text-base = 1rem */
      line-height: calc(1.5 / 1); /* line-height che text-base porta con sé */
    }
  }

  .portfolio-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    margin-top: var(--space-12);
  }
  @media (min-width: 640px) {
    .portfolio-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .portfolio-card {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }
  .portfolio-card:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .portfolio-card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Segnaposto sfocato (LQIP) finché la foto non arriva: stesso ritaglio
       di object-fit: cover. */
    background-image: var(--placeholder, none);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    transition: transform var(--duration-slower) var(--ease-standard);
  }
  .portfolio-card:hover .portfolio-card-image {
    transform: scale(1.05);
  }
  @media (prefers-reduced-motion: reduce) {
    .portfolio-card-image {
      transition: none;
    }
    .portfolio-card:hover .portfolio-card-image {
      transform: none;
    }
  }

  .portfolio-card-overlay {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    padding: var(--space-5);
    /* Scrim ancorato al testo, come HeroBanner: dentro il blocco il fondo non
       scende sotto il 70% (titolo ~7.3:1, sottotitolo ~5.4:1 su foto bianca),
       con o senza chip. La sfumatura verso la foto sta sopra il blocco. */
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--color-fg) 90%, transparent),
      color-mix(in srgb, var(--color-fg) 70%, transparent)
    );
  }
  .portfolio-card-overlay::before {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: 100%;
    height: var(--space-16);
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--color-fg) 70%, transparent),
      transparent
    );
    pointer-events: none;
  }
  @media (min-width: 768px) {
    .portfolio-card-overlay {
      padding: var(--space-6); /* p-6 = 1.5rem */
    }
  }

  .portfolio-card-category {
    /* design-lint-disable small-caps: chip con fondo proprio, fuori dai due ruoli */
    display: inline-block;
    font-family: var(--font-display);
    font-size: var(--font-size-xs); /* text-xs = 0.75rem */
    line-height: calc(1 / 0.75); /* line-height che text-xs porta con sé */
    letter-spacing: 0.1em; /* tracking-widest */
    text-transform: uppercase;
    background-color: var(--color-bg);
    color: var(--color-fg);
    padding-inline: var(--space-3);
    padding-block: var(--space-1);
    margin-bottom: var(--space-3);
  }

  /* Override dello stile globale h3 (uppercase + tracking + rosso): i titoli
     progetto sono bianchi e in sentence-case sopra il gradiente scuro. */
  .portfolio-card-title {
    color: var(--color-fg-invert);
    text-transform: none;
    letter-spacing: -0.005em;
    font-family: var(--font-heading);
    font-size: var(--font-size-title-sm);
    font-weight: 700;
    /* leading-tight vince sul line-height implicito di text-xl/text-2xl */
    line-height: 1.25;
  }
  @media (min-width: 768px) {
    .portfolio-card-title {
      font-size: var(--font-size-xl); /* text-2xl = 1.5rem, combacia con questo token */
    }
  }

  .portfolio-card-subtitle {
    font-family: var(--font-sans);
    font-size: var(--font-size-sm); /* text-sm = 0.875rem */
    line-height: calc(1.25 / 0.875); /* line-height che text-sm porta con sé */
    color: color-mix(in srgb, var(--color-fg-invert) 80%, transparent);
    margin-top: var(--space-2);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Il CTA è il Button del catalogo (PDR-0005): la pagina dà solo la
     posizione, centrata sotto la griglia. */
  .portfolio-cta {
    margin-top: var(--space-12);
    text-align: center;
  }
</style>
