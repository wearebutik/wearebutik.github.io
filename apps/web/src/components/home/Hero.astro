---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ServiceCard from '../serviziCards/ServiceCard.astro';
import ServiceLauncher from '../serviziCards/ServiceLauncher.astro';
import Button from '@butik/ui/Button';
import ArrowLink from '@butik/ui/ArrowLink';

import imgA from '../../assets/servizi/template-servizio/gallery-1.jpg';
import imgB from '../../assets/servizi/template-servizio/img-right.jpg';
import imgC from '../../assets/servizi/template-servizio/hero.jpg';
import imgD from '../../assets/servizi/template-servizio/img-block.jpg';
import imgE from '../../assets/servizi/template-servizio/img-left.jpg';
import imgF from '../../assets/servizi/template-servizio/gallery-3.jpg';
import imgG from '../../assets/servizi/template-servizio/gallery-2.jpg';
import imgH from '../../assets/hero-home.jpg';

// ── Background tiles ────────────────────────────────────────────────────
// Mosaico di immagini absolute che coprono tutto lo sfondo dell'hero.
// Posizione/dimensione in % della section, con sovrapposizioni volute.
// Parallax: ogni tile ha vy (verticale) e vx (orizzontale) differenti.
interface BgTile {
  src: ImageMetadata;
  alt: string;
  /** Style inline per posizionamento iniziale (top/left/width/height in %). */
  pos: string;
  /** Velocità parallax: y per scroll verticale, x per drift orizzontale. */
  vy: number;
  vx: number;
}

const bgTiles: BgTile[] = [
  { src: imgC, alt: 'Itinerario turistico-musicale',     pos: 'top:-5%; left:-3%;  width:42%; height:55%;', vy: 0.22, vx:  0.04 },
  { src: imgA, alt: 'Workshop di co-progettazione',      pos: 'top:-8%; left:32%;  width:36%; height:50%;', vy: 0.10, vx: -0.06 },
  { src: imgB, alt: 'Comunità coinvolta',                pos: 'top:-3%; left:62%;  width:42%; height:48%;', vy: 0.28, vx:  0.05 },
  { src: imgE, alt: 'Formazione e capacity building',    pos: 'top:38%; left:-4%;  width:38%; height:60%;', vy: 0.34, vx: -0.03 },
  { src: imgH, alt: 'Evento culturale Butik',            pos: 'top:42%; left:28%;  width:42%; height:55%;', vy: 0.15, vx:  0.05 },
  { src: imgD, alt: 'Concerto e attivazione',            pos: 'top:40%; left:62%;  width:40%; height:58%;', vy: 0.26, vx: -0.04 },
  { src: imgG, alt: 'Percorso di formazione',            pos: 'top:62%; left:8%;   width:32%; height:42%;', vy: 0.40, vx:  0.08 },
  { src: imgF, alt: 'Mappa turistico-musicale',          pos: 'top:65%; left:55%;  width:35%; height:40%;', vy: 0.18, vx: -0.07 },
];

// ── Card servizi (5) ───────────────────────────────────────────────────
// Copy editoriale content-driven (ADR-0004): arriva dalla collezione `pagine`
// (entry `home`) come array, passata da index.astro. Lo slug — che sceglie
// l'icona della card — si ricava dall'href della scheda servizio.
interface ServizioCard {
  title: string;
  href: string;
  description: string;
  statValue: string;
  statLabel: string;
}

// Slideshow mobile: 4-5 immagini di sfondo che ruotano
const mobileBackgrounds = [bgTiles[0], bgTiles[2], bgTiles[4], bgTiles[6]];

interface Props {
  title: string;
  subtitle: string;
  ctaLabel: string;
  ctaHref: string;
  exploreLabel: string;
  exploreHref: string;
  servizi: ServizioCard[];
}
const {
  title,
  subtitle,
  ctaLabel,
  ctaHref,
  exploreLabel,
  exploreHref,
  servizi,
} = Astro.props;

// Presentazione dei servizi nell'hero: card con icona da tablet in su, lista
// compatta da mobile (dove le card non stanno sopra la piega). La scelta è
// puramente CSS — entrambi i blocchi sono nell'HTML, una media query ne mostra
// uno solo — così non serve JS e non c'è sfarfallio all'idratazione.
const serviziItems = servizi.map((s) => ({
  slug: s.href.replace(/^\/servizi\//, '').replace(/\/$/, ''),
  title: s.title,
  desc: s.description,
  href: s.href,
  statValue: s.statValue,
  statLabel: s.statLabel,
}));
---

<section
  class="hero hero-minh"
  data-hero-section
>

  <!-- ── DESKTOP: mosaico full-bleed di immagini con parallax ────────── -->
  <div class="hero-bg-desktop" aria-hidden="true">
    {bgTiles.map((tile, i) => (
      <div
        class="hero-tile"
        style={tile.pos}
        data-tile-vy={tile.vy}
        data-tile-vx={tile.vx}
        data-tile-index={i}
      >
        <Image
          src={tile.src}
          alt=""
          widths={[400, 700, 1000]}
          sizes="(max-width: 768px) 0px, 40vw"
          quality={72}
          loading="eager"
          class="hero-tile-img"
        />
      </div>
    ))}
  </div>

  <!-- ── MOBILE: slideshow di sfondo single-image ────────────────────── -->
  <div class="hero-bg-mobile-wrap" aria-hidden="true">
    {mobileBackgrounds.map((tile, i) => (
      <div
        class:list={[
          'hero-bg-mobile',
          i === 0 ? 'opacity-100' : 'opacity-0',
        ]}
        data-hero-bg-mobile={i}
      >
        <Image
          src={tile.src}
          alt=""
          widths={[480, 768]}
          sizes="100vw"
          quality={70}
          loading={i === 0 ? 'eager' : 'lazy'}
          class="hero-bg-mobile-img"
        />
      </div>
    ))}
  </div>

  <!-- ── Overlay scuro per leggibilità ───────────────────────────────── -->
  <div class="hero-scrim" aria-hidden="true"></div>
  <div class="hero-gradient" aria-hidden="true"></div>

  <!-- ── Contenuto hero ──────────────────────────────────────────────── -->
  <div class="hero-minh hero-content">

    <div class="hero-lead">

      <!-- Titolo + subtitle + CTA primario -->
      <div class="hero-textcol">
        <h1 class="hero-title">
          {title}
        </h1>
        <p class="hero-subtitle">
          {subtitle}
        </p>

        <div class="hero-cta">
          <Button href={ctaHref}>{ctaLabel}</Button>
        </div>
      </div>
    </div>

    <!-- 5 card servizi in basso (1 col mobile, 2 col tablet, 5 col desktop) -->
    <div class="hero-svc-wrap">
      <!-- Da tablet in su: card con icona, una per servizio. -->
      <div class="hero-svc-cards">
        {serviziItems.map((s) => <ServiceCard data={s} />)}
      </div>

      <!-- Da mobile: lista compatta, tutti i servizi sopra la piega. -->
      <div class="hero-svc-list">
        <ServiceLauncher items={serviziItems} tone="onDark" />
      </div>

      <div class="hero-explore">
        <ArrowLink href={exploreHref} tone="invert">{exploreLabel}</ArrowLink>
      </div>
    </div>
  </div>
</section>

<style>
  /* Sezione: sfondo scuro fuori dal flusso normale; -mt-20 recupera lo
     spazio dell'header sticky sopra l'hero. */
  .hero {
    position: relative;
    background-color: var(--color-fg);
    overflow: hidden;
    margin-top: -5rem; /* -mt-20, nessun token spacing a 5rem */
  }

  .hero-content {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .hero-bg-desktop {
    position: absolute;
    inset: 0;
    display: none;
  }
  @media (min-width: 768px) {
    .hero-bg-desktop {
      display: block;
    }
  }

  .hero-bg-mobile-wrap {
    position: absolute;
    inset: 0;
  }
  @media (min-width: 768px) {
    .hero-bg-mobile-wrap {
      display: none;
    }
  }

  .hero-tile-img,
  .hero-bg-mobile-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-scrim {
    position: absolute;
    inset: 0;
    background-color: color-mix(in srgb, var(--color-fg) 55%, transparent);
  }
  @media (min-width: 768px) {
    .hero-scrim {
      background-color: color-mix(in srgb, var(--color-fg) 35%, transparent);
    }
  }
  .hero-gradient {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--color-fg) 30%, transparent),
      transparent,
      color-mix(in srgb, var(--color-fg) 60%, transparent)
    );
  }

  .hero-lead {
    flex: 1 1 0%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    max-width: 80rem; /* max-w-7xl, nessun token */
    margin-inline: auto;
    padding-inline: var(--space-6);
    padding-top: 7rem; /* pt-28, nessun token */
    padding-bottom: var(--space-4);
    width: 100%;
  }
  @media (min-width: 768px) {
    .hero-lead {
      padding-inline: var(--space-8);
      padding-bottom: var(--space-6);
    }
  }

  .hero-textcol {
    position: relative;
    text-align: center;
    max-width: 56rem; /* max-w-4xl, nessun token */
    margin-inline: auto;
  }

  .hero-title {
    position: relative;
    font-family: var(--font-heading);
    font-size: var(--text-4xl);
    font-weight: 700;
    line-height: 1.05; /* leading-[1.05] vince su text-4xl/5xl/6xl */
  }
  @media (min-width: 768px) {
    .hero-title {
      font-size: var(--text-5xl);
    }
  }
  @media (min-width: 1024px) {
    .hero-title {
      font-size: var(--text-6xl);
    }
  }

  .hero-subtitle {
    position: relative;
    font-family: var(--font-sans);
    font-size: var(--font-size-base);
    line-height: calc(1.5 / 1); /* line-height che text-base porta con sé */
    margin-top: 1.25rem; /* mt-5, nessun token */
    max-width: 42rem; /* max-w-2xl, nessun token */
    margin-inline: auto;
  }
  @media (min-width: 768px) {
    .hero-subtitle {
      font-size: var(--font-size-lg);
      line-height: calc(1.75 / 1.125); /* line-height che text-lg porta con sé */
    }
  }

  .hero-cta {
    position: relative;
    margin-top: var(--space-8);
  }

  /* ── Altezza adattiva (issue #7) ──────────────────────────────────────
     Hero a tutta altezza (82vh) solo quando il viewport è abbastanza alto.
     Su viewport bassi (≤760px) il contenuto da solo riempirebbe lo schermo,
     spingendo la striscia partner sotto la fold: qui compattiamo padding,
     titolo e spaziature così i partner risalgono verso la fold. */
  @media (min-width: 768px) {
    .hero-minh {
      min-height: 82vh;
    }
  }
  @media (min-width: 768px) and (max-height: 760px) {
    .hero-minh {
      min-height: 0;
    }
    .hero-lead {
      padding-top: 5.5rem; /* respiro sotto l'header, senza riempire lo schermo */
      padding-bottom: 1.5rem; /* aria tra il bottone CTA e le card */
    }
    .hero-title {
      font-size: 2rem;
      line-height: 1.05;
    }
    .hero-subtitle {
      margin-top: 0.6rem;
    }
    .hero-cta {
      margin-top: 1rem;
    }
  }

  .hero-title,
  .hero-subtitle {
    color: #ffffff;
    text-shadow: 0 2px 20px rgba(7, 17, 8, 0.6);
  }
  .hero-subtitle {
    opacity: 0.95;
  }

  .hero-svc-wrap {
    position: relative;
    max-width: 80rem; /* max-w-7xl, nessun token */
    margin-inline: auto;
    padding-inline: var(--space-6);
    padding-bottom: var(--space-6);
    width: 100%;
  }
  @media (min-width: 768px) {
    .hero-svc-wrap {
      padding-inline: var(--space-8);
      padding-bottom: var(--space-8);
    }
  }

  /* Scelta della presentazione dei servizi: pura CSS, nessun JS.
     Sotto i 640px vince la lista compatta; da lì in su le card con icona. */
  .hero-svc-cards {
    display: none;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: var(--space-3);
  }
  @media (min-width: 640px) {
    .hero-svc-cards {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .hero-svc-list {
      display: none;
    }
  }
  @media (min-width: 768px) {
    .hero-svc-cards {
      gap: var(--space-4);
    }
  }
  @media (min-width: 1024px) {
    .hero-svc-cards {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }

  .hero-svc-list {
    background-color: color-mix(in srgb, var(--color-white) 5%, transparent);
    backdrop-filter: blur(8px); /* backdrop-blur-sm, nessun token blur in ui-tokens */
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid color-mix(in srgb, var(--color-white) 15%, transparent);
    padding-inline: var(--space-4);
    padding-block: var(--space-1);
    /* rounded-lg NON vale i .5rem di default di Tailwind: @butik/ui-tokens
       ridefinisce --radius-lg su :root a 1rem, e la utility legge quella. */
    border-radius: var(--radius-lg);
  }

  .hero-explore {
    text-align: center;
    margin-top: var(--space-4);
  }
  @media (min-width: 768px) {
    .hero-explore {
      margin-top: 1.25rem; /* mt-5, nessun token */
    }
  }

  .hero-tile {
    position: absolute;
    will-change: transform;
    overflow: hidden;
    transition: transform 100ms linear;
    opacity: 0.92;
    /* Mask radiale ampio e molto progressivo: la zona opaca è ampia (immagini
       ben visibili al centro di ciascuna tile) e il fade ai bordi attraversa
       5 stop in maniera "atmosferica" senza salti di luminanza percepibili.
       Niente blur né border-radius: il mask basta a evitare bordi netti. */
    -webkit-mask-image: radial-gradient(
      ellipse 95% 95% at center,
      #000 5%,
      rgba(0, 0, 0, 0.92) 30%,
      rgba(0, 0, 0, 0.6) 55%,
      rgba(0, 0, 0, 0.25) 78%,
      transparent 100%
    );
    mask-image: radial-gradient(
      ellipse 95% 95% at center,
      #000 5%,
      rgba(0, 0, 0, 0.92) 30%,
      rgba(0, 0, 0, 0.6) 55%,
      rgba(0, 0, 0, 0.25) 78%,
      transparent 100%
    );
  }

  .hero-bg-mobile {
    position: absolute;
    inset: 0;
    transition: opacity 1000ms ease-in-out;
  }
  /* opacity-100/opacity-0 restano nomi letterali (non semantici): lo <script>
     sotto le referenzia per stringa via classList.replace nello slideshow. */
  .opacity-100 {
    opacity: 1;
  }
  .opacity-0 {
    opacity: 0;
  }
</style>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const desktopMQ = window.matchMedia('(min-width: 768px)');

  // ── 1. Mobile slideshow (cross-fade ogni 5s) ───────────────────────────
  const mobileBgs = Array.from(
    document.querySelectorAll<HTMLElement>('.hero-bg-mobile[data-hero-bg-mobile]')
  );
  if (mobileBgs.length > 1 && !reducedMotion) {
    let current = 0;
    setInterval(() => {
      mobileBgs[current].classList.replace('opacity-100', 'opacity-0');
      current = (current + 1) % mobileBgs.length;
      mobileBgs[current].classList.replace('opacity-0', 'opacity-100');
    }, 5000);
  }

  // ── 2. Parallax desktop (translate X+Y per ogni tile) ──────────────────
  const tiles = Array.from(
    document.querySelectorAll<HTMLElement>('.hero-tile[data-tile-index]')
  );
  const heroSection = document.querySelector<HTMLElement>('[data-hero-section]');

  let ticking = false;
  const updateParallax = () => {
    if (!heroSection || !desktopMQ.matches || reducedMotion) {
      tiles.forEach((t) => { t.style.transform = ''; });
      ticking = false;
      return;
    }
    const rect = heroSection.getBoundingClientRect();
    if (rect.bottom < -50 || rect.top > window.innerHeight + 50) {
      ticking = false;
      return;
    }
    const progress = -rect.top; // px scrollati dentro l'hero
    tiles.forEach((tile) => {
      const vy = parseFloat(tile.dataset.tileVy || '0');
      const vx = parseFloat(tile.dataset.tileVx || '0');
      const ty = (progress * vy).toFixed(2);
      const tx = (progress * vx).toFixed(2);
      tile.style.transform = `translate3d(${tx}px, ${ty}px, 0)`;
    });
    ticking = false;
  };

  const onScroll = () => {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(updateParallax);
    }
  };

  if (heroSection && tiles.length) {
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    updateParallax();
  }
</script>
