---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ServiceCard from '../serviziCards/ServiceCard.astro';
import ServiceLauncher from '../serviziCards/ServiceLauncher.astro';
import Button from '@butik/ui/Button';
import ArrowLink from '@butik/ui/ArrowLink';
import Underline from '@butik/ui/Underline';

import { imageSize } from '#lib/media';

// ── Foto di sfondo ──────────────────────────────────────────────────────
// Foto a tutto sfondo da Sanity (pagina home), in loop con dissolvenza
// incrociata, solo CSS. Ogni foto resta `SLIDE_S` secondi, di cui `FADE_S`
// di dissolvenza sulla successiva. Le percentuali dei keyframes dipendono dal
// numero di foto, per questo il blocco @keyframes è generato qui sotto.
const SLIDE_S = 7;
const FADE_S = 1.5;

// ── Card servizi (5) ───────────────────────────────────────────────────
// Copy editoriale content-driven (ADR-0004): la card di ciascun documento
// servizio (Sanity), passata da index.astro. Lo slug — che sceglie
// l'icona della card — si ricava dall'href della scheda servizio.
interface ServizioCard {
  title: string;
  href: string;
  description: string;
  statValue: string;
  statLabel: string;
}

interface Props {
  images: { src: string; alt: string }[];
  title: string;
  subtitle: string;
  ctaLabel: string;
  ctaHref: string;
  exploreLabel: string;
  exploreHref: string;
  servizi: ServizioCard[];
}
const {
  images,
  title,
  subtitle,
  ctaLabel,
  ctaHref,
  exploreLabel,
  exploreHref,
  servizi,
} = Astro.props;

// Ciclo: la foto i è piena nella sua finestra [0, p], sfuma in [p, p+f] e
// rientra in [100-f, 100], mentre la precedente (sotto) è ancora piena.
// Il ritardo negativo mette ogni foto nella sua fase già al primo frame.
const n = images.length;
const cycle = n * SLIDE_S;
const p = 100 / n;
const f = (100 * FADE_S) / cycle;
const pct = (v: number) => `${+v.toFixed(3)}%`;
const keyframes =
  n > 1
    ? `@keyframes hero-xfade{0%,${pct(p)}{opacity:1}${pct(p + f)},${pct(100 - f)}{opacity:0}100%{opacity:1}}`
    : '';
// Nello style solo durata e ritardo: l'animazione è nel CSS, dove la pausa
// (animation-play-state) può fermarla. Con una foto sola le variabili non ci
// sono e l'animazione non parte.
const slideStyle = (i: number) =>
  n > 1
    ? `--xfade-durata: ${cycle}s; --xfade-ritardo: ${i === 0 ? 0 : -(n - i) * SLIDE_S}s;`
    : undefined;

// Accento tipografico: l'ultima parola del titolo sottolineata, disegnata al
// caricamento solo con CSS (nessuna idratazione: il titolo è già in vista).
const cut = title.lastIndexOf(' ');
const [titleHead, titleLast] = cut === -1 ? ['', title] : [title.slice(0, cut + 1), title.slice(cut + 1)];

// Presentazione dei servizi nell'hero: card con icona da tablet in su, lista
// compatta da mobile (dove le card non stanno sopra la piega). La scelta è
// puramente CSS — entrambi i blocchi sono nell'HTML, una media query ne mostra
// uno solo — così non serve JS e non c'è sfarfallio all'idratazione.
const serviziItems = servizi.map((s) => ({
  slug: s.href.replace(/^\/servizi\//, '').replace(/\/$/, ''),
  title: s.title,
  desc: s.description,
  href: s.href,
  statValue: s.statValue,
  statLabel: s.statLabel,
}));
---

<section
  class="hero hero-minh"
  data-hero-section
  data-hero
>

  <!-- ── Foto di sfondo in loop (decorative: il contenuto è nel testo) ── -->
  {keyframes && <style is:inline set:html={keyframes} />}
  <div class="hero-slides" aria-hidden="true" data-assesta>
    {images.map((img, i) => (
      <Image
        src={img.src}
        {...imageSize(img.src)}
        alt=""
        widths={[768, 1280, 1920, 2560]}
        sizes="100vw"
        quality={72}
        loading={i === 0 ? 'eager' : 'lazy'}
        fetchpriority={i === 0 ? 'high' : 'auto'}
        class="hero-slide"
        style={slideStyle(i)}
      />
    ))}
  </div>

  <!-- ── Overlay scuro per leggibilità ───────────────────────────────── -->
  <div class="hero-scrim" aria-hidden="true"></div>
  <div class="hero-gradient" aria-hidden="true"></div>

  <!-- ── Contenuto hero ──────────────────────────────────────────────── -->
  <div class="hero-minh hero-content">

    <div class="hero-lead">

      <!-- Titolo + subtitle + CTA primario -->
      <div class="hero-textcol">
        <h1 class="hero-title" data-battito style="--ritardo: 150ms">
          {titleHead}<Underline tone="accent">{titleLast}</Underline>
        </h1>
        <p class="hero-subtitle" data-battito style="--ritardo: 270ms">
          {subtitle}
        </p>

        <div class="hero-cta" data-battito style="--ritardo: 390ms">
          <Button href={ctaHref} tone="invert">{ctaLabel}</Button>
        </div>
      </div>
    </div>

    <!-- 5 card servizi in basso (1 col mobile, 2 col tablet, 5 col desktop) -->
    <div class="hero-svc-wrap">
      <!-- Da tablet in su: card con icona, una per servizio. -->
      <div class="hero-svc-cards">
        {serviziItems.map((s) => <ServiceCard data={s} />)}
      </div>

      <!-- Da mobile: lista compatta, tutti i servizi sopra la piega. -->
      <div class="hero-svc-list">
        <ServiceLauncher items={serviziItems} />
      </div>

      <div class="hero-explore">
        <ArrowLink href={exploreHref} tone="invert">{exploreLabel}</ArrowLink>
      </div>
    </div>
  </div>
</section>

<style>
  /* Sezione: sfondo scuro fuori dal flusso normale; -mt-20 recupera lo
     spazio dell'header sticky sopra l'hero. */
  .hero {
    position: relative;
    background-color: var(--color-bg-invert);
    overflow: hidden;
    /* Risale sotto tutto l'header: 5rem più il suo bordo inferiore di 1px (con
       solo -5rem restava in cima una riga di 1px con lo sfondo chiaro). */
    margin-top: calc(-5rem - 1px);
  }

  .hero-content {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .hero-slides {
    position: absolute;
    inset: 0;
  }
  .hero-slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    animation: hero-xfade var(--xfade-durata) linear var(--xfade-ritardo) infinite;
  }
  /* Senza animazione (reduced-motion, o una sola foto) resta la prima. */
  .hero-slide:first-child {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-slide {
      animation: none !important;
    }
  }
  /* Il loop si ferma (WCAG 2.2.2), come il marquee dei partner: con il fuoco
     da tastiera dentro l'hero, e con un tocco o un click sulla foto fuori da
     link e pulsanti (data-paused, vedi script; il successivo lo riavvia).
     Niente pausa all'hover, a differenza del marquee: l'hero occupa lo
     schermo e il puntatore ci sta sopra quasi sempre, il loop non girerebbe. */
  .hero:focus-within .hero-slide,
  .hero[data-paused='true'] .hero-slide {
    animation-play-state: paused;
  }

  .hero-scrim {
    position: absolute;
    inset: 0;
    /* Velo tarato su foto a tutto sfondo (AA per titolo e card sopra). */
    background-color: color-mix(in srgb, var(--color-fg) 60%, transparent);
  }
  .hero-gradient {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--color-fg) 30%, transparent),
      transparent,
      color-mix(in srgb, var(--color-fg) 60%, transparent)
    );
  }

  .hero-lead {
    flex: 1 1 0%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--space-6);
    padding-top: var(--space-28);
    padding-bottom: var(--space-4);
    width: 100%;
  }
  @media (min-width: 768px) {
    .hero-lead {
      padding-inline: var(--space-8);
      padding-bottom: var(--space-6);
    }
  }

  .hero-textcol {
    position: relative;
    text-align: center;
    max-width: var(--measure-4xl);
    margin-inline: auto;
  }

  .hero-title {
    position: relative;
    font-family: var(--font-heading);
    font-size: var(--text-4xl);
    font-weight: 700;
    line-height: 1.05; /* leading-[1.05] vince su text-4xl/5xl/6xl */
  }
  @media (min-width: 768px) {
    .hero-title {
      font-size: var(--text-5xl);
    }
  }
  @media (min-width: 1024px) {
    .hero-title {
      font-size: var(--text-6xl);
    }
  }

  .hero-subtitle {
    position: relative;
    font-family: var(--font-sans);
    font-size: var(--font-size-base);
    line-height: calc(1.5 / 1); /* line-height che text-base porta con sé */
    margin-top: var(--space-5);
    max-width: var(--measure-2xl);
    margin-inline: auto;
  }
  @media (min-width: 768px) {
    .hero-subtitle {
      font-size: var(--font-size-lg);
      line-height: calc(1.75 / 1.125); /* line-height che text-lg porta con sé */
    }
  }

  .hero-cta {
    position: relative;
    margin-top: var(--space-8);
  }

  /* ── Altezza adattiva (issue #7) ──────────────────────────────────────
     Hero a tutta altezza (82vh) solo quando il viewport è abbastanza alto.
     Su viewport bassi (≤760px) il contenuto da solo riempirebbe lo schermo,
     spingendo la striscia partner sotto la fold: qui compattiamo padding,
     titolo e spaziature così i partner risalgono verso la fold. */
  @media (min-width: 768px) {
    .hero-minh {
      min-height: 82vh;
    }
  }
  @media (min-width: 768px) and (max-height: 760px) {
    .hero-minh {
      min-height: 0;
    }
    .hero-lead {
      padding-top: 5.5rem; /* respiro sotto l'header, senza riempire lo schermo */
      padding-bottom: var(--space-6); /* aria tra il bottone CTA e le card */
    }
    .hero-title {
      font-size: 2rem; /* fra --font-size-xl e --font-size-2xl: taglia dell'hero su mobile */
      line-height: 1.05;
    }
    .hero-subtitle {
      margin-top: var(--space-2-5);
    }
    .hero-cta {
      margin-top: var(--space-4);
    }
  }

  .hero-title,
  .hero-subtitle {
    color: var(--color-fg-invert);
    text-shadow: 0 2px 20px color-mix(in srgb, var(--color-fg) 60%, transparent);
  }

  .hero-svc-wrap {
    position: relative;
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--space-6);
    padding-bottom: var(--space-6);
    width: 100%;
  }
  @media (min-width: 768px) {
    .hero-svc-wrap {
      padding-inline: var(--space-8);
      padding-bottom: var(--space-8);
    }
  }

  /* Scelta della presentazione dei servizi: pura CSS, nessun JS.
     Sotto i 640px vince la lista compatta; da lì in su le card con icona. */
  .hero-svc-cards {
    display: none;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: var(--space-3);
  }
  @media (min-width: 640px) {
    .hero-svc-cards {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .hero-svc-list {
      display: none;
    }
  }
  @media (min-width: 768px) {
    .hero-svc-cards {
      gap: var(--space-4);
    }
  }
  @media (min-width: 1024px) {
    .hero-svc-cards {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }

  /* Vetro scuro come le card di ServiceCard: il contrasto delle righe lo dà
     la lista, non il punto del gradiente dell'hero in cui cade. */
  .hero-svc-list {
    background-color: color-mix(in srgb, var(--color-bg-invert) 35%, transparent);
    backdrop-filter: blur(var(--blur-glass));
    -webkit-backdrop-filter: blur(var(--blur-glass));
    border: 1px solid color-mix(in srgb, var(--color-fg-invert) 15%, transparent);
    padding-inline: var(--space-4);
    padding-block: var(--space-1);
    /* rounded-lg NON vale i .5rem di default di Tailwind: @butik/ui-tokens
       ridefinisce --radius-lg su :root a 1rem, e la utility legge quella. */
    border-radius: var(--radius-lg);
  }

  .hero-explore {
    text-align: center;
    margin-top: var(--space-4);
  }
  @media (min-width: 768px) {
    .hero-explore {
      margin-top: var(--space-5);
    }
  }

  /* ── Entrata al caricamento (direzione "ritmo musicale", vedi
     styles/motion.css): la foto si assesta, titolo, sottotitolo e pulsante
     salgono con il rimbalzo (data-battito, data-assesta), poi le card, una
     dopo l'altra, come barre di un equalizzatore.
     A tempo dal caricamento: l'hero è già in vista. Le card sono di ServiceCard:
     il selettore dei figli è :global, lo scope di Hero non le raggiunge. */
  @keyframes hero-in-dissolvi {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes hero-in-scivola {
    0% { opacity: 0; transform: translateX(-20px); }
    60% { opacity: 1; transform: translateX(3px); }
    100% { opacity: 1; transform: none; }
  }
  @keyframes hero-in-battito {
    0% { opacity: 0; transform: scaleY(0.3); }
    60% { opacity: 1; transform: scaleY(1.08); }
    100% { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: no-preference) {
    /* Titolo, sottotitolo e pulsante: data-battito (styles/motion.css). */
    .hero-explore {
      animation: hero-in-dissolvi var(--duration-enter) var(--ease-out) backwards;
    }
    /* 560 e 520ms: accordati a mano con i ritardi della sequenza d'ingresso. */
    .hero-svc-cards > :global(*) {
      transform-origin: bottom;
      animation: hero-in-battito 560ms var(--ease-bounce) 520ms backwards;
    }
    /* Mobile: il riquadro compare in dissolvenza e le righe entrano una dopo
       l'altra scivolando da sinistra (le righe sono di ServiceLauncher). */
    .hero-svc-list {
      animation: hero-in-dissolvi var(--duration-slower) var(--ease-out) 450ms backwards;
    }
    .hero-svc-list :global(li) {
      animation: hero-in-scivola 520ms var(--ease-bounce) 550ms backwards;
    }
    .hero-svc-list :global(li:nth-child(2)) { animation-delay: 640ms; }
    .hero-svc-list :global(li:nth-child(3)) { animation-delay: 730ms; }
    .hero-svc-list :global(li:nth-child(4)) { animation-delay: 820ms; }
    .hero-svc-list :global(li:nth-child(5)) { animation-delay: 910ms; }
    .hero-svc-cards > :global(:nth-child(2)) { animation-delay: 640ms; }
    .hero-svc-cards > :global(:nth-child(3)) { animation-delay: 760ms; }
    .hero-svc-cards > :global(:nth-child(4)) { animation-delay: 880ms; }
    .hero-svc-cards > :global(:nth-child(5)) { animation-delay: 1000ms; }
    .hero-explore { animation-delay: 1150ms; }
    /* Home già vista nella sessione (data-entrata-saltata su <html>, vedi
       BaseLayout): card, righe e link sono già al loro posto. */
    :global([data-entrata-saltata]) .hero-explore,
    :global([data-entrata-saltata]) .hero-svc-list,
    :global([data-entrata-saltata]) .hero-svc-list :global(li),
    :global([data-entrata-saltata]) .hero-svc-cards > :global(*) {
      animation: none;
    }
  }
</style>

<script>
  // Pausa del loop delle foto con un tocco o un click sull'hero, ripresa con
  // il successivo (lo stato è in data-paused, lo stile nel CSS qui sopra). I
  // tocchi su link e pulsanti restano loro, come le selezioni di testo. Il ClientRouter rimpiazza l'hero a
  // ogni navigazione: si aggancia di nuovo su astro:page-load, e il flag
  // evita un secondo ascoltatore sullo stesso nodo.
  function initHeroPausa() {
    const hero = document.querySelector<HTMLElement>('[data-hero-section]');
    if (!hero || hero.dataset.pausaPronta) return;
    hero.dataset.pausaPronta = 'true';
    hero.addEventListener('click', (e) => {
      if ((e.target as Element).closest('a, button')) return;
      // Chi seleziona il testo del titolo non sta chiedendo una pausa.
      if (window.getSelection()?.toString()) return;
      hero.dataset.paused = hero.dataset.paused === 'true' ? 'false' : 'true';
    });
  }

  document.addEventListener('astro:page-load', initHeroPausa);
</script>
