---
// Copy content-driven (ADR-0004): testo e label arrivano dalla collezione
// `pagine` (entry `home`), passati da index.astro. L'immagine viene da Sanity;
// senza, resta l'asset locale.
import { Image } from 'astro:assets';
import Button from '@butik/ui/Button';

import heroHome from '../../assets/hero-home.jpg';
import { imageSize } from '#lib/media';

interface Props {
  title: string;
  p1: string;
  p2: string;
  p3: string;
  ctaLabel: string;
  ctaHref: string;
  image?: string;
  imageAlt: string;
}

const { title, p1, p2, p3, ctaLabel, ctaHref, image = heroHome, imageAlt } = Astro.props;
---

<section class="about-inline">
  <div class="about-container">
    <div class="about-grid" data-reveal-group>
      <div class="about-copy">
        <h2 class="about-title">
          {title}
        </h2>

        <p class="about-paragraph">
          {p1}
        </p>

        <p class="about-paragraph">
          {p2}
        </p>

        <p class="about-paragraph">
          {p3}
        </p>

        <div class="about-cta">
          <Button href={ctaHref} tone="dark">{ctaLabel}</Button>
        </div>
      </div>

      <div class="about-media">
        <Image
          src={image}
          {...imageSize(image)}
          alt={imageAlt}
          widths={[400, 700, 1000]}
          sizes="(max-width: 768px) 100vw, 50vw"
          quality={75}
          class="about-image"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .about-inline {
    padding-top: var(--space-12);
    padding-bottom: var(--space-12);
  }
  @media (min-width: 768px) {
    .about-inline {
      padding-top: var(--space-16);
      padding-bottom: var(--space-16);
    }
  }

  .about-container {
    max-width: var(--container-max);
    margin-left: auto;
    margin-right: auto;
    padding-left: var(--space-6);
    padding-right: var(--space-6);
  }

  .about-grid {
    display: grid;
    align-items: center;
    gap: var(--space-8);
  }
  @media (min-width: 768px) {
    .about-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-12);
    }
  }

  .about-copy {
    order: 2;
  }
  @media (min-width: 768px) {
    .about-copy {
      order: 1;
    }
  }

  .about-title {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    font-weight: 700;
    color: var(--color-fg);
    line-height: 1.25; /* leading-tight */
    margin-bottom: var(--space-6);
  }
  @media (min-width: 768px) {
    .about-title {
      font-size: var(--text-4xl);
    }
  }
  @media (min-width: 1024px) {
    .about-title {
      font-size: var(--text-5xl);
    }
  }

  .about-paragraph {
    font-family: var(--font-sans);
    font-size: var(--font-size-base);
    color: color-mix(in srgb, var(--color-fg) 80%, transparent);
    line-height: 1.625; /* leading-relaxed vince su text-base */
    margin-bottom: var(--space-4);
  }
  .about-paragraph:last-of-type {
    margin-bottom: 0;
  }

  /* La CTA è un Button (PDR-0001, PDR-0005). Il contenitore ne decide lo
     scarto e la larghezza: piena su mobile (la colonna stira il figlio),
     naturale da tablet in su. */
  .about-cta {
    display: flex;
    flex-direction: column;
    margin-top: var(--space-8);
  }
  @media (min-width: 768px) {
    .about-cta {
      display: block;
    }
  }

  .about-media {
    order: 1;
  }
  @media (min-width: 768px) {
    .about-media {
      order: 2;
    }
  }

  .about-image {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  @media (min-width: 768px) {
    .about-image {
      aspect-ratio: 1 / 1;
    }
  }
</style>
