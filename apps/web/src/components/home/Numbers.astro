---
// Copy content-driven (ADR-0004): metriche e label arrivano dalla collezione
// `pagine` (entry `home`) come array, passate da index.astro.
//
// Una riga sola: i numeri di butik e, per ultimo, il dato più forte della
// Milano Music Week (l'ultima voce di `mmwMetrics`), evidenziato. I numeri
// contano da zero mentre la sezione entra in vista: solo CSS (contatore su
// una custom property animata con una view timeline), nessuna isola da
// idratare. Dove la view timeline non c'è, o con reduced-motion, il numero
// compare fermo al valore finale.
type Metric = {
  value: string;
  label: string;
};

interface Props {
  butikMetrics: Metric[];
  mmwLabel: string;
  mmwMetrics: Metric[];
}

const { butikMetrics, mmwLabel, mmwMetrics } = Astro.props;
const mmw = mmwMetrics.at(-1);

/** "30+" → { n: 30, suffix: '+' }; "70K+" → { n: 70, suffix: 'K+' }. */
const parse = (value: string) => {
  const m = value.match(/^(\d+)(.*)$/);
  return m ? { n: Number(m[1]), suffix: m[2] } : undefined;
};

const items = [
  ...butikMetrics.map((m) => ({ ...m, eyebrow: undefined as string | undefined })),
  ...(mmw ? [{ ...mmw, eyebrow: mmwLabel }] : []),
].map((m) => ({ ...m, count: parse(m.value) }));
---

<section class="numbers" aria-label="Numeri e impatto">
  <dl class="numbers-grid">
    {
      items.map((m) => (
        <div class:list={['metric', { 'metric--mmw': m.eyebrow }]}>
          <dt class="sr-only">{m.eyebrow ? `${m.label} — ${m.eyebrow}` : m.label}</dt>
          <dd>
            {m.eyebrow && <span class="metric-eyebrow" aria-hidden="true">{m.eyebrow}</span>}
            <span class="metric-value">
              {/* Tutto su una riga: niente spazi fra numero e suffisso. */}
              {m.count ? (
                <><span class="metric-num">{m.count.n}</span><span class="metric-count" aria-hidden="true" style={`--to: ${m.count.n}`} />{m.count.suffix}</>
              ) : (
                m.value
              )}
            </span>
            <span class="metric-label" aria-hidden="true">{m.label}</span>
          </dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .numbers {
    background-color: var(--color-bg-invert);
    color: var(--color-fg-invert);
    padding-block: var(--space-12);
  }

  .numbers-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-8) var(--space-6);
    align-items: start;
    max-width: 80rem; /* come l'hero: nessun token per le larghezze massime */
    margin-inline: auto;
    padding-inline: var(--space-6);
  }
  @media (min-width: 640px) {
    .numbers-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .numbers-grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
  }

  /* Il dato della Milano Music Week: separato da una linea d'accento. Fino
     al tablet occupa una riga tutta sua; su desktop sta nella fila e il nome
     dell'evento sale sopra il numero, fuori dal flusso, così i numeri restano
     tutti alla stessa altezza. */
  .metric--mmw {
    grid-column: 1 / -1;
    position: relative;
    padding-left: var(--space-4);
    border-left: 2px solid var(--color-accent);
  }
  @media (min-width: 1024px) {
    .metric--mmw {
      grid-column: auto;
    }
    .metric--mmw .metric-eyebrow {
      position: absolute;
      top: 0;
      transform: translateY(calc(-100% - var(--space-2)));
      margin: 0;
    }
  }

  /* Solo per i lettori di schermo (stesso pattern di ImageCarousel). */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  /* Senza animazione il numero vero resta visibile e il contatore sparisce. */
  .metric-count {
    display: none;
  }

  .metric-eyebrow {
    display: block;
    margin-bottom: var(--space-2);
    font-family: var(--font-display);
    font-size: var(--font-size-xs);
    font-weight: 700;
    letter-spacing: 0.1em; /* come le etichette del sito */
    text-transform: uppercase;
    color: var(--color-highlight);
  }

  .metric-value {
    display: block;
    font-family: var(--font-heading);
    /* Scala dei numeri d'impatto: nessun token combacia col clamp. */
    font-size: clamp(2.2rem, 1.4rem + 3.4vw, 3rem);
    font-weight: 900;
    line-height: 1;
    color: var(--color-highlight);
    font-variant-numeric: tabular-nums;
  }

  .metric-label {
    display: block;
    margin-top: var(--space-2);
    font-family: var(--font-sans);
    font-size: var(--font-size-sm);
    line-height: 1.375;
    color: color-mix(in srgb, var(--color-fg-invert) 80%, transparent);
  }

  /* ── Conteggio all'ingresso ───────────────────────────────────────────
     --n è un intero registrato: animandolo da 0 a --to e mostrandolo con
     counter() il numero "sale". La view timeline lega l'avanzamento alla
     sezione che entra in vista; il numero vero passa ai soli lettori di
     schermo, il contatore è aria-hidden. */
  @property --n {
    syntax: '<integer>';
    initial-value: 0;
    inherits: false;
  }
  @keyframes conta {
    from {
      --n: 0;
    }
    to {
      --n: var(--to);
    }
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .metric-num {
        position: absolute;
        width: 1px;
        height: 1px;
        margin: -1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
      }
      .metric-count {
        display: inline;
        counter-reset: n var(--n);
        animation: conta linear both;
        animation-timeline: view();
        animation-range: entry 20% cover 45%;
      }
      .metric-count::after {
        content: counter(n);
      }
    }
  }
</style>
