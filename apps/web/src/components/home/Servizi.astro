---
import { Image } from 'astro:assets';
import heroImg from '../../assets/servizi/template-servizio/hero.jpg';
import gallery1 from '../../assets/servizi/template-servizio/gallery-1.jpg';
import gallery2 from '../../assets/servizi/template-servizio/gallery-2.jpg';
import gallery3 from '../../assets/servizi/template-servizio/gallery-3.jpg';
import imgBlock from '../../assets/servizi/template-servizio/img-block.jpg';
import SectionHeading from '@butik/ui/SectionHeading';

interface ServizioCard {
  title: string;
  href: string;
  description: string;
  image: ImageMetadata;
  imageAlt: string;
}

const servizi: ServizioCard[] = [
  {
    title: 'Progettazione culturale',
    href: '/servizi/progettazione-culturale',
    description: 'Ideiamo progetti culturali per attivare territori e nuove generazioni.',
    image: heroImg,
    imageAlt: 'Progettazione culturale su base musicale',
  },
  {
    title: 'Consulenza strategica',
    href: '/servizi/consulenza-strategica',
    description: 'Trasformiamo il patrimonio musicale locale in asset culturale e turistico.',
    image: gallery1,
    imageAlt: 'Consulenza strategica per Comuni e DMO',
  },
  {
    title: 'Formazione',
    href: '/servizi/formazione-capacity-building',
    description: 'Percorsi formativi immersivi per operatori e giovani professionisti.',
    image: gallery2,
    imageAlt: 'Percorso di formazione e capacity building',
  },
  {
    title: 'Eventi e format',
    href: '/servizi/eventi-culturali-musicali',
    description: 'Eventi e format che usano la musica come strumento di attivazione territoriale.',
    image: gallery3,
    imageAlt: 'Ideazione e realizzazione di eventi musicali',
  },
  {
    title: 'Turismo musicale',
    href: '/servizi/prodotti-turistico-musicali',
    description: 'Prodotti turistici, itinerari e materiali editoriali su base musicale.',
    image: imgBlock,
    imageAlt: 'Prodotti e itinerari di turismo musicale',
  },
];
---

<section class="servizi-section">
  <div class="servizi-container">
    <div class="servizi-heading">
      <SectionHeading eyebrow="Servizi" title="Cosa facciamo" />
    </div>

    <div class="servizi-grid">
      {servizi.map((servizio, index) => (
        <a
          href={servizio.href}
          class:list={[
            'servizi-card',
            index === 0 && 'servizi-card--first',
          ]}
        >
          <div class="servizi-card-media">
            <Image
              src={servizio.image}
              alt={servizio.imageAlt}
              class="servizi-card-image"
              widths={[200, 320, 480]}
              sizes="(min-width: 1024px) 230px, (min-width: 768px) 128px, 100vw"
              quality={70}
              loading={index < 4 ? 'eager' : 'lazy'}
            />
          </div>

          <div class="servizi-card-body">
            <h3 class="servizi-card-title">
              {servizio.title}
            </h3>
            <p class="servizi-card-desc">
              {servizio.description}
            </p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .servizi-section {
    /* bg-gradient-to-b from-butik-light via-white to-butik-light */
    background: linear-gradient(to bottom, var(--color-bg), var(--color-white), var(--color-bg));
  }

  .servizi-container {
    max-width: 80rem; /* max-w-7xl, nessun token (stesso letterale di Header.astro) */
    margin-inline: auto;
    padding-inline: var(--space-6); /* px-6 = 1.5rem */
    padding-block: var(--space-16); /* py-16 = 4rem */
  }
  @media (min-width: 768px) {
    .servizi-container {
      padding-block: var(--space-24); /* py-24 = 6rem */
    }
  }

  .servizi-heading {
    text-align: center;
    margin-bottom: 2.5rem; /* mb-10 = 2.5rem, nessun token */
  }
  @media (min-width: 768px) {
    .servizi-heading {
      margin-bottom: var(--space-12); /* mb-12 = 3rem */
    }
  }

  .servizi-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3); /* gap-3 = 0.75rem */
  }
  @media (min-width: 768px) {
    .servizi-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-4); /* gap-4 = 1rem */
    }
  }
  @media (min-width: 1024px) {
    .servizi-grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }

  .servizi-card {
    position: relative;
    background: var(--color-white);
    border: 1px solid color-mix(in srgb, var(--color-fg) 10%, transparent);
    display: flex;
    flex-direction: column;
    gap: var(--space-3); /* gap-3 = 0.75rem */
    padding: 1.25rem; /* p-5 = 1.25rem, nessun token */
    transition:
      border-color var(--duration-fast) cubic-bezier(0.4, 0, 0.2, 1),
      box-shadow var(--duration-fast) cubic-bezier(0.4, 0, 0.2, 1);
  }
  .servizi-card:hover {
    border-color: color-mix(in srgb, var(--color-fg) 30%, transparent);
    box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1); /* shadow-md, nessun token */
  }
  @media (min-width: 768px) {
    .servizi-card {
      flex-direction: row;
      align-items: center;
      gap: var(--space-6); /* gap-6 = 1.5rem */
      padding: 1.75rem; /* p-7 = 1.75rem, nessun token */
    }
    .servizi-card--first {
      grid-column: span 2 / span 2; /* md:col-span-2 */
    }
  }
  @media (min-width: 1024px) {
    .servizi-card {
      flex-direction: column;
      gap: var(--space-3); /* gap-3 = 0.75rem */
      padding: 1.25rem; /* p-5 = 1.25rem, nessun token */
    }
    .servizi-card--first {
      grid-column: span 1 / span 1; /* lg:col-span-1 */
    }
  }

  .servizi-card-media {
    overflow: hidden;
    background: var(--color-bg);
    aspect-ratio: 16 / 9;
    width: 100%;
  }
  @media (min-width: 768px) {
    .servizi-card-media {
      width: 8rem; /* md:w-32, nessun token */
      height: 8rem; /* md:h-32, nessun token */
      aspect-ratio: 1 / 1;
      flex-shrink: 0;
    }
  }
  @media (min-width: 1024px) {
    .servizi-card-media {
      width: 100%;
      height: auto;
      aspect-ratio: 1 / 1;
    }
  }

  .servizi-card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .servizi-card-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2); /* gap-2 = 0.5rem */
  }
  @media (min-width: 768px) {
    .servizi-card-body {
      flex: 1 1 0%;
    }
  }
  @media (min-width: 1024px) {
    .servizi-card-body {
      flex: none;
    }
  }

  /* text-butik-dark neutralizza il colore rosso dello stile globale h3 (non
     l'uppercase/tracking, che il markup originale non neutralizzava);
     leading-snug vince sul line-height implicito di text-base/xl/lg. */
  .servizi-card-title {
    font-family: var(--font-heading);
    font-size: var(--font-size-base); /* text-base = 1rem */
    font-weight: 700;
    color: var(--color-fg);
    line-height: 1.375; /* leading-snug */
  }
  @media (min-width: 768px) {
    .servizi-card-title {
      font-size: 1.25rem; /* text-xl = 1.25rem, nessun token (--font-size-xl è 1.5rem) */
    }
  }
  @media (min-width: 1024px) {
    .servizi-card-title {
      font-size: var(--font-size-lg); /* text-lg = 1.125rem, combacia con questo token */
    }
  }

  .servizi-card-desc {
    font-family: var(--font-sans);
    font-size: var(--font-size-sm); /* text-sm = 0.875rem */
    color: color-mix(in srgb, var(--color-fg) 70%, transparent);
    line-height: 1.375; /* leading-snug vince sul line-height implicito di text-sm/base */
  }
  @media (min-width: 768px) {
    .servizi-card-desc {
      font-size: var(--font-size-base); /* text-base = 1rem */
    }
  }
  @media (min-width: 1024px) {
    .servizi-card-desc {
      font-size: var(--font-size-sm); /* text-sm = 0.875rem */
    }
  }
</style>
