---
// Testimonianze content-driven via Sitepins (ADR-0004): entry condivisa
// `pagine/testimonials`, riusata identica da home (index.astro) e
// chi-siamo.astro — entrambe passano le stesse props a questo componente.
import SectionHeading from '@butik/ui/SectionHeading';

type Testimonial = {
  rating: number;
  quote: string;
  name: string;
  role: string;
};

interface Props {
  eyebrow: string;
  sectionTitle: string;
  testimonials: Testimonial[];
}

const { eyebrow, sectionTitle, testimonials } = Astro.props;
---

<section class="testimonials-section">
  <div class="testimonials-container">
    <div class="testimonials-heading">
      <SectionHeading eyebrow={eyebrow} title={sectionTitle} />
    </div>

    <div id="testimonials-track">
      {
        testimonials.map((t, i) => (
          <article class="testimonial-card" data-testimonial-index={i}>
            <div class="testimonial-rating" aria-label={`Valutazione: ${t.rating} su 5`}>
              {
                Array.from({ length: t.rating }).map(() => (
                  <svg
                    class="testimonial-rating__star"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.957a1 1 0 00.95.69h4.162c.969 0 1.371 1.24.588 1.81l-3.367 2.446a1 1 0 00-.364 1.118l1.287 3.957c.3.921-.755 1.688-1.54 1.118L10.587 15.6a1 1 0 00-1.175 0l-3.366 2.446c-.784.57-1.838-.197-1.539-1.118l1.287-3.957a1 1 0 00-.364-1.118L2.063 9.384c-.783-.57-.38-1.81.588-1.81h4.162a1 1 0 00.95-.69l1.286-3.957z" />
                  </svg>
                ))
              }
            </div>

            <figure class="testimonial-body">
              <blockquote class="testimonial-quote">
                <p>&ldquo;{t.quote}&rdquo;</p>
              </blockquote>
              <figcaption class="testimonial-meta">
                <p class="testimonial-name">{t.name}</p>
                <p class="testimonial-role">{t.role}</p>
              </figcaption>
            </figure>
          </article>
        ))
      }
    </div>

    {/* role="group" e non "tablist": non ci sono tab né tabpanel: è uno
        scroller con indicatori. Dichiarare tablist senza role="tab",
        aria-selected e pannelli associati è un pattern ARIA rotto (4.1.2).
        Stesso trattamento dei dot di @butik/ui ImageCarousel. */}
    <div
      id="testimonials-dots"
      role="group"
      aria-label="Navigazione testimonianze"
    >
      {
        testimonials.map((_, i) => (
          <button
            type="button"
            class="testimonial-dot"
            data-dot-index={i}
            aria-label={`Vai alla testimonianza ${i + 1}`}
          >
            <span class="testimonial-dot__mark"></span>
          </button>
        ))
      }
    </div>
  </div>
</section>

<script>
  // Rieseguito a ogni astro:page-load: con <ClientRouter /> il modulo gira una
  // volta sola per sessione, ma la view transition sostituisce il DOM — senza
  // re-init i dot restano agganciati a nodi staccati e smettono di funzionare.
  function initTestimonials() {
    const track = document.getElementById('testimonials-track');
    const dots = Array.from(
      document.querySelectorAll<HTMLButtonElement>('#testimonials-dots .testimonial-dot')
    );
    if (!track || !dots.length) return;

    const cards = Array.from(
      track.querySelectorAll<HTMLElement>('[data-testimonial-index]')
    );

    const setActive = (index: number) => {
      dots.forEach((dot, i) => {
        const active = i === index;
        const mark = dot.querySelector('.testimonial-dot__mark');
        mark?.classList.toggle('testimonial-dot__mark--active', active);
        mark?.classList.toggle('testimonial-dot__mark--inactive', !active);
        // Lo stato attivo era veicolato dal solo colore: senza aria-current
        // non arrivava alle tecnologie assistive.
        if (active) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
      });
    };

    setActive(0);

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting && entry.intersectionRatio >= 0.6) {
            const idx = Number(
              (entry.target as HTMLElement).dataset.testimonialIndex
            );
            if (!Number.isNaN(idx)) setActive(idx);
          }
        });
      },
      { root: track, threshold: [0.6] }
    );

    cards.forEach((card) => observer.observe(card));

    // L'observer va sganciato prima che la view transition porti via i nodi:
    // senza, a ogni navigazione ne resta uno che osserva un sottoalbero
    // staccato (vedi docs/guidances/client-scripts.md).
    document.addEventListener(
      'astro:before-swap',
      () => observer.disconnect(),
      { once: true }
    );

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        const card = cards[i];
        if (card) {
          card.scrollIntoView({
            behavior: 'smooth',
            inline: 'start',
            block: 'nearest',
          });
        }
      });
    });
  }

  document.addEventListener('astro:page-load', initTestimonials);
</script>

<style>
  .testimonials-section {
    background-color: var(--color-bg);
    padding-block: var(--space-12);
  }

  .testimonials-container {
    /* Tailwind max-w-7xl: nessun token con questo valore (stesso letterale
       già usato da Header.astro/Footer.astro). */
    max-width: 80rem;
    margin-inline: auto;
    padding-inline: var(--space-6);
  }

  .testimonials-heading {
    margin-bottom: var(--space-8);
  }

  #testimonials-track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    gap: var(--space-4);
    margin-inline: calc(var(--space-6) * -1);
    padding-inline: var(--space-6);
    padding-bottom: var(--space-2);
    scroll-padding-left: var(--space-6);
  }

  .testimonial-card {
    scroll-snap-align: start;
    flex-shrink: 0;
    width: 85%;
    border: 1px solid color-mix(in srgb, var(--color-fg) 15%, transparent);
    padding: var(--space-6);
    background-color: var(--color-white);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .testimonial-rating {
    display: flex;
    gap: var(--space-1);
  }

  .testimonial-rating__star {
    color: var(--color-accent);
    width: var(--space-4);
    height: var(--space-4);
  }

  .testimonial-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    margin: 0;
  }

  .testimonial-quote {
    font-family: var(--font-sans);
    font-size: var(--font-size-base);
    color: var(--color-fg);
    /* leading-relaxed sull'elemento originale vince sul line-height di text-base. */
    line-height: 1.625;
    margin: 0;
  }

  .testimonial-meta {
    margin-top: auto;
  }

  .testimonial-name {
    font-family: var(--font-sans);
    font-size: var(--font-size-sm);
    /* Tailwind text-sm porta con se anche il line-height. */
    line-height: calc(1.25 / 0.875);
    font-weight: 700;
    color: var(--color-fg);
  }

  .testimonial-role {
    font-family: var(--font-sans);
    font-size: var(--font-size-sm);
    /* Tailwind text-sm porta con se anche il line-height. */
    line-height: calc(1.25 / 0.875);
    color: color-mix(in srgb, var(--color-fg) 60%, transparent);
  }

  #testimonials-dots {
    display: flex;
    justify-content: center;
    gap: var(--space-2);
    margin-top: var(--space-6);
  }

  .testimonial-dot {
    width: var(--space-6);
    height: var(--space-6);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .testimonial-dot:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .testimonial-dot__mark {
    width: var(--space-2);
    height: var(--space-2);
    border-radius: var(--radius-full);
    background-color: color-mix(in srgb, var(--color-fg) 55%, transparent);
    /* Tailwind transition-colors: durata = --duration-fast, ma l'easing
       (cubic-bezier(0.4, 0, 0.2, 1)) non coincide con --ease-out del repo. */
    transition: background-color var(--duration-fast) cubic-bezier(0.4, 0, 0.2, 1);
  }

  .testimonial-dot__mark--active {
    background-color: var(--color-accent);
  }

  .testimonial-dot__mark--inactive {
    background-color: color-mix(in srgb, var(--color-fg) 55%, transparent);
  }

  @media (min-width: 768px) {
    .testimonials-section {
      padding-block: var(--space-16);
    }

    .testimonials-heading {
      /* Tailwind mb-10: nessun token --space-* con questo valore. */
      margin-bottom: 2.5rem;
    }

    #testimonials-track {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-6);
      margin-inline: 0;
      padding-inline: 0;
      padding-bottom: 0;
      overflow: visible;
      scroll-padding-left: 0;
    }

    .testimonial-card {
      width: auto;
      flex-shrink: 1;
      padding: var(--space-8);
    }

    #testimonials-dots {
      display: none;
    }
  }
</style>
