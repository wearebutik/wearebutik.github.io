---
/*
 * HeroBanner — wrapper sottile app-side. La presentazione (immagine di
 * sfondo, scrim, titolo, sottotitolo) vive in @butik/ui/HeroBanner,
 * organismo React condiviso (ADR-0008 amendment 2026-07-21). Questo
 * wrapper resta .astro solo per risolvere l'immagine via getImage() —
 * <Image> è un componente Astro-only, non eseguibile dentro un'isola React
 * né in Storybook — e per passare src/srcSet già pronti all'isola.
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import HeroBanner from '@butik/ui/HeroBanner';
import { imageSize, isRemote } from '#lib/media';

interface Props {
  title: string;
  subtitle?: string;
  image: ImageMetadata | string;
  imageAlt?: string;
  transitionName?: string;
  /** Segnaposto sfocato (LQIP, data: URI) finché la foto non arriva. */
  placeholder?: string;
}

const { title, subtitle, image, imageAlt = '', transitionName, placeholder } = Astro.props;

const resolved =
  typeof image === 'string' && !isRemote(image)
    ? { src: image, srcSet: undefined, sizes: undefined, width: undefined, height: undefined }
    : await (async () => {
        const img = await getImage({
          src: image,
          ...imageSize(image),
          widths: [800, 1200, 1600],
          sizes: '100vw',
          quality: 72,
        });
        return {
          src: img.src,
          srcSet: img.srcSet.attribute,
          sizes: '100vw',
          width: img.attributes.width,
          height: img.attributes.height,
        };
      })();
---

<HeroBanner
  title={title}
  subtitle={subtitle}
  src={resolved.src}
  srcSet={resolved.srcSet}
  sizes={resolved.sizes}
  width={resolved.width}
  height={resolved.height}
  imageAlt={imageAlt}
  transitionName={transitionName}
  placeholder={placeholder}
/>
