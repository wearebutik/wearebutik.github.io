---
import { getImage } from 'astro:assets';
import logo from '../assets/logos/bollo-rosso.svg';
import Logo from '@butik/ui/Logo';
import Button from '@butik/ui/Button';

// getImage() (non <Image>) perché il risultato alimenta l'atomo React Logo di
// @butik/ui — vedi ADR-0008 amendment 2026-07-21 sul vincolo immagini Astro
// dentro le isole.
const logoImg = await getImage({ src: logo, width: 45, height: 45 });

const navLinks = [
  { href: '/chi-siamo', label: 'Chi siamo' },
  { href: '/servizi', label: 'Servizi' },
  { href: '/contatti', label: 'Contatti' },
  { href: '/progetti', label: 'Portfolio' },
  { href: '/blog', label: 'Blog' },
];

const ctaHref = '/contatti';
const ctaLabel = 'Lavoriamo insieme';

const currentPath = Astro.url.pathname;
// Solo la home va in overlay sopra l'hero. Vincolo da rispettare se un giorno
// si estende: l'overlay è guidato da una scroll-driven animation, che ha
// bisogno di un range di scroll — su una pagina più corta del viewport la
// timeline non avanza e l'header resterebbe fermo sullo stato trasparente.
const isHome = currentPath === '/';

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

{/*
  Header senza JavaScript (ADR-0002, static-first).

  Lo stato "scrolled" della home era gestito da uno <script> che aggiungeva
  data-scrolled e le classi di sfondo. Con <ClientRouter /> quello script gira
  una volta sola per sessione: dopo una view transition il <header> è un nodo
  nuovo, il listener resta agganciato al vecchio nodo staccato dal DOM e
  l'header resta trasparente anche da scrollato (stesso motivo per cui
  l'hamburger smetteva di aprirsi).

  Ora lo stato è CSS puro:
  - il colore è guidato da una scroll-driven animation su --header-solid
    (0 = overlay sull'hero, 1 = solido), custom property registrata e
    ereditata, così i discendenti la leggono senza bisogno di un attributo;
  - il menu mobile è un <details>, disclosure nativa con semantica accessibile.
  Niente stato JS = niente da re-inizializzare a ogni navigazione.
*/}
<header
  id="site-header"
  data-overlay={isHome ? 'true' : 'false'}
  class:list={['site-header', isHome ? '' : 'site-header-solid']}
>
  <div class="header-inner">

    <!-- Left: Logo + Primary Nav -->
    <div class="header-left">
      <a href="/" class="logo-link">
        <Logo
          src={logoImg.src}
          width={45}
          height={45}
          loading="eager"
          alt="Butik — home"
          className="site-logo"
        />
      </a>
      <nav class="primary-nav" aria-label="Navigazione principale">
        {navLinks.map(link => (
          <a
            href={link.href}
            class:list={['nav-link', isActive(link.href) && 'nav-link-active']}
          >
            {link.label}
          </a>
        ))}
      </nav>
    </div>

    <!-- Right: CTA -->
    <span class="cta-wrap">
      <Button href={ctaHref} tone="dark" className="header-cta">{ctaLabel}</Button>
    </span>

    <!-- Mobile menu: <details> nativo, nessun listener -->
    <details id="mobile-menu" class="mobile-nav">
      <summary class="mobile-toggle" aria-label="Menu">
        <svg xmlns="http://www.w3.org/2000/svg" class="mobile-toggle-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </summary>
      <div class="mobile-panel">
        <nav class="mobile-nav-list" aria-label="Navigazione principale mobile">
          {navLinks.map(link => (
            <a
              href={link.href}
              class:list={['mobile-link', isActive(link.href) && 'mobile-link-active']}
            >
              {link.label}
            </a>
          ))}
          <Button href={ctaHref} tone="dark" className="mobile-cta">{ctaLabel}</Button>
        </nav>
      </div>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
  }
  .site-header-solid {
    background-color: var(--color-bg);
    border-bottom: 1px solid color-mix(in srgb, var(--color-fg) 10%, transparent);
  }

  .header-inner {
    max-width: 80rem;
    margin-inline: auto;
    padding-inline: var(--space-6);
    height: 5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .header-left {
    display: flex;
    align-items: center;
    gap: 2.5rem;
  }

  .logo-link {
    flex-shrink: 0;
    position: relative;
    z-index: 10;
  }

  .site-header :global(.site-logo) {
    height: 2.8125rem;
    width: auto;
  }

  .primary-nav {
    display: none;
  }
  @media (min-width: 768px) {
    .primary-nav {
      display: flex;
      align-items: center;
      gap: var(--space-8);
    }
  }

  .nav-link,
  .mobile-link {
    font-family: var(--font-display);
    font-size: var(--font-size-xs);
    line-height: calc(1 / 0.75);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-fg);
  }
  .nav-link {
    transition: color var(--duration-fast) cubic-bezier(0.4, 0, 0.2, 1);
  }
  .mobile-link {
    padding-block: var(--space-3);
  }
  .nav-link:hover,
  .nav-link.nav-link-active,
  .mobile-link.mobile-link-active {
    color: var(--color-accent-text);
  }

  .cta-wrap {
    display: none;
  }
  @media (min-width: 768px) {
    .cta-wrap {
      display: inline-block;
    }
  }

  /* --header-solid: 0 sopra l'hero (overlay), 1 da scrollato. Registrata con
     @property perché serve interpolabile (<number>) ed ereditata: una sola
     animazione sull'header, tutti i discendenti la leggono.

     Colori dai token di @butik/ui-tokens (ADR-0005) e non dai --color-butik-*
     del @theme Tailwind: l'isola Button che l'header contiene consuma già
     quelli, e tenere due scale con gli stessi hex nello stesso componente è
     drift che aspetta di succedere. */
  @property --header-solid {
    syntax: '<number>';
    inherits: true;
    initial-value: 0;
  }

  @keyframes header-scroll {
    to { --header-solid: 1; }
  }

  /* Solo la home è in overlay sopra l'hero. Longhand e non la shorthand
     `animation`: la shorthand azzera animation-timeline e imporrebbe
     duration: 0s, che con una timeline di scroll non funziona.

     `steps(1, end)` su un range di 1px: lo stato è binario, mai intermedio.
     Un crossfade legato allo scroll produrrebbe posizioni di riposo a metà
     strada — e a metà strada testo e sfondo si incontrano intorno allo stesso
     livello di luminanza (~1:1 di contrasto). Non è un frame di transizione:
     è una posizione di scroll dove l'utente può fermarsi e restare. La
     morbidezza torna sotto forma di `transition` a tempo, che dura 300ms e
     poi finisce. */
  .site-header[data-overlay='true'] {
    animation-name: header-scroll;
    animation-duration: auto;
    animation-timing-function: steps(1, end);
    animation-fill-mode: both;
    animation-timeline: scroll(root block);
    animation-range: 60px 61px;

    background-color: color-mix(
      in srgb, var(--color-bg) calc(var(--header-solid) * 100%), transparent
    );
    border-bottom: 1px solid color-mix(
      in srgb,
      color-mix(in srgb, var(--color-fg) 10%, transparent) calc(var(--header-solid) * 100%),
      transparent
    );
    transition: background-color 300ms ease, border-bottom-color 300ms ease;
  }

  /* Fallback: senza scroll-driven animations (oggi Firefox — animation-timeline
     non è ancora Baseline) l'header della home è solido da subito. Si perde
     l'overlay sull'hero, non la leggibilità. */
  @supports not (animation-timeline: scroll(root block)) {
    .site-header[data-overlay='true'] { --header-solid: 1; }
  }

  /* Elementi interni: commutano fra la resa chiara (sopra l'hero scuro) e
     quella scura (header solido). Vale a tutti i breakpoint perché l'hero è
     uniformemente scuro anche su desktop.

     `:global()` sui due elementi resi da isole React (@butik/ui Logo e
     Button): Astro applica l'attributo di scoping solo al markup che compila
     lui, quindi un selettore scoped non raggiunge mai il DOM di un'isola —
     le regole sarebbero CSS morto. L'header resta il pivot scoped, il
     discendente no. */
  .site-header[data-overlay='true'] :global(.site-logo) {
    filter: drop-shadow(0 1px 4px color-mix(
      in srgb, var(--color-fg) calc((1 - var(--header-solid)) * 45%), transparent
    ));
    transition: filter 300ms ease;
  }

  .site-header[data-overlay='true'] .nav-link {
    color: color-mix(
      in srgb, var(--color-fg) calc(var(--header-solid) * 100%), var(--color-fg-invert)
    );
    text-shadow: 0 1px 4px color-mix(
      in srgb, var(--color-fg) calc((1 - var(--header-solid)) * 45%), transparent
    );
    transition: color 300ms ease, text-shadow 300ms ease;
  }
  /* Come le regole sorelle qui sopra, interpola fra i due stati invece di
     fissare un colore: da solido serve l'accent scurito (5.20:1 su --color-bg),
     sopra l'hero scuro serve l'highlight, perche' li' il rosso non arriva al
     4.5:1 che questo testo da 12px bold richiede. */
  .site-header[data-overlay='true'] .nav-link:hover {
    color: color-mix(
      in srgb, var(--color-accent-text) calc(var(--header-solid) * 100%), var(--color-highlight)
    );
    transition: color 300ms ease;
  }

  .site-header[data-overlay='true'] .mobile-toggle {
    color: color-mix(
      in srgb, var(--color-fg) calc(var(--header-solid) * 100%), var(--color-fg-invert)
    );
    filter: drop-shadow(0 1px 4px color-mix(
      in srgb, var(--color-fg) calc((1 - var(--header-solid)) * 45%), transparent
    ));
    transition: color 300ms ease, filter 300ms ease;
  }

  /* Il riempimento in overlay è uno scrim SCURO, non chiaro. Con il vetro
     bianco al 12% il testo stava a ~4.2:1 e il bordo a 2.1:1 sopra le tile
     chiare dell'hero (c'è un cielo quasi bianco sotto la barra): il vetro
     schiariva ulteriormente un fondo già chiaro. Invertendo il verso l'effetto
     "vetro sopra la foto" resta, ma il testo bianco sale a ~10.9:1 e il bordo
     a ~3.6:1 sul proprio riempimento. */
  .site-header[data-overlay='true'] :global(.header-cta) {
    background-color: color-mix(
      in srgb,
      var(--color-fg) calc(var(--header-solid) * 100%),
      color-mix(in srgb, var(--color-fg) 45%, transparent)
    );
    color: var(--color-fg-invert);
    border: 1px solid color-mix(
      in srgb,
      var(--color-fg) calc(var(--header-solid) * 100%),
      color-mix(in srgb, var(--color-fg-invert) 45%, transparent)
    );
    backdrop-filter: blur(calc((1 - var(--header-solid)) * 4px));
    transition: background-color 300ms ease, border-color 300ms ease;
  }
  .site-header[data-overlay='true'] :global(.header-cta:hover) {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
  }

  /* Focus visibile — l'accent rosso non è leggibile sopra l'hero scurito
     (1.1÷2.0:1, sotto il 3:1 di WCAG 1.4.11): in overlay l'anello diventa
     bianco, come già fa Button per il tono `invert`. I .nav-link non
     dichiaravano alcuno stile di focus e restavano al ring di default. */
  .site-header .nav-link:focus-visible,
  .mobile-nav > summary:focus-visible,
  .site-header :global(.header-cta:focus-visible) {
    outline: 2px solid color-mix(
      in srgb, var(--color-accent) calc(var(--header-solid) * 100%), var(--color-fg-invert)
    );
    outline-offset: 2px;
  }

  /* Menu mobile — <details> nativo. Il pannello è in absolute sotto la barra:
     l'header è sticky (quindi posizionato) e fa da containing block. */
  @media (min-width: 768px) {
    .mobile-nav {
      display: none;
    }
  }
  .mobile-nav > summary {
    list-style: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    padding: var(--space-3);
  }
  .mobile-nav > summary::-webkit-details-marker { display: none; }
  .mobile-nav > summary::marker { content: ''; }
  .mobile-toggle-icon {
    width: var(--space-6);
    height: var(--space-6);
  }

  .mobile-panel {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    border-top: 1px solid color-mix(in srgb, var(--color-fg) 10%, transparent);
    background-color: var(--color-bg);
  }
  .mobile-nav-list {
    display: flex;
    flex-direction: column;
    padding-inline: var(--space-6);
    padding-block: var(--space-4);
    gap: var(--space-1);
  }
  .site-header :global(.mobile-cta) {
    width: 100%;
    margin-top: var(--space-3);
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header[data-overlay='true'],
    .site-header[data-overlay='true'] .nav-link,
    .site-header[data-overlay='true'] .mobile-toggle,
    .site-header[data-overlay='true'] :global(.site-logo),
    .site-header[data-overlay='true'] :global(.header-cta) {
      transition: none;
    }
  }
</style>
