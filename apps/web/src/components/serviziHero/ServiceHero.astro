---
// Hero della scheda servizio — un solo ingresso, quattro trattamenti.
// La scelta è per singolo servizio: il campo `heroVariant` della sua entry
// nella collection `servizi` decide quale rendere, così due schede possono
// avere hero diversi senza duplicare la route.
//
//   banner → HeroBanner, il trattamento comune a progetti e pagine
//   a      → split parlante al target: pannello scuro accanto all'immagine
//   b      → claim tipografico + barra prova, senza immagine
//   c      → scheda-offerta sovrapposta all'immagine di atmosfera
//
// I contenuti degli hero A/B/C (eyebrow, claim, prove, esiti, CTA) sono il
// campo `hero` del documento servizio su Sanity (ADR-0004).
import type { ImageMetadata } from 'astro';
import HeroBanner from '../HeroBanner.astro';
import ServiceHeroA from './ServiceHeroA.astro';
import ServiceHeroB from './ServiceHeroB.astro';
import ServiceHeroC from './ServiceHeroC.astro';
import type { ServiceHeroContent } from './types';

export type ServiceHeroVariant = 'banner' | 'a' | 'b' | 'c';

interface Props {
  variant: ServiceHeroVariant;
  /** Testi delle varianti A/B/C; senza, si ricade sul banner. */
  content?: ServiceHeroContent;
  title: string;
  subtitle?: string;
  image: ImageMetadata | string;
  imageAlt?: string;
  transitionName?: string;
}
const { variant, content, title, subtitle, image, imageAlt = '', transitionName } = Astro.props;

// Senza contenuti hero dedicati le varianti A/B/C non hanno cosa mostrare:
// si ricade sul banner invece di rendere una sezione vuota.
const resolved = variant !== 'banner' && !content ? 'banner' : variant;
---

{resolved === 'banner' && (
  <HeroBanner
    title={title}
    subtitle={subtitle}
    image={image}
    imageAlt={imageAlt}
    transitionName={transitionName}
  />
)}

{resolved === 'a' && content && <ServiceHeroA content={content} image={image} imageAlt={imageAlt} />}
{resolved === 'b' && content && <ServiceHeroB content={content} image={image} imageAlt={imageAlt} />}
{resolved === 'c' && content && <ServiceHeroC content={content} image={image} imageAlt={imageAlt} />}
