---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { ServiceHeroContent } from '../../data/serviziHero';
import Eyebrow from '@butik/ui/Eyebrow';
import Button from '@butik/ui/Button';

interface Props {
  content: ServiceHeroContent;
  image: ImageMetadata | string;
  imageAlt?: string;
}
// `image` arriva per uniformità di contratto con A/C ma in questa direzione
// l'hero è puramente tipografico: la prop non viene usata di proposito.
const { content } = Astro.props;
const _unused = Image;
---

<section class="bg-butik-light text-butik-dark flex flex-col">
  <div class="flex-1 flex items-center">
    <div class="mx-auto w-full max-w-7xl px-6 py-12 md:py-16 lg:py-20">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-y-12 lg:gap-x-12 items-end">

        <!-- Colonna sinistra: claim + CTA ──────────────────────────────── -->
        <div class="lg:col-span-7">
          <Eyebrow>{content.eyebrow}</Eyebrow>

          <h1 class="hero-claim mt-5 font-heading font-black text-4xl md:text-5xl lg:text-6xl">
            {content.headline}
          </h1>

          <p class="mt-6 max-w-xl font-sans text-lg text-butik-dark/70">
            {content.sub}
          </p>

          <div class="mt-9 flex flex-wrap items-center gap-x-8 gap-y-4">
            <Button href={content.ctaPrimary.href} tone="dark">{content.ctaPrimary.label}</Button>

            {content.ctaSecondary && (
              <a
                href={content.ctaSecondary.href}
                class="font-display text-xs font-bold tracking-widest uppercase text-butik-dark underline underline-offset-4 decoration-butik-dark/30 hover:text-butik-red-ink hover:decoration-butik-red transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-butik-red"
              >
                {content.ctaSecondary.label}
              </a>
            )}
          </div>
        </div>

        <!-- Colonna destra: il registro (prova reale come indice) ───────── -->
        <div class="lg:col-span-5">
          <Eyebrow>{content.ledgerLabel}</Eyebrow>
          <ul class="border-t border-butik-dark/15">
            {content.ledger.map((row) => (
              <li class="flex items-baseline gap-4 border-b border-butik-dark/15 py-2.5">
                <span class="ledger-key shrink-0 w-20 font-display text-sm font-bold tracking-wide text-butik-red-ink">
                  {row.k}
                </span>
                <span class="font-sans text-sm md:text-base text-butik-dark leading-snug">
                  {row.v}
                </span>
              </li>
            ))}
          </ul>
        </div>

      </div>
    </div>
  </div>

  <!-- Barra prova full-bleed ───────────────────────────────────────────── -->
  <div class="bg-butik-dark text-white">
    <ul
      class="mx-auto flex max-w-7xl items-center gap-6 overflow-x-auto px-6 py-5 md:justify-center md:gap-0 md:overflow-visible md:py-6"
    >
      {content.proofBar.map((item, i) => (
        <li
          class="flex shrink-0 items-center font-display text-xs font-bold uppercase tracking-widest md:shrink"
        >
          {i > 0 && (
            <span class="mx-5 text-butik-green md:mx-8" aria-hidden="true">/</span>
          )}
          <span class="whitespace-nowrap md:whitespace-normal">{item}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  section {
    min-height: 70vh;
  }
  /* h1 globale impone color butik-dark + font-heading: il claim lo eredita
     correttamente, qui irrigidiamo solo leading e tracking per l'oversize. */
  .hero-claim {
    line-height: 1;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  /* Allineo le chiavi corte ("2018", "MMW", "15+") su una colonna costante. */
  .ledger-key {
    font-variant-numeric: tabular-nums;
  }
</style>
