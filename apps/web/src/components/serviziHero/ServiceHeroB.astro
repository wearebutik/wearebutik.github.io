---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { ServiceHeroContent } from './types';
import Eyebrow from '@butik/ui/Eyebrow';
import Button from '@butik/ui/Button';

interface Props {
  content: ServiceHeroContent;
  image: ImageMetadata | string;
  imageAlt?: string;
}
// `image` arriva per uniformità di contratto con A/C ma in questa direzione
// l'hero è puramente tipografico: la prop non viene usata di proposito.
const { content } = Astro.props;
const _unused = Image;
---

<section data-hero>
  <div class="hero-inner">
    <div class="hero-container">
      <div class="hero-grid">

        <!-- Colonna sinistra: claim + CTA ──────────────────────────────── -->
        <div class="hero-col-claim">
          <Eyebrow>{content.eyebrow}</Eyebrow>

          <h1 class="hero-claim" data-battito style="--ritardo: 150ms">
            {content.headline}
          </h1>

          <p class="hero-lead" data-battito style="--ritardo: 270ms">
            {content.sub}
          </p>

          <div class="hero-actions" data-battito style="--ritardo: 390ms">
            <Button href={content.ctaPrimary.href} tone="dark">{content.ctaPrimary.label}</Button>

            {content.ctaSecondary && (
              <a href={content.ctaSecondary.href} class="hero-cta-secondary">
                {content.ctaSecondary.label}
              </a>
            )}
          </div>
        </div>

        <!-- Colonna destra: il registro (prova reale come indice) ───────── -->
        <div class="hero-col-ledger" data-battito style="--ritardo: 510ms">
          <Eyebrow>{content.ledgerLabel}</Eyebrow>
          <ul class="ledger-list">
            {content.ledger.map((row) => (
              <li class="ledger-row">
                <span class="ledger-key">
                  {row.k}
                </span>
                <span class="ledger-value">
                  {row.v}
                </span>
              </li>
            ))}
          </ul>
        </div>

      </div>
    </div>
  </div>

  <!-- Barra prova full-bleed ───────────────────────────────────────────── -->
  <!-- Su mobile la barra scorre in orizzontale: tabindex e role="region" sul
       contenitore la rendono raggiungibile e scorrevole da tastiera, e la lista
       resta una lista. Il nome è l'etichetta del registro (le prove sono la
       stessa materia), o l'eyebrow se manca. -->
  <div
    class="proof-bar"
    tabindex="0"
    role="region"
    aria-label={content.ledgerLabel || content.eyebrow || 'Risultati'}
  >
    <ul class="proof-list">
      {content.proofBar.map((item, i) => (
        <li class="proof-item">
          {i > 0 && (
            <span class="proof-sep" aria-hidden="true">/</span>
          )}
          <span class="proof-label">{item}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  section {
    min-height: 70vh;
    background-color: var(--color-bg);
    color: var(--color-fg);
    display: flex;
    flex-direction: column;
  }

  .hero-inner {
    flex: 1;
    display: flex;
    align-items: center;
  }

  .hero-container {
    margin-inline: auto;
    width: 100%;
    max-width: var(--container-max);
    padding-inline: var(--space-6);
    padding-block: var(--space-12);
  }
  @media (min-width: 48rem) {
    .hero-container {
      padding-block: var(--space-16);
    }
  }
  @media (min-width: 64rem) {
    .hero-container {
      padding-block: var(--space-20);
    }
  }

  .hero-grid {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    row-gap: var(--space-12);
    align-items: flex-end;
  }
  @media (min-width: 64rem) {
    .hero-grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--space-12);
    }
  }

  @media (min-width: 64rem) {
    .hero-col-claim {
      grid-column: span 7 / span 7;
    }
    .hero-col-ledger {
      grid-column: span 5 / span 5;
    }
  }

  /* h1 globale impone color butik-dark + font-heading: il claim lo eredita
     correttamente, qui irrigidiamo solo leading e tracking per l'oversize. */
  .hero-claim {
    margin-top: var(--space-5);
    font-weight: 900; /* font-black: nessun --font-weight-* in ui-tokens */
    font-size: var(--text-4xl);
    line-height: 1;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  @media (min-width: 48rem) {
    .hero-claim {
      font-size: var(--text-5xl);
    }
  }
  @media (min-width: 64rem) {
    .hero-claim {
      font-size: var(--text-6xl);
    }
  }

  .hero-lead {
    margin-top: var(--space-6);
    max-width: var(--measure-xl);
    font-family: var(--font-sans);
    font-size: var(--font-size-lg);
    line-height: calc(1.75 / 1.125);
    color: color-mix(in oklab, var(--color-fg) 70%, transparent);
  }

  .hero-actions {
    margin-top: 2.25rem; /* mt-9: nessun token per 2.25rem */
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: var(--space-8);
    row-gap: var(--space-4);
  }

  .hero-cta-secondary {
    /* design-lint-disable small-caps: CTA, fuori dai due ruoli */
    font-family: var(--font-display);
    font-size: var(--font-size-xs);
    line-height: calc(1 / 0.75);
    font-weight: 700; /* font-bold: nessun --font-weight-* in ui-tokens */
    letter-spacing: 0.1em; /* tracking-widest: nessun token per 0.1em */
    text-transform: uppercase;
    color: var(--color-fg);
    text-decoration-line: underline;
    text-underline-offset: 4px;
    text-decoration-color: color-mix(in oklab, var(--color-fg) 30%, transparent);
    transition:
      color var(--duration-fast) var(--ease-standard),
      text-decoration-color var(--duration-fast) var(--ease-standard);
  }
  .hero-cta-secondary:hover {
    color: var(--color-accent-text);
    text-decoration-color: var(--color-accent);
  }
  .hero-cta-secondary:focus-visible {
    outline-style: solid;
    outline-width: 2px;
    outline-offset: 2px;
    outline-color: var(--color-accent);
  }

  .ledger-list {
    border-top-style: solid;
    border-top-width: 1px;
    border-top-color: color-mix(in oklab, var(--color-fg) 15%, transparent);
  }

  .ledger-row {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    border-bottom-style: solid;
    border-bottom-width: 1px;
    border-bottom-color: color-mix(in oklab, var(--color-fg) 15%, transparent);
    padding-block: var(--space-2-5);
  }

  /* Allineo le chiavi corte ("2018", "MMW", "15+") su una colonna costante. */
  .ledger-key {
    flex-shrink: 0;
    width: var(--space-20);
    font-family: var(--font-display);
    font-size: var(--font-size-sm);
    line-height: calc(1.25 / 0.875);
    font-weight: 700; /* font-bold: nessun --font-weight-* in ui-tokens */
    letter-spacing: 0.025em; /* tracking-wide: nessun token per 0.025em */
    color: var(--color-accent-text);
    font-variant-numeric: tabular-nums;
  }

  .ledger-value {
    font-family: var(--font-sans);
    font-size: var(--font-size-sm);
    color: var(--color-fg);
    /* leading-snug vinceva su text-sm/md:text-base a ogni breakpoint */
    line-height: 1.375;
  }
  @media (min-width: 48rem) {
    .ledger-value {
      font-size: var(--font-size-base);
    }
  }

  .proof-bar {
    background-color: var(--color-bg-invert);
    color: var(--color-fg-invert);
    overflow-x: auto;
  }
  /* Anello bianco: sulla barra scura l'accent non arriva al 3:1. Rientra
     perché la barra è a filo dei bordi dello schermo. */
  .proof-bar:focus-visible {
    outline: 2px solid var(--color-fg-invert);
    outline-offset: calc(-1 * var(--space-1));
  }

  .proof-list {
    margin: 0 auto;
    list-style: none;
    display: flex;
    width: max-content;
    min-width: 100%;
    max-width: var(--container-max);
    align-items: center;
    gap: var(--space-6);
    padding-inline: var(--space-6);
    padding-block: var(--space-5);
  }
  @media (min-width: 48rem) {
    .proof-bar {
      overflow: visible;
    }
    .proof-list {
      width: auto;
      justify-content: center;
      gap: 0;
      padding-block: var(--space-6);
    }
  }

  .proof-item {
    /* design-lint-disable small-caps: riga di prove, non un metadato, fuori dai due ruoli */
    display: flex;
    flex-shrink: 0;
    align-items: center;
    font-family: var(--font-display);
    font-size: var(--font-size-xs);
    line-height: calc(1 / 0.75);
    font-weight: 700; /* font-bold: nessun --font-weight-* in ui-tokens */
    text-transform: uppercase;
    letter-spacing: 0.1em; /* tracking-widest: nessun token per 0.1em */
  }
  @media (min-width: 48rem) {
    .proof-item {
      flex-shrink: 1;
    }
  }

  .proof-sep {
    margin-inline: var(--space-5);
    color: var(--color-highlight);
  }
  @media (min-width: 48rem) {
    .proof-sep {
      margin-inline: var(--space-8);
    }
  }

  .proof-label {
    white-space: nowrap;
  }
  @media (min-width: 48rem) {
    .proof-label {
      white-space: normal;
    }
  }
</style>
