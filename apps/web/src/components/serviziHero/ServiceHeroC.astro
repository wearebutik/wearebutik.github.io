---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { ServiceHeroContent } from '../../data/serviziHero';
import Eyebrow from '@butik/ui/Eyebrow';
import Button from '@butik/ui/Button';

interface Props {
  content: ServiceHeroContent;
  image: ImageMetadata | string;
  imageAlt?: string;
}
const { content, image, imageAlt = '' } = Astro.props;

const isMeta = typeof image !== 'string';
const seal = content.proof?.[0];
const { eyebrow, headline, outcomes, ctaPrimary, ctaSecondary } = content;
---

<section class="service-hero-c">
  <!-- ── Atmosfera: immagine del servizio come sfondo ─────────────────── -->
  <div class="backdrop" aria-hidden={imageAlt ? undefined : 'true'}>
    {isMeta ? (
      <Image
        src={image as ImageMetadata}
        alt={imageAlt}
        widths={[800, 1200, 1600]}
        sizes="100vw"
        quality={72}
        loading="eager"
        fetchpriority="high"
        class="backdrop-image"
      />
    ) : (
      <img
        src={image as string}
        alt={imageAlt}
        loading="eager"
        fetchpriority="high"
        class="backdrop-image"
      />
    )}
  </div>

  <!-- ── Overlay scuro a gradiente per contrasto (WCAG AA) ────────────── -->
  <div class="scrim-vertical" aria-hidden="true"></div>
  <div class="scrim-horizontal" aria-hidden="true"></div>

  <!-- ── Contenuto: card-offerta in basso a sinistra (desktop) ────────── -->
  <div class="content">
    <div class="offer-card">
      <!-- Sigillo di credibilità sull'angolo -->
      {seal && (
        <div class="offer-seal">
          <span class="seal-value">{seal.value}</span>
          <span class="seal-label">{seal.label}</span>
        </div>
      )}

      <!-- 1) Tag "Per [target]" -->
      <Eyebrow>{eyebrow}</Eyebrow>

      <!-- 2) Headline (unico h1 di pagina) -->
      <h1 class="offer-headline">
        {headline}
      </h1>

      <!-- 3) Cosa ottieni -->
      <ul class="outcome-list">
        {outcomes.map((o) => (
          <li class="outcome-item">
            <span class="outcome-check" aria-hidden="true">✓</span>
            <span class="outcome-text">{o}</span>
          </li>
        ))}
      </ul>

      <!-- 4) Doppia CTA -->
      <div class="cta-row">
        <Button href={ctaPrimary.href}>{ctaPrimary.label}</Button>
        {ctaSecondary && (
          <Button href={ctaSecondary.href} variant="ghost">{ctaSecondary.label}</Button>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .service-hero-c {
    position: relative;
    overflow: hidden;
    background-color: var(--color-butik-dark);
  }

  .backdrop {
    position: absolute;
    inset: 0;
  }

  .backdrop-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .scrim-vertical {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(
      to top,
      color-mix(in oklab, var(--color-butik-dark) 85%, transparent),
      color-mix(in oklab, var(--color-butik-dark) 45%, transparent),
      color-mix(in oklab, var(--color-butik-dark) 55%, transparent)
    );
  }

  .scrim-horizontal {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(
      to right,
      color-mix(in oklab, var(--color-butik-dark) 55%, transparent),
      transparent
    );
  }

  .content {
    position: relative;
    display: flex;
    align-items: flex-end;
    width: 100%;
    height: 60vh;
    max-width: 80rem;
    margin-inline: auto;
    padding-inline: var(--space-6);
    padding-top: 7rem;
    padding-bottom: var(--space-8);
  }
  @media (min-width: 48rem) {
    .content {
      height: 70vh;
      padding-inline: var(--space-8);
      padding-bottom: var(--space-12);
    }
  }

  .offer-card {
    position: relative;
    width: 100%;
    background-color: color-mix(in oklab, var(--color-white) 95%, transparent);
    border: 1px solid color-mix(in oklab, var(--color-white) 40%, transparent);
    box-shadow: 0 25px 50px -12px #00000040;
    backdrop-filter: blur(12px);
    padding: var(--space-6);
  }
  @media (min-width: 48rem) {
    .offer-card {
      max-width: 36rem;
      padding: var(--space-8);
    }
  }

  .offer-seal {
    position: absolute;
    top: calc(var(--space-3) * -1);
    right: var(--space-4);
    display: flex;
    align-items: baseline;
    gap: 0.375rem;
    background-color: var(--color-butik-red);
    color: var(--color-white);
    padding-inline: var(--space-3);
    padding-block: 0.375rem;
    font-family: var(--font-display);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    box-shadow: 0 10px 15px -3px #0000001a, 0 4px 6px -4px #0000001a;
  }
  @media (min-width: 48rem) {
    .offer-seal {
      top: calc(var(--space-4) * -1);
      right: var(--space-6);
      font-size: var(--font-size-xs);
      line-height: calc(1 / 0.75);
    }
  }

  .seal-value {
    font-size: var(--font-size-sm);
    /* leading-none vinceva su text-sm/text-base */
    line-height: 1;
  }
  @media (min-width: 48rem) {
    .seal-value {
      font-size: var(--font-size-base);
    }
  }

  /* normal-case e lowercase erano entrambe applicate: nella cascata generata
     normal-case vince (dichiarata dopo), quindi qui il testo resta invariato
     invece che minuscolo — intenzione mai realizzata, non la correggiamo. */
  .seal-label {
    opacity: 0.9;
    text-transform: none;
    letter-spacing: normal;
    font-family: var(--font-sans);
    font-weight: 500;
  }

  /* h1 globale è font-heading + butik-dark: qui la card è chiara, quindi
     manteniamo butik-dark ma neutralizziamo eventuale uppercase ereditato. */
  .offer-headline {
    color: var(--color-butik-dark);
    text-transform: none;
    letter-spacing: -0.01em;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--font-size-xl);
    /* leading-[1.08] vinceva su text-2xl/4xl: line-height fisso a ogni taglia */
    line-height: 1.08;
    margin-top: var(--space-3);
  }
  @media (min-width: 48rem) {
    .offer-headline {
      font-size: clamp(1.9rem, 1.35rem + 2.4vw, 2.25rem);
    }
  }

  .outcome-list {
    margin-top: 1.25rem;
  }
  @media (min-width: 48rem) {
    .outcome-list {
      margin-top: var(--space-6);
    }
  }

  .outcome-list > li:not(:last-child) {
    margin-block-end: 0.625rem;
  }

  .outcome-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    font-family: var(--font-sans);
    font-size: var(--font-size-sm);
    line-height: calc(1.25 / 0.875);
    color: color-mix(in oklab, var(--color-butik-dark) 85%, transparent);
  }
  @media (min-width: 48rem) {
    .outcome-item {
      font-size: var(--font-size-base);
      line-height: 1.5;
    }
  }

  .outcome-check {
    flex-shrink: 0;
    color: var(--color-butik-red);
    font-weight: 700;
    /* leading-6: coincide con --space-6 (1.5rem), riuso del token per il valore */
    line-height: var(--space-6);
  }

  .outcome-text {
    line-height: 1.375;
  }

  .cta-row {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
  @media (min-width: 40rem) {
    .cta-row {
      flex-direction: row;
    }
  }
  @media (min-width: 48rem) {
    .cta-row {
      margin-top: var(--space-8);
    }
  }
</style>
