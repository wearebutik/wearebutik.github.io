---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { ServiceHeroContent } from '../../data/serviziHero';
import Eyebrow from '@butik/ui/Eyebrow';
import Button from '@butik/ui/Button';

interface Props {
  content: ServiceHeroContent;
  image: ImageMetadata | string;
  imageAlt?: string;
}
const { content, image, imageAlt = '' } = Astro.props;
const isLocalImage = typeof image !== 'string';
---

<section class="hero-grid">
  <!-- IMMAGINE — mobile sopra, desktop a destra -->
  <div class="hero-media">
    {isLocalImage ? (
      <Image
        src={image as ImageMetadata}
        alt={imageAlt}
        widths={[800, 1200, 1600]}
        sizes="100vw"
        quality={72}
        loading="eager"
        fetchpriority="high"
        class="hero-media-img"
      />
    ) : (
      <img
        src={image as string}
        alt={imageAlt}
        loading="eager"
        fetchpriority="high"
        class="hero-media-img"
      />
    )}
    <!-- blend morbido verso il pannello scuro: dal basso su mobile, da sinistra su desktop -->
    <div class="hero-media-scrim" aria-hidden="true"></div>
  </div>

  <!-- PANNELLO SCURO — contenuto -->
  <div class="hero-panel">
    <div class="hero-panel-inner">
      <Eyebrow tone="invert">{content.eyebrow}</Eyebrow>

      <h1 class="hero-headline">
        {content.headline}
      </h1>

      <p class="hero-sub">
        {content.sub}
      </p>

      <!-- PROOF CHIP -->
      <ul class="hero-proof-list" role="list">
        {content.proof.map((p) => (
          <li class="hero-proof-item">
            <span class="hero-proof-value">
              {p.value}
            </span>
            <span class="hero-proof-label">
              {p.label}
            </span>
          </li>
        ))}
      </ul>

      <!-- CTA -->
      <div class="hero-cta-row">
        <Button href={content.ctaPrimary.href}>{content.ctaPrimary.label}</Button>

        {content.ctaSecondary && (
          <Button href={content.ctaSecondary.href} variant="ghost" tone="invert">
            {content.ctaSecondary.label}
          </Button>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .hero-grid {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
  }
  @media (min-width: 64rem) {
    .hero-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      min-height: 70vh;
    }
  }

  .hero-media {
    position: relative;
    order: 1;
    height: 14rem;
  }
  @media (min-width: 40rem) {
    .hero-media {
      height: 16rem;
    }
  }
  @media (min-width: 64rem) {
    .hero-media {
      order: 2;
      height: auto;
    }
  }

  .hero-media-img {
    position: absolute;
    inset: 0;
    height: 100%;
    width: 100%;
    object-fit: cover;
  }

  .hero-media-scrim {
    pointer-events: none;
    position: absolute;
    inset: 0;
    background-image: linear-gradient(
      to top in oklab,
      color-mix(in oklab, var(--color-butik-dark) 80%, transparent) 0%,
      color-mix(in oklab, var(--color-butik-dark) 20%, transparent) 50%,
      transparent 100%
    );
  }
  @media (min-width: 64rem) {
    .hero-media-scrim {
      background-image: linear-gradient(to left in oklab, transparent 0%, transparent 50%, var(--color-butik-dark) 100%);
    }
  }

  .hero-panel {
    order: 2;
    background-color: var(--color-butik-dark);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-left: var(--space-6);
    padding-right: var(--space-6);
    padding-top: var(--space-12);
    padding-bottom: var(--space-12);
  }
  @media (min-width: 40rem) {
    .hero-panel {
      padding-left: 2.5rem;
      padding-right: 2.5rem;
    }
  }
  @media (min-width: 64rem) {
    .hero-panel {
      order: 1;
      padding-left: var(--space-16);
      padding-right: var(--space-16);
      padding-top: 5rem;
      padding-bottom: 5rem;
    }
  }

  .hero-panel-inner {
    max-width: 36rem;
  }

  /* lo stile globale di h1 forza color butik-dark: qui serve bianco su scuro */
  .hero-headline {
    color: var(--color-fg-invert);
    margin-top: 1.25rem;
    font-family: var(--font-display);
    font-weight: 700;
    /* leading-[1.05] vinceva su text-4xl/5xl/6xl: line-height fisso a ogni taglia */
    line-height: 1.05;
    font-size: clamp(1.9rem, 1.35rem + 2.4vw, 2.25rem);
  }
  @media (min-width: 48rem) {
    .hero-headline {
      font-size: clamp(2.2rem, 1.4rem + 3.4vw, 3rem);
    }
  }
  @media (min-width: 64rem) {
    .hero-headline {
      font-size: clamp(2.5rem, 1.5rem + 4.5vw, 3.75rem);
    }
  }

  .hero-sub {
    margin-top: 1.25rem;
    max-width: 28rem;
    font-family: var(--font-sans);
    font-size: var(--font-size-base);
    line-height: 1.5;
    color: color-mix(in oklab, var(--color-fg-invert) 80%, transparent);
  }
  @media (min-width: 40rem) {
    .hero-sub {
      font-size: var(--font-size-lg);
      line-height: calc(1.75 / 1.125);
    }
  }

  .hero-proof-list {
    margin-top: var(--space-8);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .hero-proof-item {
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-md);
    border: 1px solid color-mix(in oklab, var(--color-fg-invert) 10%, transparent);
    background-color: color-mix(in oklab, var(--color-fg-invert) 5%, transparent);
    padding-left: var(--space-4);
    padding-right: var(--space-4);
    padding-top: var(--space-2);
    padding-bottom: var(--space-2);
  }

  .hero-proof-value {
    font-family: var(--font-display);
    font-size: var(--font-size-lg);
    font-weight: 700;
    /* leading-none vinceva su text-lg */
    line-height: 1;
    color: var(--color-butik-green);
  }

  .hero-proof-label {
    margin-top: var(--space-1);
    font-family: var(--font-sans);
    font-size: var(--font-size-xs);
    /* leading-tight vinceva su text-xs */
    line-height: 1.25;
    color: color-mix(in oklab, var(--color-fg-invert) 70%, transparent);
  }

  .hero-cta-row {
    margin-top: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  @media (min-width: 40rem) {
    .hero-cta-row {
      flex-direction: row;
      align-items: center;
    }
  }
</style>
