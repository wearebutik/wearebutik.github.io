---
/*
 * CtaBanner — wrapper sottile app-side. La presentazione (titolo, body, CTA)
 * vive in @butik/ui/CtaBanner, isola React condivisa (ADR-0008 amendment
 * 2026-07-21: CtaBanner ha 6 punti di consumo reali, supera la soglia di
 * riuso). Questo wrapper resta .astro solo per il tracking PostHog dei
 * click, che usa un alias app-only (#lib/analytics/misure.client,
 * ADR-0007) non risolvibile da packages/ui.
 */
import CtaBanner from '@butik/ui/CtaBanner';

interface CtaLink {
  label: string;
  href: string;
}

interface Props {
  title: string;
  body?: string;
  primaryCta: CtaLink;
  secondaryCta?: CtaLink;
}

const { title, body, primaryCta, secondaryCta } = Astro.props;
---

<script>
  import { trackEvent } from '#lib/analytics/misure.client';

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll('[data-cta-banner] a').forEach((link) => {
      if ((link as HTMLElement).dataset.phBound) return;
      (link as HTMLElement).dataset.phBound = 'true';
      link.addEventListener('click', () => {
        trackEvent('cta_clicked', {
          label: link.textContent?.trim(),
          href: (link as HTMLAnchorElement).href,
        });
      });
    });
  });
</script>

<CtaBanner title={title} body={body} primaryCta={primaryCta} secondaryCta={secondaryCta} />
