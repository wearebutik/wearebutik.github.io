---
// "Bandi vinti" — elenco bando/anno (usato dal servizio Progettazione culturale).
import Eyebrow from '@butik/ui/Eyebrow';

interface Bando {
  nome: string;
  anno: string;
}

interface Props {
  bandi: Bando[];
  eyebrow?: string;
}

const { bandi, eyebrow = 'Bandi vinti' } = Astro.props;
---

<section class="not-prose my-10">
  <Eyebrow>{eyebrow}</Eyebrow>
  <ul class="border-t border-butik-dark/10">
    {bandi.map((b) => (
      <li class="flex items-baseline justify-between gap-4 border-b border-butik-dark/10 py-3">
        <span class="font-sans text-base text-butik-body leading-snug">{b.nome}</span>
        <span class="font-display text-sm font-bold tracking-widest text-butik-red-ink flex-shrink-0">
          {b.anno}
        </span>
      </li>
    ))}
  </ul>
</section>
