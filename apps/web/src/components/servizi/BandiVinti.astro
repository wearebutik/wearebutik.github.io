---
// "Bandi vinti" — elenco bando/anno (usato dal servizio Progettazione culturale).
import Eyebrow from '@butik/ui/Eyebrow';

interface Bando {
  nome: string;
  anno: string;
}

interface Props {
  bandi: Bando[];
  eyebrow?: string;
}

const { bandi, eyebrow = 'Bandi vinti' } = Astro.props;
---

<section class="not-prose bandi-vinti">
  <Eyebrow>{eyebrow}</Eyebrow>
  <ul class="bandi-list">
    {bandi.map((b) => (
      <li class="bando-row">
        <span class="bando-nome">{b.nome}</span>
        <span class="bando-anno">
          {b.anno}
        </span>
      </li>
    ))}
  </ul>
</section>

<style>
  .bandi-vinti {
    /* 2.5rem non ha un token corrispondente in ui-tokens */
    margin-top: 2.5rem;
    margin-bottom: 2.5rem;
  }

  .bandi-list {
    border-top: 1px solid color-mix(in srgb, var(--color-fg) 10%, transparent);
  }

  .bando-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    border-bottom: 1px solid color-mix(in srgb, var(--color-fg) 10%, transparent);
    padding-top: var(--space-3);
    padding-bottom: var(--space-3);
  }

  .bando-nome {
    /* font-family e color li impone `.prose p, .prose li` di global.css, con
       specificita' (0,1,1) che batte le utility: dichiararli qui vincerebbe
       (0,2,0) e cambierebbe la resa. Vedi ADR-0005 e l'issue #46. */
    font-size: var(--font-size-base);
    line-height: 1.375; /* leading-snug, vince su quello implicito di text-base */
  }

  .bando-anno {
    font-family: var(--font-display);
    font-size: var(--font-size-sm);
    line-height: calc(1.25 / 0.875); /* line-height implicito di text-sm */
    font-weight: 700;
    letter-spacing: 0.1em; /* tracking-widest, nessun token corrispondente */
    color: var(--color-accent-text);
    flex-shrink: 0;
  }
</style>
