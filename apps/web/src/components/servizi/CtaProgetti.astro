---
// CTA "Scopri i nostri progetti": rimanda al portfolio. Le schede dei singoli
// progetti citate nel copy non esistono ancora come pagine: finché non ci
// saranno, il link punta a /progetti e i titoli restano come anteprima testuale.
import Button from '@butik/ui/Button';

interface Props {
  title: string;
  schede?: string;
  href?: string;
  label?: string;
}

const { title, schede, href = '/progetti', label = 'Vedi tutti i progetti' } = Astro.props;
---

<section class="not-prose cta-panel">
  <p class="title">
    {title}
  </p>
  {schede && <p class="schede">{schede}</p>}
  <Button href={href} variant="ghost" tone="accent" className="cta-action">{label}</Button>
</section>

<style>
  .cta-panel {
    margin: var(--space-12) 0;
    border: 1px solid color-mix(in srgb, var(--color-fg) 15%, transparent);
    background-color: var(--color-white);
    padding: var(--space-6);
  }

  @media (min-width: 768px) {
    .cta-panel {
      padding: var(--space-8);
    }
  }

  .title {
    /* font-family e color li impone `.prose p, .prose li` di global.css, con
       specificita' (0,1,1) che batte le utility: dichiararli qui vincerebbe
       (0,2,0) e cambierebbe la resa. Vedi ADR-0005 e l'issue #46. */
    text-transform: none;
    letter-spacing: -0.01em;
    /* text-xl: nessun token combacia con 1.25rem esatti */
    font-size: 1.25rem;
    font-weight: 700;
    /* leading-tight vince sul line-height implicito di text-xl/text-2xl */
    line-height: 1.25;
  }

  @media (min-width: 768px) {
    .title {
      /* text-2xl = 1.5rem: combacia per valore con --font-size-xl, non con --font-size-2xl (2.25rem) */
      font-size: var(--font-size-xl);
    }
  }

  .schede {
    /* font-family e color li impone `.prose p, .prose li` di global.css, con
       specificita' (0,1,1) che batte le utility: dichiararli qui vincerebbe
       (0,2,0) e cambierebbe la resa. Vedi ADR-0005 e l'issue #46. */
    font-size: var(--font-size-sm);
    /* text-sm porta con sé line-height: calc(1.25 / 0.875) */
    line-height: calc(1.25 / 0.875);
    margin-top: var(--space-3);
  }

  /* Button è un'isola React (ADR-0008 #astro-island-boundary): il suo root
     non riceve l'attributo di scoping di Astro, serve :global() sul discendente. */
  .cta-panel :global(.cta-action) {
    /* mt-5 = 1.25rem: nessun token combacia */
    margin-top: 1.25rem;
  }
</style>
