---
// Blocco introduttivo "Cosa facciamo" di una pagina servizio.
// Il body (paragrafi, eventuali liste di format, link) arriva via slot MDX e
// viene reso con la tipografia prose della pagina.
import Eyebrow from '@butik/ui/Eyebrow';

interface Props {
  eyebrow?: string;
}

const { eyebrow = 'Cosa facciamo' } = Astro.props;
---

<section class="section-intro">
  <Eyebrow>{eyebrow}</Eyebrow>
  <slot />
</section>

<style>
  .section-intro {
    /* 2.5rem non ha un token corrispondente in ui-tokens */
    margin-top: 2.5rem;
    margin-bottom: var(--space-8);
  }

  .section-intro:first-child {
    margin-top: 0;
  }
</style>
