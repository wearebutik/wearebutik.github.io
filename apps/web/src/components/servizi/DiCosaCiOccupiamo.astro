---
// Lista puntata "Di cosa ci occupiamo".
import Eyebrow from '@butik/ui/Eyebrow';

interface Props {
  items: string[];
  eyebrow?: string;
}

const { items, eyebrow = 'Di cosa ci occupiamo' } = Astro.props;
---

<section class="not-prose occupiamo-section">
  <Eyebrow>{eyebrow}</Eyebrow>
  <ul class="occupiamo-list" data-reveal-group>
    {items.map((item) => (
      <li class="occupiamo-item">
        <span class="occupiamo-bullet"></span>
        <span>{item}</span>
      </li>
    ))}
  </ul>
</section>

<style>
  .occupiamo-section {
    margin-block: var(--space-10);
  }

  /* Tailwind space-y-*: margin-block-end su tutti tranne l'ultimo. */
  .occupiamo-list > li:not(:last-child) {
    margin-block-end: var(--space-3);
  }

  .occupiamo-item {
    display: flex;
    gap: var(--space-3);
    font-family: var(--font-sans);
    font-size: var(--font-size-base);
    /* leading-relaxed vince su text-base: 1.625, nessun token nella scala. */
    line-height: 1.625;
    color: var(--color-fg);
  }

  .occupiamo-bullet {
    margin-top: var(--space-2);
    height: var(--space-1-5);
    width: var(--space-1-5);
    flex-shrink: 0;
    border-radius: var(--radius-full);
    background-color: var(--color-accent);
  }
</style>
