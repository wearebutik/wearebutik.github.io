---
// Box evidenziato "Adatto a": destinatari del servizio.
import Eyebrow from '@butik/ui/Eyebrow';

interface Props {
  text: string;
  eyebrow?: string;
}

const { text, eyebrow = 'Adatto a' } = Astro.props;
---

<aside class="not-prose callout">
  <Eyebrow spacing="sm">{eyebrow}</Eyebrow>
  <p class="callout-text">{text}</p>
</aside>

<style>
  .callout {
    margin-top: var(--space-10);
    margin-bottom: var(--space-10);
    border-left: 4px solid var(--color-accent);
    background-color: color-mix(in oklab, var(--color-bg) 70%, transparent);
    padding: var(--space-5) var(--space-6);
  }

  .callout-text {
    /* font-family e color li impone `.prose p, .prose li` di global.css, con
       specificita' (0,1,1) che batte le utility: dichiararli qui vincerebbe
       (0,2,0) e cambierebbe la resa. Vedi ADR-0005 e l'issue #46. */
    font-size: 1rem;
    /* leading-relaxed vince sul line-height implicito di text-base/md:text-lg */
    line-height: 1.625;
  }

  @media (min-width: 768px) {
    .callout-text {
      font-size: 1.125rem;
    }
  }
</style>
