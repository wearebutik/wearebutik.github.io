---
// "Il nostro metodo" — step numerati, con eventuale paragrafo introduttivo.
// `description` di ogni step è opzionale (il servizio Formazione ha step di
// solo titolo preceduti da un'introduzione).
import Eyebrow from '@butik/ui/Eyebrow';
import NumberBadge from '@butik/ui/NumberBadge';

interface Step {
  title: string;
  description?: string;
}

interface Props {
  steps: Step[];
  intro?: string;
  eyebrow?: string;
}

const { steps, intro, eyebrow = 'Il nostro metodo' } = Astro.props;
---

<section class="not-prose metodo-steps">
  <Eyebrow>{eyebrow}</Eyebrow>
  {intro && <p class="metodo-intro">{intro}</p>}
  <ol class="metodo-list" data-reveal-group>
    {steps.map((step, i) => (
      <li class="metodo-step">
        <NumberBadge number={i + 1} />
        <div class="metodo-step-body">
          <p class="step-title">
            {step.title}
          </p>
          {step.description && (
            <p class="step-description">
              {step.description}
            </p>
          )}
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .metodo-steps {
    margin: var(--space-10) 0;
  }

  .metodo-intro {
    /* font-family e color li impone `.prose p, .prose li` di global.css, con
       specificita' (0,1,1) che batte le utility: dichiararli qui vincerebbe
       (0,2,0) e cambierebbe la resa. Vedi ADR-0005 e l'issue #46. */
    font-size: var(--font-size-base);
    line-height: 1.625; /* leading-relaxed vince sul line-height di text-base/text-lg */
    margin-bottom: var(--space-6);
  }

  .metodo-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* Tailwind space-y-6: margin-block-end su tutti tranne l'ultimo. */
  .metodo-list > li:not(:last-child) {
    margin-block-end: var(--space-6);
  }

  .metodo-step {
    display: flex;
    gap: var(--space-4);
  }

  .metodo-step-body {
    padding-top: var(--space-1);
  }

  /* Neutralizza lo stile globale dei titoli (uppercase/rosso) per i titoli step. */
  .step-title {
    /* font-family e color li impone `.prose p, .prose li` di global.css, con
       specificita' (0,1,1) che batte le utility: dichiararli qui vincerebbe
       (0,2,0) e cambierebbe la resa. Vedi ADR-0005 e l'issue #46. */
    font-size: var(--font-size-base);
    font-weight: 700;
    line-height: 1.375; /* leading-snug vince sul line-height di text-base/text-lg */
    text-transform: none;
    letter-spacing: -0.005em;
    color: var(--color-butik-dark);
  }

  .step-description {
    /* font-family e color li impone `.prose p, .prose li` di global.css, con
       specificita' (0,1,1) che batte le utility: dichiararli qui vincerebbe
       (0,2,0) e cambierebbe la resa. Vedi ADR-0005 e l'issue #46. */
    font-size: var(--font-size-sm);
    line-height: 1.625; /* leading-relaxed vince sul line-height di text-sm/text-base */
    margin-top: var(--space-1);
  }

  @media (min-width: 768px) {
    .metodo-intro {
      font-size: var(--font-size-lg);
    }
    .metodo-step {
      gap: var(--space-5);
    }
    .step-title {
      font-size: var(--font-size-lg);
    }
    .step-description {
      font-size: var(--font-size-base);
    }
  }
</style>
