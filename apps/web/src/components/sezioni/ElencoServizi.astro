---
// Sezione "Elenco dei servizi": una card espansa per servizio (per chi ·
// cosa ottieni), nell'ordine del blocco. Le card hanno i loro testi, separati
// dalla scheda del servizio, e decidono da sé se mostrare il link
// (lib/cardServizi.ts). Nata da /servizi.
import ServiceExpanded, { type CardServizio } from '#components/serviziCards/ServiceExpanded.astro';
import { linkDellaCard } from '#lib/cardServizi';
import { linkValido } from '#lib/links';
import type { IconaCard } from '@butik/site-config/icone';

interface Props {
  card: {
    _key: string;
    ancora: string;
    icona: IconaCard;
    perChi: string;
    title: string;
    desc: string;
    punti: string[];
    mostraLink: boolean;
    href?: string;
    linkLabel?: string;
  }[];
}

const card: (CardServizio & { _key: string })[] = await Promise.all(
  Astro.props.card.map(async (c) => ({ ...c, link: await linkDellaCard(c, linkValido) })),
);
---

<section class="svc-main">
  <div class="svc-grid" data-svc-grid data-reveal-group data-prefetch="viewport">
    {card.map((c, i) => (
      <div class="svc-grid-item">
        <ServiceExpanded card={c} index={i + 1} />
      </div>
    ))}
  </div>
</section>

<style>
  .svc-main {
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--space-6);
    padding-bottom: var(--space-20);
  }

  .svc-grid {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: var(--space-5);
  }
  @media (min-width: 1024px) {
    .svc-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .svc-grid-item {
    border: 1px solid color-mix(in oklab, var(--color-butik-dark) 12%, transparent);
    padding: var(--space-6);
  }
  @media (min-width: 768px) {
    .svc-grid-item {
      padding: var(--space-8);
    }
  }
</style>
