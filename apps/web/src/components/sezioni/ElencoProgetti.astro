---
// Sezione "Elenco dei progetti": tutti i progetti pubblicati, nell'ordine
// dell'elenco Progetti dello Studio. Nata da /progetti.
import { getCollection } from 'astro:content';
import { placeholderStyle } from '#lib/lqip';
import { stili, vtName } from '#lib/viewTransition';
import Foto from '#components/Foto.astro';
import { foto } from '#lib/foto';
import { perOrdine } from '#lib/ordine';
import MetaLabel from '@butik/ui/MetaLabel';

interface Props {
  /** Etichetta davanti al nome del cliente ("Cliente:"). */
  clienteLabel: string;
}
const { clienteLabel } = Astro.props;

const progetti = (await getCollection('progetti', (e) => !e.data.draft)).sort(perOrdine);

const fotoCard = await Promise.all(
  progetti.map((p) =>
    foto(p.data.heroImage, {
      widths: [400, 700],
      sizes: '(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw',
      ruolo: 'miniatura',
    }),
  ),
);
---

<section class="projects-section">
  <div class="projects-grid" data-reveal-group data-prefetch="viewport">
    {progetti.map((p, i) => (
      <a href={`/progetti/${p.id}`} class="project-card">
        <div class="project-card__media">
          <Foto
            foto={fotoCard[i]}
            alt={p.data.heroAlt}
            loading={i < 3 ? 'eager' : 'lazy'}
            class="project-card__image"
            style={stili(placeholderStyle(p.data.heroLqip), vtName(`progetto-${p.id}`))}
          />
        </div>
        <div class="project-card__meta">
          {p.data.category && (
            <MetaLabel>
              {p.data.category}
            </MetaLabel>
          )}
          {p.data.year && (
            <span class="project-card__year">{p.data.year}</span>
          )}
        </div>
        <h2 class="project-card__title" style={vtName(`progetto-${p.id}-title`)}>
          {p.data.title}
        </h2>
        <p class="project-card__subtitle" style={vtName(`progetto-${p.id}-subtitle`)}>
          {p.data.subtitle}
        </p>
        {p.data.client && (
          <p class="project-card__client">
            {clienteLabel} {p.data.client}
          </p>
        )}
      </a>
    ))}
  </div>
</section>

<style>
  .projects-section {
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--space-6);
    padding-bottom: var(--space-24);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: var(--space-10);
  }
  @media (min-width: 768px) {
    .projects-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .projects-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .project-card {
    display: block;
  }

  .project-card__media {
    overflow: hidden;
    margin-bottom: var(--space-5);
  }

  .project-card__image {
    width: 100%;
    height: var(--media-h-sm);
    object-fit: cover;
    /* Segnaposto sfocato (LQIP) finché la foto non arriva: stesso ritaglio
       di object-fit: cover. */
    background-image: var(--placeholder, none);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    transition-property: transform, translate, scale, rotate;
    transition-timing-function: var(--ease-standard);
    transition-duration: var(--duration-slower);
  }
  .project-card:hover .project-card__image {
    scale: 105% 105%;
  }
  @media (prefers-reduced-motion: reduce) {
    .project-card__image {
      transition: none;
    }
    .project-card:hover .project-card__image {
      scale: none;
    }
  }

  .project-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
  }

  .project-card__year {
    font-family: var(--font-display);
    font-size: var(--font-size-xs);
    line-height: calc(1 / 0.75); /* line-height che text-xs porta con sé */
    color: var(--color-butik-body);
  }

  .project-card__title {
    font-family: var(--font-heading);
    font-size: var(--font-size-title-sm);
    line-height: calc(1.75 / 1.25); /* line-height che text-xl porta con sé */
    font-weight: 700;
    color: var(--color-butik-dark);
    margin-bottom: var(--space-2);
    transition: color var(--duration-fast) var(--ease-standard);
  }
  .project-card:hover .project-card__title {
    color: var(--color-accent-text);
  }

  .project-card__subtitle {
    font-family: var(--font-sans);
    font-size: var(--font-size-sm);
    line-height: 1.625; /* leading-relaxed vince su text-sm */
    color: var(--color-butik-body);
  }

  .project-card__client {
    /* design-lint-disable small-caps: riga cliente in regular, grigia, fuori dai due ruoli */
    margin-top: var(--space-2);
    font-family: var(--font-display);
    font-size: var(--font-size-xs);
    line-height: calc(1 / 0.75); /* line-height che text-xs porta con sé */
    letter-spacing: 0.1em; /* tracking-widest, nessun token */
    text-transform: uppercase;
    color: var(--color-butik-body);
  }
</style>
