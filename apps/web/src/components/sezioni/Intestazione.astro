---
// Sezione "Intestazione": il titolo principale della pagina (H1) con
// intestazione e paragrafi introduttivi. Nata dalla testata di /servizi.
import Eyebrow from '@butik/ui/Eyebrow';
import { richTextParagrafi } from '#lib/richText';

interface Props {
  eyebrow: string;
  title: string;
  testo: unknown[];
}
const { eyebrow, title, testo } = Astro.props;
---

<section class="svc-intro">
  <Eyebrow>{eyebrow}</Eyebrow>
  <h1 class="svc-title">{title}</h1>
  {richTextParagrafi(testo).map((p) => <p class="svc-lead" set:html={p}></p>)}
</section>

<style>
  .svc-intro {
    max-width: var(--measure-5xl);
    margin-inline: auto;
    padding-inline: var(--space-6);
    padding-top: var(--space-20);
    padding-bottom: var(--space-8);
    text-align: center;
  }
  @media (min-width: 768px) {
    .svc-intro {
      padding-top: var(--space-24);
    }
  }

  .svc-title {
    font-family: var(--font-heading);
    font-size: var(--text-4xl);
    line-height: calc(2.5 / 2.25);
    font-weight: 700;
    color: var(--color-butik-dark);
    margin-bottom: var(--space-5);
  }
  @media (min-width: 768px) {
    .svc-title {
      font-size: var(--text-5xl);
      line-height: 1;
    }
  }

  .svc-lead {
    font-family: var(--font-sans);
    font-size: var(--font-size-base);
    /* leading-relaxed era già sull'utility: vince lui sul line-height di
       text-base/text-lg, non i valori di riga di quelle taglie. */
    line-height: 1.625;
    color: var(--color-butik-body);
    max-width: var(--measure-2xl);
    margin-inline: auto;
  }
  @media (min-width: 768px) {
    .svc-lead {
      font-size: var(--font-size-lg);
    }
  }
  .svc-lead + .svc-lead {
    margin-top: var(--space-4);
  }
</style>
