{
  "name": "@butik/web",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:anteprima": "BUTIK_ANTEPRIMA=1 astro build && bun anteprima/manifesto.ts && bun build --compile --minify anteprima/cli.ts --outfile dist-anteprima/butik-anteprima",
    "preview": "astro preview",
    "astro": "astro"
  },
  "imports": {
    "#components/*": "./src/components/*",
    "#data/*": "./src/data/*",
    "#lib/*": "./src/lib/*",
    "#layouts/*": "./src/layouts/*",
    "#styles/*": "./src/styles/*",
    "#assets/*": "./src/assets/*"
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.3",
    "@astrojs/react": "^6.0.1",
    "@butik/site-config": "workspace:*",
    "@butik/ui": "workspace:*",
    "@butik/ui-tokens": "workspace:*",
    "@sanity/client": "^8.11.0",
    "@sanity/image-url": "^2.1.1",
    "astro": "^6.1.5",
    "astro-portabletext": "^1.0.1",
    "github-slugger": "^2.0.0",
    "posthog-js": "^1.399.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.34.5",
    "vanilla-cookieconsent": "^3.1.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@sanity/visual-editing": "^6.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "beasties": "^0.5.4",
    "node-html-parser": "^9.0.4",
    "satori": "^0.26.0",
    "subset-font": "^2.9.0"
  }
}
