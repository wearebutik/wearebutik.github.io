{
  "name": "@butik/web",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:anteprima": "BUTIK_ANTEPRIMA=1 astro build && bun anteprima/manifesto.ts && bun build --compile --minify anteprima/cli.ts --outfile dist-anteprima/butik-anteprima",
    "preview": "astro preview",
    "check": "astro sync && node ../../tools/type-check/index.mjs && tsc -p anteprima",
    "astro": "astro"
  },
  "imports": {
    "#components/*": "./src/components/*",
    "#data/*": "./src/data/*",
    "#lib/*": "./src/lib/*",
    "#layouts/*": "./src/layouts/*",
    "#styles/*": "./src/styles/*",
    "#assets/*": "./src/assets/*"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.1",
    "@astrojs/react": "^7.1.1",
    "@butik/site-config": "workspace:*",
    "@butik/ui": "workspace:*",
    "@butik/ui-tokens": "workspace:*",
    "@sanity/client": "^8.11.0",
    "@sanity/image-url": "^2.1.1",
    "astro": "^7.4.2",
    "astro-portabletext": "^1.0.1",
    "github-slugger": "^2.0.0",
    "posthog-js": "^1.438.22",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "vanilla-cookieconsent": "^3.1.0"
  },
  "devDependencies": {
    "@astrojs/astro2tsx": "^0.1.3",
    "@resvg/resvg-js": "^2.6.2",
    "@sanity/visual-editing": "^6.2.0",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/subset-font": "^2.3.0",
    "beasties": "^0.5.5",
    "node-html-parser": "^9.0.5",
    "satori": "^0.63.2",
    "subset-font": "^2.9.0",
    "typescript": "7.0.2"
  }
}
