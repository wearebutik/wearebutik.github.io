# Web3Forms — access key del form contatti (recapito a info@wearebutik.com).
# Copia questo file in `.env` e incolla la key reale. Il file `.env` è gitignored.
#
# Il prefisso PUBLIC_ è obbligatorio: Astro espone al codice client solo le
# variabili PUBLIC_*. Essendo un sito statico, la key finisce comunque nel
# bundle pubblico (è così per design in Web3Forms, non è un segreto); l'env
# serve solo a non committarla nel sorgente.
#
# In produzione (GitHub Pages) impostala come GitHub Secret `WEB3FORMS_ACCESS_KEY`:
# Settings → Secrets and variables → Actions → New repository secret.
PUBLIC_WEB3FORMS_ACCESS_KEY=

# PostHog — analytics (ADR-0006). Entrambe OPZIONALI: senza chiave il sito
# funziona e fa build normalmente, PostHog semplicemente non si inizializza e
# non parte alcun tracciamento. Il tracciamento è comunque gated dal consenso
# (opt-out-by-default): nulla parte prima che l'utente accetti la categoria
# "analytics" nel banner cookie.
#
# PUBLIC_POSTHOG_KEY  — Project API Key di PostHog (prefisso PUBLIC_ obbligatorio
#                       per esporla al client; non è un segreto, finisce nel
#                       bundle statico per design).
# PUBLIC_POSTHOG_HOST — endpoint dell'istanza. Default: https://eu.i.posthog.com
#                       (cloud EU). Usa https://us.i.posthog.com per il cloud US
#                       o l'URL della tua istanza self-hosted.
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=

# Google Tag Manager (ADR-0006, Update 2026-07-13). OPZIONALE: senza ID, GTM non
# viene iniettato e il sito builda normalmente. GTM è caricato via Google Consent
# Mode v2 con default `denied`; nessun tag scatta prima che l'utente accetti la
# categoria "analytics" nel banner cookie.
#
# PUBLIC_GTM_ID — ID del container GTM, formato GTM-XXXXXXX (prefisso PUBLIC_
#                 obbligatorio; l'ID è pubblico per natura, finisce nella pagina).
#                 In produzione impostalo come repository variable PUBLIC_GTM_ID
#                 (Settings → Secrets and variables → Actions → Variables).
PUBLIC_GTM_ID=

# Sanity — dataset e anteprima delle bozze. Tutte OPZIONALI: senza, il sito
# legge i contenuti pubblicati del dataset `production`.
#
# SANITY_DATASET      — dataset da cui costruire (default: production).
# SANITY_PERSPECTIVE  — `drafts` per una build di anteprima: legge le bozze
#                       sopra i pubblicati. Default: solo pubblicati.
# SANITY_READ_TOKEN   — obbligatorio con SANITY_PERSPECTIVE=drafts: token con
#                       ruolo Viewer (sanity.io/manage → API → Tokens). Le bozze
#                       non sono pubbliche: il token si usa solo a build time,
#                       ma le pagine generate contengono le bozze, quindi una
#                       build di anteprima va tenuta in locale o dietro un
#                       accesso protetto. Mai committarlo.
SANITY_DATASET=
SANITY_PERSPECTIVE=
SANITY_READ_TOKEN=
