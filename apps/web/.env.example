# Modulo contatti (apps/functions): indirizzo del Worker e chiave del sito
# Turnstile. Entrambe pubbliche per natura (finiscono nella pagina), quindi
# variabili PUBLIC_* e, nel deploy, repository *variables* (Settings → Secrets
# and variables → Actions → Variables). Senza una delle due il modulo mostra
# il messaggio «modulo non configurato» e non invia.
#
# PUBLIC_FORM_URL         — https://form.wearebutik.com/
# PUBLIC_TURNSTILE_SITE_KEY — la «Site Key» del widget Turnstile (pannello
#                             Cloudflare → Turnstile). Per provare in locale
#                             c'è la chiave di prova di Cloudflare che passa
#                             sempre: 1x00000000000000000000AA
PUBLIC_FORM_URL=
PUBLIC_TURNSTILE_SITE_KEY=

# PostHog — analytics (ADR-0006). Entrambe OPZIONALI: senza chiave il sito
# funziona e fa build normalmente, PostHog semplicemente non si inizializza e
# non parte alcun tracciamento. Il tracciamento è comunque gated dal consenso
# (opt-out-by-default): nulla parte prima che l'utente accetti la categoria
# "analytics" nel banner cookie.
#
# PUBLIC_POSTHOG_KEY  — Project API Key di PostHog (prefisso PUBLIC_ obbligatorio
#                       per esporla al client; non è un segreto, finisce nel
#                       bundle statico per design).
# PUBLIC_POSTHOG_HOST — endpoint dell'istanza. Default: https://eu.i.posthog.com
#                       (cloud EU). Usa https://us.i.posthog.com per il cloud US
#                       o l'URL della tua istanza self-hosted.
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=

# Google Tag Manager (ADR-0006, Update 2026-07-13). OPZIONALE: senza ID, GTM non
# viene iniettato e il sito builda normalmente. GTM è caricato via Google Consent
# Mode v2 con default `denied`; nessun tag scatta prima che l'utente accetti la
# categoria "analytics" nel banner cookie.
#
# PUBLIC_GTM_ID — ID del container GTM, formato GTM-XXXXXXX (prefisso PUBLIC_
#                 obbligatorio; l'ID è pubblico per natura, finisce nella pagina).
#                 In produzione impostalo come repository variable PUBLIC_GTM_ID
#                 (Settings → Secrets and variables → Actions → Variables).
PUBLIC_GTM_ID=

# Sanity — dataset. OPZIONALE: senza, il sito legge `production`. Il sito
# legge solo i documenti pubblicati; le bozze le mostra l'anteprima locale
# (apps/web/anteprima/README.md).
SANITY_DATASET=
